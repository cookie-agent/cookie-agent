# Cookie Agent TUI configuration
#
# Location: ~/.cookie-agent/tui.toml
#
# This file is independent from engine/workspace config. There is no
# workspace layer or environment-selected file path; a
# missing file uses the defaults shown below, and unknown keys or malformed
# values are rejected with an actionable path/key error.

# Minimum diagnostic event level rendered in the conversation pane.
# One of: "debug" | "info" | "warning" | "error". Default: "warning".
# Rows below the threshold stay in the session projection — hidden rows
# reappear when the level is lowered with /events at runtime (view-only;
# this file is never rewritten).
minimum_event_level = "warning"

# Theme override. One of: "auto" | "default" | "dark" | "mono" | "high-contrast".
# Precedence: this key > COOKIE_THEME > terminal detection.
# Explicit "auto" ignores COOKIE_THEME and queries OSC 11, then COLORFGBG,
# then uses the light default. An unset key first allows COOKIE_THEME.
# NO_COLOR and TERM=dumb always force monochrome regardless of this key.
# theme = "auto"
