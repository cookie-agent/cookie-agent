# Copy to .env and fill in the credential used by the checked-in explicit
# Anthropic, OpenAI Responses, and compatible-chat providers.
# Environment variables never become configuration keys. They are read only
# when an approved TOML field explicitly uses ${env:NAME} interpolation.
# TOML interpolation is allowed only for providers.*.endpoint,
# approved providers.*.auth secret fields, and providers.*.headers.* values.
COOKIE_TEST_API_KEY=
