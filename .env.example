# Copy to .env and fill in the key consumed by the checked-in workspace config.
# Environment variables never become configuration keys. They are read only
# when an approved TOML field explicitly uses ${env:NAME} interpolation.
# TOML interpolation is allowed only for models.<alias>.endpoint, supported
# models.<alias>.auth credential fields, and models.<alias>.headers.* values.
COOKIE_TEST_API_KEY=
