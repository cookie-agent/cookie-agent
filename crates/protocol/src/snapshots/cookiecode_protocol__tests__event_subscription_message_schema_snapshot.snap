---
source: crates/protocol/src/lib.rs
expression: schema_for!(EventSubscriptionMessage)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventSubscriptionMessage",
  "description": "A live persisted-event subscription message.\n\n`Gap` is never persisted. Its `last_delivered_seq` is an exclusive replay\ncursor: clients must re-subscribe with that cursor to receive the first\nomitted event. `session_id` identifies the subscription whose tail lagged.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "event": {
          "$ref": "#/$defs/EventEnvelope"
        },
        "type": {
          "type": "string",
          "const": "event"
        }
      },
      "required": [
        "type",
        "event"
      ]
    },
    {
      "type": "object",
      "properties": {
        "last_delivered_seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "const": "gap"
        }
      },
      "required": [
        "type",
        "session_id",
        "last_delivered_seq"
      ]
    }
  ],
  "$defs": {
    "ActionKind": {
      "description": "A permission capability used by configured rules and runtime approvals.",
      "type": "string",
      "enum": [
        "read",
        "write",
        "bash",
        "grep",
        "glob",
        "list",
        "delegate",
        "external_directory"
      ]
    },
    "AgentType": {
      "description": "Whether a profile can create root sessions, delegated sessions, both, or neither.",
      "type": "string",
      "enum": [
        "all",
        "primary",
        "subagent",
        "internal"
      ]
    },
    "ApprovalDecision": {
      "description": "A user's answer to a pending approval request.",
      "type": "string",
      "enum": [
        "once",
        "always",
        "reject"
      ]
    },
    "ApprovalResource": {
      "description": "One resource disclosed by an approval request.",
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionKind"
        },
        "resource": {
          "type": "string"
        },
        "suggested_pattern": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "resource",
        "suggested_pattern"
      ]
    },
    "ApprovedScope": {
      "description": "One runtime approval scope granted by an `always` response.",
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionKind"
        },
        "resource": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "resource",
        "scope"
      ]
    },
    "DecisionTrace": {
      "description": "Complete derivation of a permission decision.",
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionKind"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MatchedPermissionRule"
          }
        },
        "effect": {
          "$ref": "#/$defs/Effect"
        },
        "normalized_resource": {
          "type": "string"
        },
        "precedence_reason": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "normalized_resource",
        "candidates",
        "effect",
        "precedence_reason"
      ]
    },
    "DelegationSnapshot": {
      "description": "The frozen delegation portion of a session profile.",
      "type": "object",
      "properties": {
        "allowed_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "depth_limit": {
          "$ref": "#/$defs/DepthLimit"
        },
        "enabled": {
          "type": "boolean"
        },
        "result_limit_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "enabled",
        "allowed_profiles",
        "depth_limit",
        "result_limit_bytes"
      ]
    },
    "DepthLimit": {
      "description": "The number of further delegation generations allowed beneath a session.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "finite"
            },
            "value": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "unlimited"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "Effect": {
      "description": "The result of a configured permission rule evaluation.",
      "type": "string",
      "enum": [
        "allow",
        "ask",
        "deny"
      ]
    },
    "Event": {
      "description": "A durable event payload from a session event log.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "meta": {
              "$ref": "#/$defs/SessionMeta"
            },
            "type": {
              "type": "string",
              "const": "session_created"
            }
          },
          "required": [
            "type",
            "meta"
          ]
        },
        {
          "type": "object",
          "properties": {
            "client_run_id": {
              "type": "string"
            },
            "input": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "run_started"
            }
          },
          "required": [
            "type",
            "client_run_id",
            "input"
          ]
        },
        {
          "description": "Model-visible input injected into an already-running turn.",
          "type": "object",
          "properties": {
            "input": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "user_input_submitted"
            }
          },
          "required": [
            "type",
            "input"
          ]
        },
        {
          "description": "Durable association of accepted steering with the provider attempt that\nconsumed it. `user_input_seq` references `UserInputSubmitted`.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "user_input_applied"
            },
            "user_input_seq": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "user_input_seq"
          ]
        },
        {
          "type": "object",
          "properties": {
            "final_text": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "run_completed"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "run_failed"
            }
          },
          "required": [
            "type",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "run_cancelled"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "run_interrupted"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "text_delta"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "reasoning_delta"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "arguments": true,
            "tool": {
              "type": "string"
            },
            "tool_call_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "tool_call_started"
            }
          },
          "required": [
            "type",
            "tool_call_id",
            "tool",
            "arguments"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "tool_call_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "tool_call_progress"
            }
          },
          "required": [
            "type",
            "tool_call_id",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "result": {
              "$ref": "#/$defs/ToolResult"
            },
            "tool_call_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "tool_call_completed"
            }
          },
          "required": [
            "type",
            "tool_call_id",
            "result"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "tool_call_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "tool_call_failed"
            }
          },
          "required": [
            "type",
            "tool_call_id",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "$ref": "#/$defs/ActionKind"
            },
            "approval_id": {
              "type": "string"
            },
            "decision_trace": {
              "$ref": "#/$defs/DecisionTrace"
            },
            "resource": {
              "type": "string"
            },
            "resources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ApprovalResource"
              }
            },
            "suggested_pattern": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "approval_requested"
            }
          },
          "required": [
            "type",
            "approval_id",
            "action",
            "resource",
            "suggested_pattern",
            "resources",
            "decision_trace"
          ]
        },
        {
          "type": "object",
          "properties": {
            "approval_id": {
              "type": "string"
            },
            "approved_scope": {
              "type": [
                "string",
                "null"
              ]
            },
            "approved_scopes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ApprovedScope"
              }
            },
            "decision": {
              "$ref": "#/$defs/ApprovalDecision"
            },
            "feedback": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "approval_resolved"
            }
          },
          "required": [
            "type",
            "approval_id",
            "decision"
          ]
        },
        {
          "type": "object",
          "properties": {
            "byte_count": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "tool_call_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "tool_stdin_submitted"
            }
          },
          "required": [
            "type",
            "tool_call_id",
            "byte_count"
          ]
        },
        {
          "type": "object",
          "properties": {
            "child_session_id": {
              "type": "string",
              "format": "uuid"
            },
            "tool_call_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "tool_call_linked"
            }
          },
          "required": [
            "type",
            "tool_call_id",
            "child_session_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "attempts": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "from": {
              "$ref": "#/$defs/ModelRef"
            },
            "reason": {
              "type": "string"
            },
            "to": {
              "$ref": "#/$defs/ModelRef"
            },
            "type": {
              "type": "string",
              "const": "model_fallback"
            }
          },
          "required": [
            "type",
            "from",
            "to",
            "reason",
            "attempts"
          ]
        },
        {
          "type": "object",
          "properties": {
            "model": {
              "$ref": "#/$defs/ModelRef"
            },
            "type": {
              "type": "string",
              "const": "usage_reported"
            },
            "usage": {
              "$ref": "#/$defs/Usage"
            }
          },
          "required": [
            "type",
            "model",
            "usage"
          ]
        }
      ]
    },
    "EventEnvelope": {
      "description": "A persisted event with authoritative per-session ordering metadata.",
      "type": "object",
      "properties": {
        "event": {
          "$ref": "#/$defs/Event"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "session_id",
        "seq",
        "timestamp",
        "event"
      ]
    },
    "MatchedPermissionRule": {
      "description": "A candidate rule retained for client-visible permission explanations.",
      "type": "object",
      "properties": {
        "effect": {
          "$ref": "#/$defs/Effect"
        },
        "hard": {
          "type": "boolean"
        },
        "rule_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_layer": {
          "type": "string"
        }
      },
      "required": [
        "source_layer",
        "effect",
        "hard"
      ]
    },
    "ModelRef": {
      "description": "A model entry in a profile fallback chain.",
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model"
      ]
    },
    "PermissionRule": {
      "description": "One ordered configured permission rule.",
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionKind"
        },
        "effect": {
          "$ref": "#/$defs/Effect"
        },
        "hard": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "action",
        "resource",
        "effect",
        "hard"
      ]
    },
    "ProfileSnapshot": {
      "description": "A resolved profile frozen when its session is created.",
      "type": "object",
      "properties": {
        "agent_type": {
          "$ref": "#/$defs/AgentType"
        },
        "delegation": {
          "$ref": "#/$defs/DelegationSnapshot"
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModelRef"
          }
        },
        "name": {
          "type": "string"
        },
        "permission_rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PermissionRule"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "agent_type",
        "models",
        "tools",
        "delegation",
        "permission_rules"
      ]
    },
    "SessionMeta": {
      "description": "Session metadata cached for querying; the event log remains authoritative.",
      "type": "object",
      "properties": {
        "cwd": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "origin": {
          "$ref": "#/$defs/SessionOrigin"
        },
        "profile": {
          "$ref": "#/$defs/ProfileSnapshot"
        }
      },
      "required": [
        "id",
        "origin",
        "cwd",
        "profile"
      ]
    },
    "SessionOrigin": {
      "description": "The creation provenance of a session.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "root"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "depth": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "invocation_id": {
              "type": "string",
              "format": "uuid"
            },
            "parent_run_id": {
              "type": "string",
              "format": "uuid"
            },
            "parent_session_id": {
              "type": "string",
              "format": "uuid"
            },
            "parent_tool_call_id": {
              "type": "string",
              "format": "uuid"
            },
            "root_session_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "delegated"
            }
          },
          "required": [
            "type",
            "root_session_id",
            "parent_session_id",
            "parent_run_id",
            "parent_tool_call_id",
            "invocation_id",
            "depth"
          ]
        },
        {
          "type": "object",
          "properties": {
            "source_event_seq": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "source_session_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "forked"
            }
          },
          "required": [
            "type",
            "source_session_id",
            "source_event_seq"
          ]
        }
      ]
    },
    "ToolResult": {
      "description": "The result sent back to the model when a tool call completes.",
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "content",
        "truncated"
      ]
    },
    "Usage": {
      "description": "Aggregate model usage attributed to a child session.",
      "type": "object",
      "properties": {
        "cached_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ]
    }
  }
}
