---
source: crates/protocol/src/tests.rs
expression: schema_for!(AgentSnapshot)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentSnapshot",
  "type": "object",
  "properties": {
    "agent": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9]))*$"
    },
    "composed_prompt": {
      "type": "string",
      "maxLength": 131072,
      "minLength": 1,
      "pattern": "(?s)^(?=.*\\S).+$"
    },
    "delegation": {
      "anyOf": [
        {
          "$ref": "#/$defs/FrozenDelegationPolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^(?=.*\\S)[^\\p{Cc}\\p{Cf}]+$"
    },
    "document_fingerprint": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "document_source": {
      "$ref": "#/$defs/AgentDocumentSource"
    },
    "fallback_chain": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FrozenModelBinding"
      },
      "maxItems": 256,
      "minItems": 1
    },
    "mode": {
      "$ref": "#/$defs/AgentMode"
    },
    "permissions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PermissionRule"
      },
      "maxItems": 256
    },
    "prompt_fingerprint": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema": {
      "type": "integer",
      "const": 1
    },
    "selected_suffix_start": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ToolName"
      },
      "maxItems": 256
    }
  },
  "additionalProperties": false,
  "required": [
    "agent",
    "schema",
    "mode",
    "description",
    "document_source",
    "document_fingerprint",
    "composed_prompt",
    "prompt_fingerprint",
    "tools",
    "permissions",
    "delegation",
    "fallback_chain",
    "selected_suffix_start"
  ],
  "$defs": {
    "AdaptorId": {
      "type": "string",
      "enum": [
        "anthropic",
        "openai-chat",
        "openai-responses",
        "openai-compatible",
        "google-gemini",
        "google-vertex-gemini",
        "aws-bedrock-converse",
        "azure-openai-chat",
        "azure-openai-responses",
        "cohere-v2-chat",
        "open-responses"
      ]
    },
    "AgentDocumentSource": {
      "type": "string",
      "enum": [
        "built_in",
        "user",
        "workspace"
      ]
    },
    "AgentMode": {
      "type": "string",
      "enum": [
        "primary",
        "subagent",
        "all"
      ]
    },
    "CompiledReasoningBehavior": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "effort"
            },
            "value": {
              "$ref": "#/$defs/ReasoningEffort"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "toggle"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "enabled"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "budget_tokens"
            },
            "value": {
              "type": "integer",
              "format": "int64",
              "minimum": -1
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        }
      ]
    },
    "FrozenDelegationPolicy": {
      "type": "object",
      "properties": {
        "effective_depth_ceiling": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_depth": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9]))*$"
          },
          "maxItems": 256,
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "targets",
        "max_depth",
        "effective_depth_ceiling"
      ]
    },
    "FrozenModelBinding": {
      "type": "object",
      "properties": {
        "behavior_fingerprint": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "defaults": {
          "$ref": "#/$defs/ResolvedRequestDefaults"
        },
        "descriptor": {
          "type": "object",
          "properties": {
            "adapter_id": {
              "type": "string",
              "minLength": 1
            },
            "capabilities": {
              "type": "object",
              "properties": {
                "cancellation": {
                  "type": "string",
                  "enum": [
                    "local_only",
                    "remote_best_effort",
                    "unsupported"
                  ]
                },
                "compaction": {
                  "type": "string",
                  "enum": [
                    "native",
                    "unsupported"
                  ]
                },
                "features": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "tool_calling",
                      "parallel_tools",
                      "tool_input_deltas",
                      "reasoning",
                      "structured_output",
                      "temperature",
                      "top_p",
                      "max_output_tokens",
                      "prompt_caching",
                      "usage",
                      "provider_tools",
                      "sources"
                    ]
                  },
                  "uniqueItems": true
                },
                "limits": {
                  "type": "object",
                  "properties": {
                    "context": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "input": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "output": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "context",
                    "input",
                    "output"
                  ]
                },
                "media": {
                  "type": "object",
                  "properties": {
                    "input": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "media_types": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 3
                            },
                            "minItems": 1
                          },
                          "sources": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "inline_bytes",
                                "inline_text",
                                "url",
                                "provider_reference"
                              ]
                            },
                            "minItems": 1,
                            "uniqueItems": true
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "media_types",
                          "sources"
                        ]
                      }
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "input"
                  ]
                },
                "modalities": {
                  "type": "object",
                  "properties": {
                    "input": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "output": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "input",
                    "output"
                  ]
                },
                "replay": {
                  "type": "object",
                  "properties": {
                    "capability": {
                      "type": "string",
                      "enum": [
                        "required",
                        "optional",
                        "unsupported"
                      ]
                    },
                    "policy": {
                      "type": "string",
                      "enum": [
                        "never",
                        "if_valid",
                        "always"
                      ]
                    },
                    "reasoning": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "policy",
                    "capability",
                    "reasoning"
                  ]
                }
              },
              "additionalProperties": false,
              "required": [
                "features",
                "limits",
                "modalities",
                "media",
                "cancellation",
                "compaction",
                "replay"
              ]
            },
            "identity": {
              "type": "object",
              "properties": {
                "model_id": {
                  "type": "string",
                  "minLength": 1
                },
                "provider_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "provider_id",
                "model_id"
              ]
            },
            "provider_metadata": {
              "type": "object"
            }
          },
          "additionalProperties": false,
          "required": [
            "identity",
            "adapter_id",
            "capabilities",
            "provider_metadata"
          ]
        },
        "provider_options": {
          "$ref": "#/$defs/ProviderOptions"
        },
        "resolved": {
          "$ref": "#/$defs/ResolvedModelRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "resolved",
        "descriptor",
        "defaults",
        "provider_options",
        "behavior_fingerprint"
      ]
    },
    "OpenResponsesMode": {
      "type": "string",
      "enum": [
        "standard",
        "compact"
      ]
    },
    "PermissionAction": {
      "type": "string",
      "enum": [
        "read",
        "write",
        "bash",
        "grep",
        "glob",
        "delegate",
        "external_directory"
      ]
    },
    "PermissionEffect": {
      "type": "string",
      "enum": [
        "allow",
        "ask",
        "deny"
      ]
    },
    "PermissionRule": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/PermissionAction"
        },
        "effect": {
          "$ref": "#/$defs/PermissionEffect"
        },
        "id": {
          "description": "Stable lowercase machine-readable code.",
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "resource": {
          "description": "Current wildcard grammar: '*' matches any characters, '?' matches one character, and controls, globstar, escapes, classes, and braces are forbidden. Runtime deserialization additionally enforces a maximum of 4096 UTF-8 bytes; x-cookie-agent-maxUtf8Bytes records that byte limit because JSON Schema maxLength counts Unicode code points.",
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*\\*\\*)[^\\u0000-\\u001f\\u007f-\\u009f\\\\\\[\\]\\{\\}]+$",
          "x-cookie-agent-maxUtf8Bytes": 4096
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "action",
        "resource",
        "effect"
      ]
    },
    "ProviderOptions": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "api_version": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
            },
            "beta": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 512,
                "minLength": 1,
                "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
              },
              "maxItems": 32,
              "uniqueItems": true
            },
            "type": {
              "type": "string",
              "const": "anthropic"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "api_version",
            "beta"
          ]
        },
        {
          "type": "object",
          "properties": {
            "organization": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
            },
            "project": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
            },
            "type": {
              "type": "string",
              "const": "openai-chat"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "organization",
            "project"
          ]
        },
        {
          "type": "object",
          "properties": {
            "organization": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
            },
            "project": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
            },
            "store": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "openai-responses"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "organization",
            "project",
            "store"
          ]
        },
        {
          "type": "object",
          "properties": {
            "api_path": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^/[^?#]*$"
            },
            "type": {
              "type": "string",
              "const": "openai-compatible"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "api_path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "api_version": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
            },
            "type": {
              "type": "string",
              "const": "google-gemini"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "api_version"
          ]
        },
        {
          "type": "object",
          "properties": {
            "location": {
              "type": "string",
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
            },
            "project": {
              "type": "string",
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
            },
            "type": {
              "type": "string",
              "const": "google-vertex-gemini"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "project",
            "location"
          ]
        },
        {
          "type": "object",
          "properties": {
            "region": {
              "type": "string",
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
            },
            "type": {
              "type": "string",
              "const": "aws-bedrock-converse"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "region"
          ]
        },
        {
          "type": "object",
          "properties": {
            "api_version": {
              "type": "string",
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
            },
            "deployment": {
              "type": "string",
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
            },
            "type": {
              "type": "string",
              "const": "azure-openai-chat"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "deployment",
            "api_version"
          ]
        },
        {
          "type": "object",
          "properties": {
            "api_version": {
              "type": "string",
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
            },
            "deployment": {
              "type": "string",
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
            },
            "type": {
              "type": "string",
              "const": "azure-openai-responses"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "deployment",
            "api_version"
          ]
        },
        {
          "type": "object",
          "properties": {
            "api_version": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
            },
            "type": {
              "type": "string",
              "const": "cohere-v2-chat"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "api_version"
          ]
        },
        {
          "type": "object",
          "properties": {
            "protocol_mode": {
              "$ref": "#/$defs/OpenResponsesMode"
            },
            "type": {
              "type": "string",
              "const": "open-responses"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "protocol_mode"
          ]
        }
      ]
    },
    "ReasoningEffort": {
      "type": "string",
      "enum": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max",
        "default"
      ]
    },
    "RequestDefaults": {
      "type": "object",
      "properties": {
        "max_output_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "stop": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1
          },
          "maxItems": 8
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number",
              "maximum": 2.0,
              "minimum": 0.0
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_choice": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolChoice"
            },
            {
              "type": "null"
            }
          ]
        },
        "top_p": {
          "anyOf": [
            {
              "type": "number",
              "maximum": 1.0,
              "minimum": 0.0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "temperature",
        "top_p",
        "max_output_tokens",
        "stop",
        "seed",
        "tool_choice"
      ]
    },
    "ResolvedModelRef": {
      "type": "object",
      "properties": {
        "adapter_id": {
          "$ref": "#/$defs/AdaptorId"
        },
        "model_id": {
          "type": "string",
          "maxLength": 384,
          "minLength": 1,
          "pattern": "^[^/\\u0000-\\u0020\\u007f](?:[^/\\u0000-\\u001f\\u007f]{0,382}[^/\\u0000-\\u0020\\u007f])?$"
        },
        "provider_id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9._-]+$"
        },
        "selection": {
          "description": "One exact base or named-variant model selection.",
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "maxLength": 512,
              "minLength": 3,
              "pattern": "^[a-z0-9._-]{1,128}/[^/\\u0000-\\u0020\\u007f](?:[^/\\u0000-\\u001f\\u007f]{0,382}[^/\\u0000-\\u0020\\u007f])?$"
            },
            "variant": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^(?!base$)[a-z0-9._-]+$"
            }
          },
          "additionalProperties": false,
          "required": [
            "model",
            "variant"
          ]
        },
        "selection_fingerprint": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "selection",
        "provider_id",
        "model_id",
        "adapter_id",
        "selection_fingerprint"
      ]
    },
    "ResolvedRequestDefaults": {
      "type": "object",
      "properties": {
        "reasoning": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompiledReasoningBehavior"
            },
            {
              "type": "null"
            }
          ]
        },
        "request": {
          "$ref": "#/$defs/RequestDefaults"
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "reasoning"
      ]
    },
    "ToolChoice": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "auto",
            "none",
            "required"
          ]
        },
        {
          "type": "object",
          "properties": {
            "named": {
              "type": "string",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
            }
          },
          "additionalProperties": false,
          "required": [
            "named"
          ]
        }
      ]
    },
    "ToolName": {
      "type": "string",
      "enum": [
        "read",
        "write",
        "edit",
        "bash",
        "grep",
        "glob"
      ]
    }
  }
}
