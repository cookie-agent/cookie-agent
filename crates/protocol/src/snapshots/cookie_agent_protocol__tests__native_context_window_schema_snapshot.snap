---
source: crates/protocol/src/lib.rs
expression: schema_for!(NativeContextWindow)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NativeContextWindow",
  "description": "A bounded opaque provider-native context window returned by compaction.\n\nDebug output redacts the payload. Construction and deserialization enforce\nthe exact 32 MiB serialized-payload boundary.",
  "type": "object",
  "properties": {
    "adapter_id": {
      "type": "string"
    },
    "payload": {
      "x-max-serialized-bytes": 33554432
    },
    "scope": {
      "$ref": "#/$defs/NativeContextScope"
    }
  },
  "additionalProperties": false,
  "required": [
    "adapter_id",
    "scope",
    "payload"
  ],
  "$defs": {
    "NativeContextScope": {
      "description": "Provider, model, and behavior-affecting resource scope for native context.",
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string"
        },
        "provider_id": {
          "type": "string"
        },
        "resource_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider_id",
        "model_id",
        "resource_id"
      ]
    }
  }
}
