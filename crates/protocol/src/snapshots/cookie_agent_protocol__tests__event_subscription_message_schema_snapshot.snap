        "provider_id",
        "model_id",
        "adapter_id"
      ]
    },
    "NativeContextArtifact": {
      "description": "Safe persisted metadata for a provider-native context artifact.\nThe opaque payload is retained only in the private artifact store.",
      "type": "object",
      "properties": {
        "adapter_id": {
          "type": "string"
        },
        "byte_length": {
          "type": "integer",
          "format": "uint64",
          "maximum": 33554432,
          "minimum": 0
        },
        "reference": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "scope": {
          "$ref": "#/$defs/NativeContextScope"
        },
        "sha256": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "scope",
        "byte_length",
        "sha256",
        "reference"
      ]
    },
    "NativeContextScope": {
      "description": "Provider, model, and behavior-affecting resource scope for native context.",
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string"
        },
        "provider_id": {
          "type": "string"
        },
        "resource_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider_id",
        "model_id",
        "resource_id"
      ]
    },
    "NativeReplayArtifact": {
      "description": "A bounded Oven native replay artifact tied to an exact adapter and scope.\n\nThe payload is correctness state. Debug output redacts it, and construction\nplus deserialization enforce the 2 MiB serialized-payload boundary.",
      "type": "object",
      "properties": {
        "adapter_id": {
          "type": "string"
        },
        "payload": {
          "x-max-serialized-bytes": 2097152
        },
        "scope": {
          "$ref": "#/$defs/NativeContextScope"
        }
      },
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "scope",
        "payload"
      ]
    },
