              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "discarded_invalid_payload"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
