      "description": "The rich result sent back to the model and persisted in session history.",
      "type": "object",
      "properties": {
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolAttachment"
          }
        },
        "metadata": true,
        "output": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "truncation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolOutputTruncation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "output",
        "metadata",
        "attachments"
      ]
    },
    "TreeApprovalGrant": {
      "description": "A durable exact grant shared by one delegation tree.",
      "type": "object",
      "properties": {
        "approval_id": {
          "type": "string",
          "format": "uuid"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ApprovalCapability"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "grant_id": {
          "type": "string",
          "format": "uuid"
        },
        "operation_fingerprint": {
          "$ref": "#/$defs/OperationFingerprint"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PreparedApprovalResource"
          }
        },
        "root_session_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "grant_id",
        "root_session_id",
        "approval_id",
        "operation_fingerprint",
        "capabilities",
        "resources",
        "created_at"
      ]
    },
    "Usage": {
      "description": "Complete normalized Oven token accounting.\n\nInclusive totals are persisted exactly as reported and are never derived by\nadding component fields. Provider-specific raw usage is intentionally not a\nclient protocol field.",
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "input_tokens_cache_read": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "input_tokens_cache_write": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "input_tokens_no_cache": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "output_tokens_reasoning": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "output_tokens_text": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
