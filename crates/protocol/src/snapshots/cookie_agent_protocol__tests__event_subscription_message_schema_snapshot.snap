        "effect"
      ]
    },
    "ModelErrorKind": {
      "description": "The normalized category of an Oven model error.",
      "type": "string",
      "enum": [
        "transport",
        "timeout",
        "rate_limited",
        "auth",
        "permission_denied",
        "invalid_request",
        "model_not_found",
        "context_length",
        "quota",
        "overload",
        "unsupported",
        "unexpected_eof",
        "invalid_response",
        "invalid_tool_input",
        "content_filter",
        "replay",
        "native_context",
        "provider",
        "abort",
        "unknown"
      ]
    },
    "ModelErrorStage": {
      "description": "The phase in which an Oven model error occurred.",
      "type": "string",
      "enum": [
        "unknown",
        "request_validation",
        "request_encoding",
        "connect",
        "response_headers",
        "response_body",
        "stream_read",
        "stream_decode",
        "stream_event",
        "stream_finalize",
        "replay_encode",
        "replay_decode",
        "native_context_encode",
        "native_context_decode",
        "middleware"
      ]
    },
    "ModelErrorSummary": {
      "description": "Structured safe model failure details exposed by protocol events.\n\nOven's sanitized response body is intentionally excluded.",
      "type": "object",
      "properties": {
        "bytes_received": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "kind": {
          "$ref": "#/$defs/ModelErrorKind"
        },
        "message": {
          "type": "string"
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "retry_after_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "retryable": {
          "type": "boolean"
        },
        "stage": {
          "$ref": "#/$defs/ModelErrorStage"
        },
        "vendor_code": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "message",
        "retryable",
        "stage",
        "bytes_received"
      ]
    },
    "ModelFinishReason": {
      "description": "A semantic model completion reason.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "stop",
            "tool_calls",
            "length",
            "content_filter",
            "cancelled",
            "error",
            "aborted",
            "timeout",
            "refused",
            "unknown"
          ]
