---
source: crates/protocol/src/lib.rs
expression: schema_for!(EventSubscriptionMessage)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventSubscriptionMessage",
  "description": "A live persisted-event subscription message.\n\n`Gap` is never persisted. Its `last_delivered_seq` is an exclusive replay\ncursor: clients must re-subscribe with that cursor to receive the first\nomitted event. `session_id` identifies the subscription whose tail lagged.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "event": {
          "$ref": "#/$defs/EventEnvelope"
        },
        "type": {
          "type": "string",
          "const": "event"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "event"
      ]
    },
    {
      "type": "object",
      "properties": {
        "last_delivered_seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "const": "gap"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "session_id",
        "last_delivered_seq"
      ]
    }
  ],
  "$defs": {
    "ActionKind": {
      "description": "A permission capability used by configured rules and runtime approvals.",
      "type": "string",
      "enum": [
        "read",
        "write",
        "bash",
        "grep",
        "glob",
        "delegate",
        "external_directory"
      ]
    },
    "AgentType": {
      "description": "Whether a profile can create root sessions, delegated sessions, both, or neither.",
      "type": "string",
      "enum": [
        "all",
        "primary",
        "subagent",
        "internal"
      ]
    },
    "ApprovalBoundary": {
      "description": "Matching boundary for one canonical resource. Clients cannot edit it.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "exact"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "prefix": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "command_prefix"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "prefix"
          ]
        },
        {
          "type": "object",
          "properties": {
            "root_session_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "delegation_tree"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "root_session_id"
          ]
        }
      ]
    },
    "ApprovalCapability": {
      "description": "One capability required by the exact operation.",
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionKind"
        },
        "operation": {
          "description": "Stable semantic prepared-capability operation; never a raw path, descriptor, or temp name.",
          "type": "string",
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "operation"
      ]
    },
    "ApprovalConstraints": {
      "description": "Server-authored response constraints. There is intentionally no scope editor.",
      "type": "object",
      "properties": {
        "allow_once": {
          "type": "boolean"
        },
        "allow_tree_grant": {
          "type": "boolean"
        },
        "cancellable": {
          "type": "boolean"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "required": [
        "allow_once",
        "allow_tree_grant",
        "cancellable"
      ]
    },
    "ApprovalDecisionSource": {
      "description": "Origin of an approval decision.",
      "type": "string",
      "enum": [
        "policy",
        "model",
        "internal_agent",
        "tree_grant",
        "user",
        "doom_loop_guard",
        "system"
      ]
    },
    "ApprovalEvaluation": {
      "description": "One permission evaluation retained for an approval resource.",
      "type": "object",
      "properties": {
        "effect": {
          "$ref": "#/$defs/Effect"
        },
        "resource_digest": {
          "$ref": "#/$defs/PreparedResourceDigest"
        },
        "trace": {
          "$ref": "#/$defs/DecisionTrace"
        }
      },
      "additionalProperties": false,
      "required": [
        "resource_digest",
        "effect",
        "trace"
      ]
    },
    "ApprovalFeedback": {
      "description": "Optional human feedback associated with a user decision.",
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "message"
      ]
    },
    "ApprovalFinalDecision": {
      "description": "Final decision persisted after policy, internal-agent, grant, or user input.",
      "type": "object",
      "properties": {
        "feedback": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalFeedback"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "$ref": "#/$defs/ApprovalFinalOutcome"
        },
        "reason_code": {
          "$ref": "#/$defs/ApprovalReasonCode"
        },
        "source": {
          "$ref": "#/$defs/ApprovalDecisionSource"
        },
        "tree_grant_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "outcome",
        "source",
        "reason_code"
      ]
    },
    "ApprovalFinalOutcome": {
      "description": "Terminal approval outcome.",
      "type": "string",
      "enum": [
        "approved",
        "rejected",
        "cancelled",
        "expired"
      ]
    },
    "ApprovalInternalDecision": {
      "description": "Complete internal decision with stable explanation data.",
      "type": "object",
      "properties": {
        "decision": {
          "$ref": "#/$defs/ApprovalInternalDecisionKind"
        },
        "evaluations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ApprovalEvaluation"
          }
        },
        "reason_code": {
          "$ref": "#/$defs/ApprovalReasonCode"
        },
        "source": {
          "$ref": "#/$defs/ApprovalDecisionSource"
        }
      },
      "additionalProperties": false,
      "required": [
        "decision",
        "source",
        "reason_code",
        "evaluations"
      ]
    },
    "ApprovalInternalDecisionKind": {
      "description": "Engine/internal-agent decision before user interaction.",
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "ask",
        "escalate"
      ]
    },
    "ApprovalReasonCode": {
      "description": "Stable machine-readable reasons for approval decisions and failures.",
      "type": "string",
      "enum": [
        "policy_allowed",
        "policy_denied",
        "policy_requires_approval",
        "model_requested",
        "internal_agent_allowed",
        "internal_agent_denied",
        "tree_grant_matched",
        "user_approved_once",
        "user_approved_tree",
        "user_rejected",
        "user_cancelled",
        "request_cancelled",
        "doom_loop_detected",
        "constraint_violation",
        "operation_changed",
        "prepared_capability_lost",
        "unsupported_platform",
        "approval_expired",
        "escalated",
        "unattended",
        "system_error"
      ]
    },
    "ApprovalRequest": {
      "description": "Immutable request payload presented to clients.",
      "type": "object",
      "properties": {
        "approval_id": {
          "type": "string",
          "format": "uuid"
        },
        "constraints": {
          "$ref": "#/$defs/ApprovalConstraints"
        },
        "evaluations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ApprovalEvaluation"
          }
        },
        "operation": {
          "$ref": "#/$defs/PreparedOperationIdentity"
        },
        "operation_fingerprint": {
          "$ref": "#/$defs/OperationFingerprint"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "trigger": {
          "$ref": "#/$defs/ApprovalTrigger"
        }
      },
      "additionalProperties": false,
      "required": [
        "approval_id",
        "revision",
        "trigger",
        "operation_fingerprint",
        "operation",
        "evaluations",
        "constraints"
      ]
    },
    "ApprovalResourceSource": {
      "description": "Why a resource is part of an approval request.",
      "type": "string",
      "enum": [
        "primary_operation",
        "secondary_operation",
        "external_directory_guard",
        "model_request",
        "doom_loop_guard"
      ]
    },
    "ApprovalTrigger": {
      "description": "What caused approval evaluation to begin.",
      "type": "string",
      "enum": [
        "permission_policy",
        "model_tool_approval",
        "internal_agent",
        "doom_loop"
      ]
    },
    "ApprovalUserDecision": {
      "description": "A user's constrained response. Grant boundaries remain server-authored.",
      "type": "string",
      "enum": [
        "approve_once",
        "approve_tree",
        "reject",
        "cancel"
      ]
    },
    "ArtifactReference": {
      "description": "An opaque, non-filesystem reference to a private engine artifact.",
      "type": "object",
      "properties": {
        "uri": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "uri"
      ]
    },
    "ContextCheckpoint": {
      "description": "Durable model-visible context checkpoint. Raw history remains in the log.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "model": {
              "$ref": "#/$defs/ModelRef"
            },
            "native_context": {
              "$ref": "#/$defs/NativeContextArtifact"
            },
            "type": {
              "type": "string",
              "const": "provider_native"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "model",
            "native_context"
          ]
        },
        {
          "description": "A bounded, integrity-checked internal summary checkpoint.",
          "type": "object",
          "properties": {
            "byte_length": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "internal_run_id": {
              "type": "string",
              "format": "uuid"
            },
            "invocation_id": {
              "type": "string",
              "format": "uuid"
            },
            "sha256": {
              "type": "string",
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "summary": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "internal_summary"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "summary",
            "byte_length",
            "sha256",
            "invocation_id",
            "internal_run_id"
          ]
        }
      ]
    },
    "ContextCheckpointBoundaries": {
      "description": "Event-sequence boundaries covered by a context checkpoint.",
      "type": "object",
      "properties": {
        "input_through_seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "prior_checkpoint_seq": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "source_from_seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "source_through_seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "source_from_seq",
        "source_through_seq",
        "input_through_seq"
      ]
    },
    "ContextCheckpointBudgets": {
      "description": "Frozen token and byte budgets used to produce a checkpoint.",
      "type": "object",
      "properties": {
        "context_limit_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "input_tokens_after": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "input_tokens_before": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_summary_bytes": {
          "type": "integer",
          "maximum": 2097152,
          "minimum": 0
        },
        "target_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "trigger_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "context_limit_tokens",
        "trigger_tokens",
        "target_tokens",
        "input_tokens_before",
        "input_tokens_after",
        "max_summary_bytes"
      ]
    },
    "DecisionTrace": {
      "description": "Complete derivation of a permission decision.",
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionKind"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MatchedPermissionRule"
          }
        },
        "effect": {
          "$ref": "#/$defs/Effect"
        },
        "normalized_resource": {
          "type": "string"
        },
        "precedence_reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "normalized_resource",
        "candidates",
        "effect",
        "precedence_reason"
      ]
    },
    "DelegationSnapshot": {
      "description": "The frozen delegation portion of a session profile.",
      "type": "object",
      "properties": {
        "allowed_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "depth_limit": {
          "$ref": "#/$defs/DepthLimit"
        },
        "enabled": {
          "type": "boolean"
        },
        "result_limit_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "allowed_profiles",
        "depth_limit",
        "result_limit_bytes"
      ]
    },
    "DepthLimit": {
      "description": "The number of further delegation generations allowed beneath a session.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "finite"
            },
            "value": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "unlimited"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "Effect": {
      "description": "The result of a configured permission rule evaluation.",
      "type": "string",
      "enum": [
        "allow",
        "ask",
        "deny"
      ]
    },
    "Event": {
      "description": "A durable event payload from a session event log.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "meta": {
              "$ref": "#/$defs/SessionMeta"
            },
            "type": {
              "type": "string",
              "const": "session_created"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "meta"
          ]
        },
        {
          "type": "object",
          "properties": {
            "client_run_id": {
              "type": "string"
            },
            "current_profile": {
              "$ref": "#/$defs/ProfileIdentity"
            },
            "input": {
              "type": "string"
            },
            "profile": {
              "$ref": "#/$defs/ProfileSnapshot"
            },
            "type": {
              "type": "string",
              "const": "run_started"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "client_run_id",
            "input",
            "profile",
            "current_profile"
          ]
        },
        {
          "description": "Model-visible input injected into an already-running turn.",
          "type": "object",
          "properties": {
            "input": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "user_input_submitted"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "input"
          ]
        },
        {
          "description": "Durable association of accepted steering with the provider attempt that\nconsumed it. `user_input_seq` references `UserInputSubmitted`.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "user_input_applied"
            },
            "user_input_seq": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "user_input_seq"
          ]
        },
        {
          "type": "object",
          "properties": {
            "final_text": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "run_completed"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "run_failed"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "run_cancelled"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "run_interrupted"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "text_delta"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "reasoning_delta"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "arguments": true,
            "model_call_id": {
              "description": "Oven semantic tool-call identity used to pair model history.",
              "type": "string"
            },
            "provider_item_id": {
              "description": "Provider item identity, when distinct from the Oven semantic ID.",
              "type": [
                "string",
                "null"
              ]
            },
            "tool": {
              "type": "string"
            },
            "tool_call_id": {
              "description": "Engine-generated durable execution and audit identity.",
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "tool_call_started"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "tool_call_id",
            "model_call_id",
            "tool",
            "arguments"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "tool_call_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "tool_call_progress"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "tool_call_id",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "result": {
              "$ref": "#/$defs/ToolResult"
            },
            "tool_call_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "tool_call_completed"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "tool_call_id",
            "result"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "$ref": "#/$defs/ToolCallFailureCode"
            },
            "message": {
              "type": "string"
            },
            "tool_call_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "tool_call_failed"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "tool_call_id",
            "code",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "request": {
              "$ref": "#/$defs/ApprovalRequest"
            },
            "type": {
              "type": "string",
              "const": "approval_requested"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "request"
          ]
        },
        {
          "type": "object",
          "properties": {
            "approval_id": {
              "type": "string",
              "format": "uuid"
            },
            "decision": {
              "$ref": "#/$defs/ApprovalInternalDecision"
            },
            "type": {
              "type": "string",
              "const": "approval_evaluated"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "approval_id",
            "decision"
          ]
        },
        {
          "type": "object",
          "properties": {
            "approval_id": {
              "type": "string",
              "format": "uuid"
            },
            "reason_code": {
              "$ref": "#/$defs/ApprovalReasonCode"
            },
            "type": {
              "type": "string",
              "const": "approval_escalated"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "approval_id",
            "reason_code"
          ]
        },
        {
          "type": "object",
          "properties": {
            "approval_id": {
              "type": "string",
              "format": "uuid"
            },
            "client_response_id": {
              "type": "string"
            },
            "decision": {
              "$ref": "#/$defs/ApprovalUserDecision"
            },
            "feedback": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ApprovalFeedback"
