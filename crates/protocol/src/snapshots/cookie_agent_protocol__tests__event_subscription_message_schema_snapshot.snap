        {
          "type": "object",
          "properties": {
            "other": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "other"
          ]
        }
      ]
    },
    "ModelRef": {
      "description": "A model entry in a profile fallback chain.",
      "type": "object",
      "properties": {
        "adapter_id": {
          "description": "Oven adapter identity used for native replay compatibility.",
          "type": "string"
        },
        "model_id": {
          "description": "Exact provider model, deployment, or resource identity.",
          "type": "string"
        },
        "name": {
          "description": "Cookie-agent configuration alias.",
          "type": "string"
        },
        "provider_id": {
          "description": "Serving provider identity.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
