            },
            "provider_item_id": {
              "description": "Bounded provider item identity.",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
            },
