---
source: crates/protocol/src/tests.rs
expression: schema_for!(PersistedModelTurn)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PersistedModelTurn",
  "type": "object",
  "properties": {
    "content": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PersistedAssistantPart"
      },
      "maxItems": 4096
    },
    "finish_reason": {
      "$ref": "#/$defs/ModelFinishReason"
    },
    "native_replay": {
      "anyOf": [
        {
          "$ref": "#/$defs/NativeReplayArtifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider_metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "provider_options": {
      "type": "object",
      "additionalProperties": true
    },
    "response_metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    }
  },
  "additionalProperties": false,
  "required": [
    "content",
    "provider_options",
    "finish_reason",
    "usage",
    "response_metadata",
    "provider_metadata",
    "native_replay"
  ],
  "$defs": {
    "ArtifactReference": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "uri"
      ]
    },
    "ModelFinishReason": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "stop",
            "tool_calls",
            "length",
            "content_filter",
            "cancelled",
            "error",
            "aborted",
            "timeout",
            "refused",
            "unknown"
          ]
        },
        {
          "type": "object",
          "properties": {
            "other": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "other"
          ]
        }
      ]
    },
    "NativeContextScope": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string",
          "maxLength": 384,
          "minLength": 1,
          "pattern": "^[^/\\u0000-\\u0020\\u007f](?:[^/\\u0000-\\u001f\\u007f]{0,382}[^/\\u0000-\\u0020\\u007f])?$"
        },
        "provider_id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9._-]+$"
        },
        "resource_id": {
          "description": "Control-free bounded presentation text.",
          "type": "string",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider_id",
        "model_id",
        "resource_id"
      ]
    },
    "NativeReplayArtifact": {
      "type": "object",
      "properties": {
        "adapter_id": {
          "description": "Stable lowercase machine-readable code.",
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "payload": {
          "x-max-serialized-bytes": 2097152
        },
        "scope": {
          "$ref": "#/$defs/NativeContextScope"
        },
        "selection_fingerprint": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "selection_fingerprint",
        "scope",
        "payload"
      ]
    },
