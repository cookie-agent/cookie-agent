---
source: crates/protocol/src/tests.rs
expression: schema_for!(RuntimeSnapshotResult)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuntimeSnapshotResult",
  "description": "`runtime.snapshot.get`: the daemon's current catalog view.",
  "type": "object",
  "properties": {
    "snapshot": {
      "$ref": "#/$defs/ModelCatalogView"
    }
  },
  "required": [
    "snapshot"
  ],
  "$defs": {
    "AgentDescriptor": {
      "type": "object",
      "properties": {
        "delegation_targets": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9]))*$"
          },
          "maxItems": 256
        },
        "description": {
          "type": "string",
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^(?=.*\\S)[^\\p{Cc}\\p{Cf}]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9]))*$"
        },
        "mode": {
          "$ref": "#/$defs/AgentMode"
        },
        "preset": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "resolved_fallback": {
          "type": "array",
          "items": {
            "description": "One exact base or named-variant model selection.",
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "maxLength": 512,
                "minLength": 3,
                "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+(?:/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+)*$"
              },
              "variant": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^(?!base$)[a-z0-9][a-z0-9._-]{0,63}$"
              }
            },
            "required": [
              "model",
              "variant"
            ]
          },
          "maxItems": 256
        },
        "runnable_as_root": {
          "type": "boolean"
        },
        "runtime": {
          "description": "For an ACP agent a runtime hosts (client protocol 1.17.0): the\nruntime, its own ID for the agent, and whether a session can use it\nnow. Absent for the daemon's own agents.",
          "anyOf": [
            {
              "$ref": "#/$defs/AgentRuntime"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "description",
        "mode",
        "enabled",
        "runnable_as_root",
        "resolved_fallback",
        "delegation_targets"
      ]
    },
    "AgentMode": {
      "description": "A value this build does not know reads as `internal`: an internal agent,\nwhich is neither runnable as a root nor a delegation target.",
      "type": "string",
      "enum": [
        "primary",
        "subagent",
        "all",
        "internal"
      ],
      "x-open": true
    },
    "AgentRuntime": {
      "description": "Where an ACP agent runs (`docs/site/specs/acp-agents.md` section 3).",
      "type": "object",
      "properties": {
        "agent": {
          "description": "The agent's ID on the runtime, the key of its declaration.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9]))*$"
        },
        "available": {
          "description": "Whether a session or a delegation can use it now: its runtime is\nconnected, or the daemon starts it on demand, and it is enabled.",
          "type": "boolean"
        },
        "runtime_id": {
          "description": "The runtime that hosts the agent.",
          "type": "string",
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        }
      },
      "required": [
        "runtime_id",
        "agent",
        "available"
      ]
    },
    "AuthCredentialDescriptor": {
      "type": "object",
      "properties": {
        "credential_type": {
          "$ref": "#/$defs/CredentialFieldType"
        },
        "display_name": {
          "description": "Control-free bounded presentation text.",
          "type": "string",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
        },
        "help": {
          "description": "Control-free bounded presentation text.",
          "type": "string",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
        },
        "id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{0,127}$"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "display_name",
        "help",
        "required",
        "credential_type"
      ]
    },
    "AuthMethodDescriptor": {
      "type": "object",
      "properties": {
        "credentials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuthCredentialDescriptor"
          },
          "maxItems": 32,
          "minItems": 1
        },
        "display_name": {
          "description": "Control-free bounded presentation text.",
          "type": "string",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
        },
        "id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        }
      },
      "required": [
        "id",
        "display_name",
        "credentials"
      ]
    },
    "AvailableModelDescriptor": {
      "type": "object",
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/ModelCapabilities"
        },
        "default_variant": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?!base$)[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "display_name": {
          "type": "string",
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^(?=.*\\S)[^\\p{Cc}\\p{Cf}]+$"
        },
        "input_media": {
          "description": "What the model accepts in user input, by kind, with the effective\nlimits (`docs/site/specs/compatibility-v1.md` section 11.2). A kind\nabsent here is not accepted; a reader keeps kinds it does not know\nand never offers them.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/InputMedia"
          },
          "maxItems": 16
        },
        "key": {
          "type": "string",
          "maxLength": 512,
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+(?:/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+)*$"
        },
        "variant_order": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^(?!base$)[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "maxItems": 256
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AvailableVariantDescriptor"
          },
          "maxItems": 256
        }
      },
      "required": [
        "key",
        "display_name",
        "capabilities",
        "input_media",
        "variants",
        "variant_order",
        "default_variant"
      ]
    },
    "AvailableVariantDescriptor": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string",
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^(?=.*\\S)[^\\p{Cc}\\p{Cf}]+$"
        },
        "id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?!base$)[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "origin": {
          "$ref": "#/$defs/VariantOrigin"
        }
      },
      "required": [
        "id",
        "display_name",
        "origin"
      ]
    },
    "CancellationCapability": {
      "description": "A value this build does not know reads as `local_only`.",
      "type": "string",
      "enum": [
        "provider",
        "local_only"
      ],
      "x-open": true
    },
    "CatalogAge": {
      "description": "Age of the selected validated catalog body; age never makes it unusable.\n\nA value this build does not know reads as `older_than_thirty_days`.",
      "type": "string",
      "enum": [
        "current",
        "older_than_seven_days",
        "older_than_thirty_days"
      ],
      "x-open": true
    },
    "CatalogSafeErrorMeta": {
      "type": "object",
      "properties": {
        "code": {
          "description": "Stable lowercase machine-readable code.",
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "message": {
          "description": "Control-free bounded safe error text.",
          "type": "string",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
        },
        "time": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "code",
        "message",
        "time"
      ]
    },
    "CatalogSource": {
      "description": "A value this build does not know reads as `cache`.",
      "type": "string",
      "enum": [
        "network",
        "bootstrap",
        "cache"
      ],
      "x-open": true
    },
    "CatalogStatus": {
      "description": "Where the daemon's model catalog stands: its source, its age, the records\nit quarantined, and its last refresh error.",
      "type": "object",
      "properties": {
        "age": {
          "$ref": "#/$defs/CatalogAge"
        },
        "last_error": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalogSafeErrorMeta"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_quarantine_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "provider_quarantine_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/CatalogSource"
        },
        "stale": {
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "stale",
        "age",
        "provider_quarantine_count",
        "model_quarantine_count",
        "last_error"
      ]
    },
    "CredentialFieldType": {
      "description": "A value this build does not know reads as `api_key`: a secret like an API\nkey.",
      "type": "string",
      "enum": [
        "access_token",
        "access_key_id",
        "secret_access_key",
        "session_token",
        "api_key"
      ],
      "x-open": true
    },
    "DurableConnectionDescriptor": {
      "type": "object",
      "properties": {
        "auth_method": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "connected_at": {
          "type": "string",
          "format": "date-time"
        },
        "connection_generation": {
          "description": "Monotonic provider connection generation.",
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 1
        },
        "credential_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]{0,127}$"
          },
          "maxItems": 32
        },
        "provider_id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "setup_values": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,127}$": {
              "$ref": "#/$defs/SafeSetupValue"
            }
          }
        }
      },
      "required": [
        "provider_id",
        "setup_values",
        "auth_method",
        "credential_fields",
        "connection_generation",
        "connected_at"
      ]
    },
    "EffectiveAuthState": {
      "description": "A value this build does not know reads as `unavailable`.",
      "type": "string",
      "enum": [
        "authored_api_key",
        "authored_override",
        "provider_store",
        "no_auth",
        "unavailable"
      ],
      "x-open": true
    },
    "InputMedia": {
      "description": "What one model accepts of one media kind in user input. The limits are\neffective: the lowest of the model's capability, its provider's delivery\nlimits, and the attachment caps.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "A media kind, such as `image`.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        },
        "max_bytes": {
          "description": "The largest accepted file.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_count": {
          "description": "The most parts of this kind one input carries.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_dimension": {
          "description": "The longest accepted side of an image or video, in pixels.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "max_pixels": {
          "description": "The most pixels an accepted image or video frame has.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "mime_types": {
          "description": "The media types accepted, such as `image/png`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "mime_types",
        "max_bytes",
        "max_count"
      ]
    },
    "MediaCapability": {
      "type": "object",
      "properties": {
        "max_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        },
        "max_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        },
        "mime_types": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 255,
            "minLength": 3,
            "pattern": "^[^/\\s]+/[^/\\s]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "mime_types",
        "max_bytes",
        "max_count"
      ]
    },
    "Modality": {
      "description": "A model's input or output modality. A reader of a model's capabilities\ndrops a modality it does not know.",
      "type": "string",
      "enum": [
        "text",
        "image",
        "audio",
        "pdf",
        "video"
      ],
      "x-open": true
    },
    "ModelCapabilities": {
      "type": "object",
      "properties": {
        "cancellation": {
          "$ref": "#/$defs/CancellationCapability"
        },
        "context_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        },
        "input": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Modality"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "media": {
          "description": "Per media kind. A reader drops a kind it does not know.",
          "type": "object",
          "properties": {
            "audio": {
              "$ref": "#/$defs/MediaCapability"
            },
            "image": {
              "$ref": "#/$defs/MediaCapability"
            },
            "pdf": {
              "$ref": "#/$defs/MediaCapability"
            },
            "video": {
              "$ref": "#/$defs/MediaCapability"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/MediaCapability"
          }
        },
        "native_replay": {
          "$ref": "#/$defs/ReplayCapability"
        },
        "output": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Modality"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        },
        "parallel_tool_calls": {
          "type": "boolean"
        },
        "reasoning": {
          "type": "boolean"
        },
        "seed": {
          "type": "boolean"
        },
        "structured_output": {
          "type": "boolean"
        },
        "temperature": {
          "type": "boolean"
        },
        "tool_calling": {
          "type": "boolean"
        },
        "top_p": {
          "type": "boolean"
        }
      },
      "required": [
        "input",
        "output",
        "context_tokens",
        "output_tokens",
        "tool_calling",
        "parallel_tool_calls",
        "structured_output",
        "reasoning",
        "temperature",
        "top_p",
        "seed",
        "native_replay",
        "cancellation",
        "media"
      ]
    },
    "ModelCatalogView": {
      "description": "What a client sees of the daemon's providers, models, and agents. It\ncarries only client-facing descriptors: no frozen model bindings, recipe\nidentities, compiler versions, or internal revisions, which change\nwithout anything a client shows changing.",
      "type": "object",
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentDescriptor"
          },
          "maxItems": 4096
        },
        "catalog": {
          "$ref": "#/$defs/CatalogStatus"
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AvailableModelDescriptor"
          },
          "maxItems": 4096
        },
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProviderDescriptor"
          },
          "maxItems": 4096
        },
        "revision": {
          "description": "Changes whenever anything this view shows changes. `provider.connect`\nand `provider.disconnect` send back the revision they were filled\nfrom.",
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        }
      },
      "required": [
        "revision",
        "catalog",
        "providers",
        "models",
        "agents"
      ]
    },
    "ModelUnavailableKind": {
      "description": "Why a provider's catalog model is not selectable.\n\nA value this build does not know reads as `unsupported`.",
      "oneOf": [
        {
          "description": "The catalog parser quarantined the model record.",
          "type": "string",
          "const": "quarantined"
        },
        {
          "description": "Provider setup values (region, resource, deployment) are missing.",
          "type": "string",
          "const": "needs_setup"
        },
        {
          "description": "No usable credentials are configured or stored for the provider.",
          "type": "string",
          "const": "needs_credentials"
        },
        {
          "description": "The record parsed, but cookie cannot drive the model.",
          "type": "string",
          "const": "unsupported"
        }
      ],
      "x-open": true
    },
    "ProviderConfigurationState": {
      "description": "A value this build does not know reads as `unconfigured`.",
      "type": "string",
      "enum": [
        "authored",
        "stored",
        "authored_and_stored",
        "unconfigured"
      ],
      "x-open": true
    },
    "ProviderDescriptor": {
      "type": "object",
      "properties": {
        "auth_methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuthMethodDescriptor"
          }
        },
        "configuration": {
          "$ref": "#/$defs/ProviderConfigurationState"
        },
        "display_name": {
          "description": "Control-free bounded presentation text.",
          "type": "string",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
        },
        "documentation_url": {
          "description": "The catalog's provider documentation URL, when it has one.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
        },
        "durable_connection": {
          "anyOf": [
            {
              "$ref": "#/$defs/DurableConnectionDescriptor"
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_auth_state": {
          "$ref": "#/$defs/EffectiveAuthState"
        },
        "environment": {
          "description": "Environment variable names the catalog associates with the provider,\nin catalog order. Display-only: cookie never reads them implicitly.",
          "type": "array",
          "items": {
            "description": "Strict provider credential field name.",
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^[A-Z0-9_]+$"
          },
          "maxItems": 32
        },
        "id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "model_counts": {
          "$ref": "#/$defs/ProviderModelCounts"
        },
        "presence": {
          "$ref": "#/$defs/ProviderPresence"
        },
        "quarantine": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuarantineDiagnostic"
            },
            {
              "type": "null"
            }
          ]
        },
        "setup_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SetupFieldDescriptor"
          }
        },
        "support": {
          "$ref": "#/$defs/ProviderSupport"
        },
        "unavailable_models": {
          "description": "Unavailable models with reasons, strictly sorted by ID. Listed only\nfor configured (authored or stored) providers; unconfigured providers\nreport counts alone.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnavailableModelDescriptor"
          },
          "maxItems": 4096
        }
      },
      "required": [
        "id",
        "display_name",
        "presence",
        "support",
        "setup_fields",
        "auth_methods",
        "configuration",
        "effective_auth_state",
        "durable_connection",
        "quarantine",
        "documentation_url",
        "environment",
        "model_counts",
        "unavailable_models"
      ]
    },
    "ProviderModelCounts": {
      "description": "Per-provider model availability counts over every catalog model row that\nis not deprecated, disabled, or non-text.",
      "type": "object",
      "properties": {
        "available": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "needs_credentials": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "needs_setup": {
