---
source: crates/protocol/src/lib.rs
expression: schema_for!(PersistedModelTurn)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PersistedModelTurn",
  "description": "A complete committed Oven assistant turn used for durable normalized replay.",
  "type": "object",
  "properties": {
    "content": {
      "description": "Ordered role-safe assistant content.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/PersistedAssistantPart"
      }
    },
    "finish_reason": {
      "$ref": "#/$defs/ModelFinishReason"
    },
    "native_replay": {
      "anyOf": [
        {
          "$ref": "#/$defs/NativeReplayArtifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider_metadata": {
      "description": "Safe provider-specific terminal metadata retained by Oven at finish.",
      "type": "object",
      "additionalProperties": true
    },
    "provider_options": {
      "description": "Provider options scoped to the assistant message.",
      "type": "object",
      "additionalProperties": true
    },
    "response_metadata": {
      "description": "Safe provider response metadata retained by Oven at finish.",
      "type": "object",
      "additionalProperties": true
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "content",
    "provider_options",
    "finish_reason",
    "usage",
    "response_metadata",
    "provider_metadata",
    "warnings"
  ],
  "$defs": {
    "ArtifactReference": {
      "description": "An opaque, non-filesystem reference to a private engine artifact.",
      "type": "object",
      "properties": {
        "uri": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "uri"
      ]
    },
    "ModelFinishReason": {
      "description": "A semantic model completion reason.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "stop",
            "tool_calls",
            "length",
            "content_filter",
            "cancelled",
            "error",
            "aborted",
            "timeout",
            "refused",
            "unknown"
          ]
        },
        {
          "type": "object",
          "properties": {
            "other": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "other"
          ]
        }
      ]
    },
    "NativeContextScope": {
      "description": "Provider, model, and behavior-affecting resource scope for native context.",
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string"
        },
        "provider_id": {
          "type": "string"
        },
        "resource_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider_id",
        "model_id",
        "resource_id"
      ]
    },
    "NativeReplayArtifact": {
      "description": "A bounded Oven native replay artifact tied to an exact adapter and scope.\n\nThe payload is correctness state. Debug output redacts it, and construction\nplus deserialization enforce the 2 MiB serialized-payload boundary.",
      "type": "object",
      "properties": {
        "adapter_id": {
          "type": "string"
        },
        "payload": {
          "x-max-serialized-bytes": 2097152
        },
        "scope": {
          "$ref": "#/$defs/NativeContextScope"
        }
      },
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "scope",
        "payload"
      ]
    },
    "PersistedAssistantPart": {
      "description": "Ordered replay-relevant content in one completed Oven assistant turn.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "metadata": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true
            },
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "metadata": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true
            },
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "reasoning"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "input": true,
            "metadata": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true
            },
            "name": {
              "type": "string"
            },
            "provider_item_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "raw_input": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "tool_call"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "name",
            "input"
          ]
        },
        {
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/PersistedToolContent"
            },
            "is_error": {
              "type": "boolean"
            },
            "metadata": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true
            },
            "tool_call_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "tool_result"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "tool_call_id",
            "content",
            "is_error"
          ]
        },
        {
          "type": "object",
          "properties": {
            "file": {
              "$ref": "#/$defs/PersistedFilePart"
            },
            "type": {
              "type": "string",
              "const": "file"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "file"
          ]
        },
        {
          "type": "object",
          "properties": {
            "excerpt": {
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "media_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "metadata": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "source"
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": [
                "string",
                "null"
              ]
            },
            "metadata": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true
            },
            "tool_call_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "tool_approval"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "tool_call_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": true,
            "kind": {
              "type": "string"
            },
            "metadata": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true
            },
            "type": {
              "type": "string",
              "const": "custom"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "kind",
            "data"
          ]
        }
      ]
    },
    "PersistedContentValue": {
      "description": "One value inside mixed model-visible tool output.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "file": {
              "$ref": "#/$defs/PersistedFilePart"
            },
            "type": {
              "type": "string",
              "const": "file"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "file"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "json"
            },
            "value": true
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        }
      ]
    },
    "PersistedFilePart": {
      "description": "A persisted MIME-typed file referenced by model content.",
      "type": "object",
      "properties": {
        "filename": {
          "type": [
            "string",
            "null"
          ]
        },
        "media_type": {
          "type": "string"
        },
        "metadata": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "source": {
          "$ref": "#/$defs/PersistedFileSource"
        }
      },
      "additionalProperties": false,
      "required": [
        "media_type",
        "source"
      ]
    },
    "PersistedFileSource": {
      "description": "A MIME-typed model file source. Inline bytes, inline text, and base64 are\ndeliberately absent: persisted files are references only.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "byte_length": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "reference": {
              "$ref": "#/$defs/ArtifactReference"
            },
            "sha256": {
              "type": "string",
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "type": {
              "type": "string",
              "const": "artifact"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "byte_length",
            "sha256",
            "reference"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "url"
            },
            "url": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "provider_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "provider_reference"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "provider_id",
            "id"
          ]
        }
      ]
    },
    "PersistedToolContent": {
      "description": "Model-visible tool output retained inside a committed assistant turn.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "json"
            },
            "value": true
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "mixed"
            },
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PersistedContentValue"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "values"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "denied"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        }
      ]
    },
    "Usage": {
      "description": "Complete normalized Oven token accounting.\n\nInclusive totals are persisted exactly as reported and are never derived by\nadding component fields. Provider-specific raw usage is intentionally not a\nclient protocol field.",
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "input_tokens_cache_read": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "input_tokens_cache_write": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "input_tokens_no_cache": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "output_tokens_reasoning": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "output_tokens_text": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
