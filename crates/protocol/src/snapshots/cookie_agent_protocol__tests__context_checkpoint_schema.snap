---
source: crates/protocol/src/tests.rs
expression: schema_for!(ContextCheckpointCommit)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextCheckpointCommit",
  "type": "object",
  "properties": {
    "boundaries": {
      "$ref": "#/$defs/ContextCheckpointBoundaries"
    },
    "budgets": {
      "$ref": "#/$defs/ContextCheckpointBudgets"
    },
    "checkpoint": {
      "$ref": "#/$defs/ContextCheckpoint"
    }
  },
  "additionalProperties": false,
  "required": [
    "checkpoint",
    "boundaries",
    "budgets"
  ],
  "$defs": {
    "AdaptorId": {
      "type": "string",
      "enum": [
        "anthropic",
        "openai-chat",
        "openai-responses",
        "openai-compatible",
        "google-gemini",
        "google-vertex-gemini",
        "aws-bedrock-converse",
        "azure-openai-chat",
        "azure-openai-responses",
        "cohere-v2-chat",
        "open-responses"
      ]
    },
    "ArtifactReference": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "uri"
      ]
    },
    "ContextCheckpoint": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "model": {
              "$ref": "#/$defs/ResolvedModelRef"
            },
            "native_context": {
              "$ref": "#/$defs/NativeContextArtifact"
            },
            "type": {
              "type": "string",
              "const": "provider_native"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "model",
            "native_context"
          ]
        },
        {
          "type": "object",
          "properties": {
            "byte_length": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "internal_run_id": {
              "type": "string",
              "format": "uuid"
            },
            "invocation_id": {
              "type": "string",
              "format": "uuid"
            },
            "sha256": {
              "type": "string",
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "summary": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "internal_summary"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "summary",
            "byte_length",
            "sha256",
            "invocation_id",
            "internal_run_id"
          ]
        }
      ]
    },
    "ContextCheckpointBoundaries": {
      "type": "object",
      "properties": {
        "input_through_seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "prior_checkpoint_seq": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "source_from_seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        },
        "source_through_seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "source_from_seq",
        "source_through_seq",
        "input_through_seq",
        "prior_checkpoint_seq"
      ]
    },
    "ContextCheckpointBudgets": {
      "type": "object",
      "properties": {
        "context_limit_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        },
        "input_tokens_after": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "input_tokens_before": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        },
        "max_summary_bytes": {
          "type": "integer",
          "maximum": 2097152,
          "minimum": 0
        },
        "target_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        },
        "trigger_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "context_limit_tokens",
        "trigger_tokens",
        "target_tokens",
        "input_tokens_before",
        "input_tokens_after",
        "max_summary_bytes"
      ]
    },
    "NativeContextArtifact": {
      "type": "object",
      "properties": {
        "adapter_id": {
          "description": "Stable lowercase machine-readable code.",
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "byte_length": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reference": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "scope": {
          "$ref": "#/$defs/NativeContextScope"
        },
        "selection_fingerprint": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "sha256": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "selection_fingerprint",
        "scope",
        "byte_length",
        "sha256",
        "reference"
      ]
    },
    "NativeContextScope": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string",
          "maxLength": 384,
          "minLength": 1,
          "pattern": "^[^/\\u0000-\\u0020\\u007f](?:[^/\\u0000-\\u001f\\u007f]{0,382}[^/\\u0000-\\u0020\\u007f])?$"
        },
        "provider_id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9._-]+$"
        },
        "resource_id": {
          "description": "Control-free bounded presentation text.",
          "type": "string",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider_id",
        "model_id",
        "resource_id"
      ]
    },
    "ResolvedModelRef": {
      "type": "object",
      "properties": {
        "adapter_id": {
          "$ref": "#/$defs/AdaptorId"
        },
        "model_id": {
          "type": "string",
          "maxLength": 384,
          "minLength": 1,
          "pattern": "^[^/\\u0000-\\u0020\\u007f](?:[^/\\u0000-\\u001f\\u007f]{0,382}[^/\\u0000-\\u0020\\u007f])?$"
        },
        "provider_id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9._-]+$"
        },
        "selection": {
          "description": "One exact base or named-variant model selection.",
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "maxLength": 512,
              "minLength": 3,
              "pattern": "^[a-z0-9._-]{1,128}/[^/\\u0000-\\u0020\\u007f](?:[^/\\u0000-\\u001f\\u007f]{0,382}[^/\\u0000-\\u0020\\u007f])?$"
            },
            "variant": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^(?!base$)[a-z0-9._-]+$"
            }
          },
          "additionalProperties": false,
          "required": [
            "model",
            "variant"
          ]
        },
        "selection_fingerprint": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "selection",
        "provider_id",
        "model_id",
        "adapter_id",
        "selection_fingerprint"
      ]
    }
  }
}
