{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelSnapshotManifestV1",
  "type": "object",
  "properties": {
    "payload": {
      "$ref": "#/$defs/ModelSnapshotPayloadV1"
    },
    "revision": {
      "type": "string",
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "payload"
  ],
  "$defs": {
    "CompiledReasoningBehavior": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "effort"
            },
            "value": {
              "$ref": "#/$defs/ReasoningEffort"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "toggle"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "enabled"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "budget_tokens"
            },
            "value": {
              "type": "integer",
              "format": "int64",
              "minimum": -1
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        }
      ]
    },
    "CompiledSafeModelBlueprint": {
      "type": "object",
      "properties": {
        "auth_method": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "behavior_fingerprint": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "blueprint_fingerprint": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "compiler_version": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "config_override_fingerprint": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "credential_binding": {
          "$ref": "#/$defs/FrozenCredentialBinding"
        },
        "defaults": {
          "$ref": "#/$defs/FrozenResolvedRequestDefaults"
        },
        "descriptor": {
          "type": "object",
          "properties": {
            "adapter_id": {
              "type": "string",
              "minLength": 1
            },
            "capabilities": {
              "type": "object",
              "properties": {
                "cancellation": {
                  "type": "string",
                  "enum": [
                    "local_only",
                    "remote_best_effort",
                    "unsupported"
                  ]
                },
                "compaction": {
                  "type": "string",
                  "const": "unsupported"
                },
                "features": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "tool_calling",
                      "parallel_tools",
                      "tool_input_deltas",
                      "reasoning",
                      "structured_output",
                      "temperature",
                      "top_p",
                      "max_output_tokens",
                      "prompt_caching",
                      "usage",
                      "provider_tools",
                      "sources"
                    ]
                  },
                  "uniqueItems": true
                },
                "limits": {
                  "type": "object",
                  "properties": {
                    "context": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "input": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "output": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "context",
                    "input",
                    "output"
                  ]
                },
                "media": {
                  "type": "object",
                  "properties": {
                    "input": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "media_types": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 3
                            },
                            "minItems": 1
                          },
                          "sources": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "inline_bytes",
                                "inline_text",
                                "url",
                                "provider_reference"
                              ]
                            },
                            "minItems": 1,
                            "uniqueItems": true
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "media_types",
                          "sources"
                        ]
                      }
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "input"
                  ]
                },
                "modalities": {
                  "type": "object",
                  "properties": {
                    "input": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "output": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "input",
                    "output"
                  ]
                },
                "replay": {
                  "type": "object",
                  "properties": {
                    "capability": {
                      "type": "string",
                      "enum": [
                        "required",
                        "optional",
                        "unsupported"
                      ]
                    },
                    "policy": {
                      "type": "string",
                      "enum": [
                        "never",
                        "if_valid",
                        "always"
                      ]
                    },
                    "reasoning": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "policy",
                    "capability",
                    "reasoning"
                  ]
                }
              },
              "additionalProperties": false,
              "required": [
                "features",
                "limits",
                "modalities",
                "media",
                "cancellation",
                "compaction",
                "replay"
              ]
            },
            "identity": {
              "type": "object",
              "properties": {
                "model_id": {
                  "type": "string",
                  "minLength": 1
                },
                "provider_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "provider_id",
                "model_id"
              ]
            },
            "provider_metadata": {
              "type": "object"
            }
          },
          "additionalProperties": false,
          "required": [
            "identity",
            "adapter_id",
            "capabilities",
            "provider_metadata"
          ]
        },
        "endpoint_identity": {
          "type": "string",
          "maxLength": 2048,
          "minLength": 1
        },
        "options": {
          "$ref": "#/$defs/ProviderOptions"
        },
        "protocol_recipe": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "provider_recipe": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "selection": {
          "$ref": "#/$defs/ModelSelection"
        },
        "selection_fingerprint": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "setup_binding": {
          "$ref": "#/$defs/FrozenSetupBinding"
        },
        "setup_recipe": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "source": {
          "$ref": "#/$defs/FrozenProviderSource"
        },
        "static_headers": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$": {
              "type": "string",
              "maxLength": 8192
            }
          }
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FrozenVariantBlueprint"
          },
          "maxItems": 256
        }
      },
      "additionalProperties": false,
      "required": [
        "blueprint_fingerprint",
        "selection",
        "source",
        "config_override_fingerprint",
        "setup_binding",
        "credential_binding",
        "endpoint_identity",
        "provider_recipe",
        "protocol_recipe",
        "setup_recipe",
        "auth_method",
        "compiler_version",
        "descriptor",
        "defaults",
        "options",
        "static_headers",
        "variants",
        "behavior_fingerprint",
        "selection_fingerprint"
      ]
    },
    "FrozenCredentialBinding": {
      "type": "object",
      "properties": {
        "auth_method": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]{0,127}$"
          },
          "maxItems": 32
        },
        "owned_headers": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,127}$": {
              "type": "string",
              "maxLength": 512,
              "minLength": 1
            }
          }
        },
        "source": {
          "$ref": "#/$defs/FrozenCredentialSource"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "auth_method",
        "fields",
        "parameters",
        "owned_headers"
      ]
    },
    "FrozenCredentialSource": {
      "type": "string",
      "enum": [
        "authored_api_key",
        "authored_override",
        "provider_store",
        "no_auth"
      ]
    },
    "FrozenProviderSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "package_claim": {
              "type": "string"
            },
            "provider_recipe": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
            },
            "recipe_fingerprint": {
              "type": "string",
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "source_record_digest": {
              "type": "string",
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "type": {
              "type": "string",
              "const": "managed"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "provider_recipe",
            "source_record_digest",
            "recipe_fingerprint",
            "package_claim"
          ]
        },
        {
          "type": "object",
          "properties": {
            "safe_definition_fingerprint": {
              "type": "string",
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "type": {
              "type": "string",
              "const": "custom"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "safe_definition_fingerprint"
          ]
        }
      ]
    },
    "FrozenRequestDefaults": {
      "type": "object",
      "properties": {
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "stop": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "temperature": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32,
          "minLength": 1
        },
        "tool_choice": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolChoice"
            },
            {
              "type": "null"
            }
          ]
        },
        "top_p": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "stop"
      ]
    },
    "FrozenResolvedRequestDefaults": {
      "type": "object",
      "properties": {
        "reasoning": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompiledReasoningBehavior"
            },
            {
              "type": "null"
            }
          ]
        },
        "request": {
          "$ref": "#/$defs/FrozenRequestDefaults"
        }
      },
      "additionalProperties": false,
      "required": [
        "request"
      ]
    },
    "FrozenSetupBinding": {
      "type": "object",
      "properties": {
        "setup_fingerprint": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "setup_recipe": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "values": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,127}$": {
              "$ref": "#/$defs/SafeSetupValue"
            }
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "setup_recipe",
        "values",
        "setup_fingerprint"
      ]
    },
    "FrozenVariantBlueprint": {
      "type": "object",
      "properties": {
        "behavior_fingerprint": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "defaults": {
          "$ref": "#/$defs/FrozenResolvedRequestDefaults"
        },
        "descriptor": {
          "type": "object",
          "properties": {
            "adapter_id": {
              "type": "string",
              "minLength": 1
            },
            "capabilities": {
              "type": "object",
              "properties": {
                "cancellation": {
                  "type": "string",
                  "enum": [
                    "local_only",
                    "remote_best_effort",
                    "unsupported"
                  ]
                },
                "compaction": {
                  "type": "string",
                  "const": "unsupported"
                },
                "features": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "tool_calling",
                      "parallel_tools",
                      "tool_input_deltas",
                      "reasoning",
                      "structured_output",
                      "temperature",
                      "top_p",
                      "max_output_tokens",
                      "prompt_caching",
                      "usage",
                      "provider_tools",
                      "sources"
                    ]
                  },
                  "uniqueItems": true
                },
                "limits": {
                  "type": "object",
                  "properties": {
                    "context": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "input": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "output": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "context",
                    "input",
                    "output"
                  ]
                },
                "media": {
                  "type": "object",
                  "properties": {
                    "input": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "media_types": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 3
                            },
                            "minItems": 1
                          },
                          "sources": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "inline_bytes",
                                "inline_text",
                                "url",
                                "provider_reference"
                              ]
                            },
                            "minItems": 1,
                            "uniqueItems": true
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "media_types",
                          "sources"
                        ]
                      }
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "input"
                  ]
                },
                "modalities": {
                  "type": "object",
                  "properties": {
                    "input": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "output": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "input",
                    "output"
                  ]
                },
                "replay": {
                  "type": "object",
                  "properties": {
                    "capability": {
                      "type": "string",
                      "enum": [
                        "required",
                        "optional",
                        "unsupported"
                      ]
                    },
                    "policy": {
                      "type": "string",
                      "enum": [
                        "never",
                        "if_valid",
                        "always"
                      ]
                    },
                    "reasoning": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "policy",
                    "capability",
                    "reasoning"
                  ]
                }
              },
              "additionalProperties": false,
              "required": [
                "features",
                "limits",
                "modalities",
                "media",
                "cancellation",
                "compaction",
                "replay"
              ]
            },
            "identity": {
              "type": "object",
              "properties": {
                "model_id": {
                  "type": "string",
                  "minLength": 1
                },
                "provider_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "provider_id",
                "model_id"
              ]
            },
            "provider_metadata": {
              "type": "object"
            }
          },
          "additionalProperties": false,
          "required": [
            "identity",
            "adapter_id",
            "capabilities",
            "provider_metadata"
          ]
        },
        "id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?!base$)[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "options": {
          "$ref": "#/$defs/ProviderOptions"
        },
        "selection_fingerprint": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "static_headers": {
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "patternProperties": {
            "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$": {
              "type": "string",
              "maxLength": 8192
            }
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "descriptor",
        "defaults",
        "options",
        "behavior_fingerprint",
        "selection_fingerprint"
      ]
    },
    "ModelSelection": {
      "description": "One exact base or named-variant model selection.",
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "maxLength": 512,
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+(?:/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+)*$"
        },
        "variant": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?!base$)[a-z0-9][a-z0-9._-]{0,63}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "model"
      ]
    },
    "ModelSnapshotPayloadV1": {
      "type": "object",
      "properties": {
        "blueprints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CompiledSafeModelBlueprint"
          },
          "maxItems": 4096
        },
        "catalog_revision": {
          "type": "string",
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "model_revision": {
          "type": "string",
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "provider_state_revision": {
          "type": "string",
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "recipe_registry_revision": {
          "type": "string",
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "catalog_revision",
        "recipe_registry_revision",
        "provider_state_revision",
        "model_revision",
        "blueprints"
      ]
    },
    "ProviderOptions": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "api_version": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
            },
            "beta": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 512,
                "minLength": 1,
                "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
              },
              "maxItems": 32,
              "uniqueItems": true
            },
            "type": {
              "type": "string",
              "const": "anthropic"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "api_version",
            "beta"
          ]
        },
        {
          "type": "object",
          "properties": {
            "organization": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512,
