{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExtensionAgentBeforeStartResult",
  "type": "object",
  "properties": {
    "addendum": {
      "type": [
        "string",
        "null"
      ]
    },
    "append_to_system_prompt": {
      "type": [
        "string",
        "null"
      ]
    },
    "inject_message": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExtensionInjectedMessage"
        },
        {
          "type": "null"
        }
      ]
    },
    "replace_system_prompt": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ExtensionInjectedMessage": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ExtensionMessageRole"
        }
      },
      "additionalProperties": false,
      "required": [
        "role",
        "content"
      ]
    },
    "ExtensionMessageRole": {
      "type": "string",
      "enum": [
        "system",
        "user",
        "assistant",
        "tool"
      ]
    }
  }
}