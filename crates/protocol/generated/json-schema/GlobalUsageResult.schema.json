{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GlobalUsageResult",
  "type": "object",
  "properties": {
    "usage": {
      "$ref": "#/$defs/UsageRollup"
    }
  },
  "additionalProperties": false,
  "required": [
    "usage"
  ],
  "$defs": {
    "ModelUsageRollup": {
      "type": "object",
      "properties": {
        "cache_hit_rate": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "cache_read_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "estimated_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "request_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "request_count",
        "cache_hit_rate",
        "estimated_cost_usd"
      ]
    },
    "UsageRollup": {
      "type": "object",
      "properties": {
        "by_model": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z0-9][a-z0-9._-]{0,127}/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+(?:/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+)*$": {
              "$ref": "#/$defs/ModelUsageRollup"
            }
          }
        },
        "cache_hit_rate": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "cache_read_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "estimated_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "request_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "request_count",
        "cache_hit_rate",
        "estimated_cost_usd",
        "by_model"
      ]
    }
  }
}