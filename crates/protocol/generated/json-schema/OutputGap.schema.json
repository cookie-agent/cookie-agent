{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OutputGap",
  "type": "object",
  "properties": {
    "call_id": {
      "type": "string",
      "format": "uuid"
    },
    "next_offset": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "stream": {
      "$ref": "#/$defs/OutputStream"
    }
  },
  "additionalProperties": false,
  "required": [
    "call_id",
    "stream",
    "next_offset"
  ],
  "$defs": {
    "OutputStream": {
      "type": "string",
      "enum": [
        "stdout",
        "stderr"
      ]
    }
  }
}