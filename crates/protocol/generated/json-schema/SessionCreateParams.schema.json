{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionCreateParams",
  "type": "object",
  "properties": {
    "selection": {
      "$ref": "#/$defs/RunSelection"
    }
  },
  "additionalProperties": false,
  "required": [
    "selection"
  ],
  "$defs": {
    "RunSelection": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9]))*$"
        },
        "model": {
          "description": "One exact base or named-variant model selection.",
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "maxLength": 512,
              "minLength": 3,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+(?:/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+)*$"
            },
            "variant": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^(?!base$)[a-z0-9][a-z0-9._-]{0,63}$"
            }
          },
          "additionalProperties": false,
          "required": [
            "model",
            "variant"
          ]
        },
        "preset": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "agent",
        "model"
      ]
    }
  }
}