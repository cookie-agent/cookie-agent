{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionTreeResult",
  "type": "object",
  "properties": {
    "tree": {
      "$ref": "#/$defs/SessionTree"
    }
  },
  "additionalProperties": false,
  "required": [
    "tree"
  ],
  "$defs": {
    "RunSelection": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9]))*$"
        },
        "model": {
          "description": "One exact base or named-variant model selection.",
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "maxLength": 512,
              "minLength": 3,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+(?:/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+)*$"
            },
            "variant": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^(?!base$)[a-z0-9][a-z0-9._-]{0,63}$"
            }
          },
          "additionalProperties": false,
          "required": [
            "model",
            "variant"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "agent",
        "model"
      ]
    },
    "SessionMeta": {
      "type": "object",
      "properties": {
        "agent_revision": {
          "type": "string",
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "catalog_revision": {
          "type": "string",
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "creation_selection": {
          "$ref": "#/$defs/RunSelection"
        },
        "cwd_identity": {
          "description": "Opaque canonical workspace identity.",
          "type": "string",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
        },
        "last_activity": {
          "type": "string",
          "format": "date-time"
        },
        "last_event_seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        },
        "manifest_revision": {
          "type": "string",
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "model_revision": {
          "type": "string",
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "origin": {
          "$ref": "#/$defs/SessionOrigin"
        },
        "provider_state_revision": {
          "type": "string",
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "recipe_registry_revision": {
          "type": "string",
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "runtime_revision": {
          "type": "string",
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "skipped_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SkippedEvent"
          }
        },
        "status": {
          "$ref": "#/$defs/SessionStatus"
        },
        "title": {
          "description": "Nonblank control-free UTF-8 session title.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512,
          "minLength": 1
        },
        "title_updated_seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "session_id",
        "origin",
        "cwd_identity",
        "creation_selection",
        "runtime_revision",
        "catalog_revision",
        "provider_state_revision",
        "model_revision",
        "agent_revision",
        "recipe_registry_revision",
        "manifest_revision",
        "title",
        "title_updated_seq",
        "last_event_seq",
        "last_activity",
        "status",
        "skipped_events"
      ]
    },
    "SessionOrigin": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "root"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "depth": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "invocation_id": {
              "type": "string",
              "format": "uuid"
            },
            "parent_run_id": {
              "type": "string",
              "format": "uuid"
            },
            "parent_session_id": {
              "type": "string",
              "format": "uuid"
            },
            "parent_tool_call_id": {
              "type": "string",
              "format": "uuid"
            },
            "root_session_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "delegated"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "root_session_id",
            "parent_session_id",
            "parent_run_id",
            "parent_tool_call_id",
            "invocation_id",
            "depth"
          ]
        }
      ]
    },
    "SessionStatus": {
      "type": "string",
      "enum": [
        "idle",
        "running",
        "completed",
        "failed",
        "cancelled",
        "interrupted"
      ]
    },
    "SessionTree": {
      "type": "object",
      "properties": {
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SessionTree"
          }
        },
        "session": {
          "$ref": "#/$defs/SessionMeta"
        }
      },
      "additionalProperties": false,
      "required": [
        "session",
        "children"
      ]
    },
    "SkippedEvent": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "seq",
        "reason"
      ]
    }
  }
}