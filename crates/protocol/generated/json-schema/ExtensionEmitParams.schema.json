{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExtensionEmitParams",
  "description": "Non-model publication only. Model-bound content must use producer.send with\nan explicitly registered producer; emit must never implicitly register one.",
  "type": "object",
  "properties": {
    "context_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "payload": true,
    "session_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "additionalProperties": false,
  "required": [
    "session_id",
    "context_id",
    "name",
    "payload"
  ]
}