{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CatalogProviderListResult",
  "type": "object",
  "properties": {
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CatalogProvider"
      },
      "maxItems": 1000
    },
    "snapshot": {
      "$ref": "#/$defs/CatalogSnapshot"
    }
  },
  "additionalProperties": false,
  "required": [
    "snapshot",
    "providers"
  ],
  "$defs": {
    "CatalogProvider": {
      "type": "object",
      "properties": {
        "api": {
          "description": "Trimmed bounded catalog display text.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 16384,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "credential_fields": {
          "type": "array",
          "items": {
            "description": "Strict provider credential field name.",
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^[A-Z0-9_]+$"
          },
          "maxItems": 32,
          "minItems": 1
        },
        "documentation_url": {
          "description": "Trimmed bounded catalog display text.",
          "type": "string",
          "maxLength": 16384,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "id": {
          "description": "Bounded catalog identity.",
          "type": "string",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
        },
        "name": {
          "description": "Trimmed bounded catalog display text.",
          "type": "string",
          "maxLength": 16384,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "npm": {
          "description": "Trimmed bounded catalog display text.",
          "type": "string",
          "maxLength": 16384,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "credential_fields",
        "npm",
        "api",
        "documentation_url"
      ]
    },
    "CatalogSnapshot": {
      "type": "object",
      "properties": {
        "fetched_at": {
          "type": "string",
          "format": "date-time",
          "const": "2026-08-01T17:34:27Z"
        },
        "revision": {
          "type": "string",
          "const": "sha256:d65af0b058204954f6b08af537fa13e91f251c618d69d8c20a2d5915731d482a"
        },
        "source": {
          "type": "string",
          "const": "https://github.com/anomalyco/models.dev@c3057690bbb8bd41cafdefadcd2a7b958e2a4642"
        }
      },
      "additionalProperties": false,
      "required": [
        "revision",
        "source",
        "fetched_at"
      ]
    }
  }
}