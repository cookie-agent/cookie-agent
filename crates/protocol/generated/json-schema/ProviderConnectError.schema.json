{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderConnectError",
  "type": "object",
  "properties": {
    "client_connect_id": {
      "description": "Bounded provider connection idempotency key.",
      "type": "string",
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
    },
    "code": {
      "$ref": "#/$defs/ProviderConnectErrorCode"
    },
    "provider_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    }
  },
  "additionalProperties": false,
  "required": [
    "code",
    "provider_id",
    "client_connect_id"
  ],
  "$defs": {
    "ProviderConnectErrorCode": {
      "type": "string",
      "enum": [
        "unknown_provider",
        "unsupported_provider",
        "quarantined_provider",
        "removed_without_retained_recipe_match",
        "catalog_revision_conflict",
        "missing_setup_field",
        "invalid_setup_field",
        "missing_credential",
        "invalid_credential",
        "unsupported_auth_method",
        "provider_store_write_failed",
        "runtime_compile_failed",
        "idempotency_conflict"
      ]
    }
  }
}