{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderConnectError",
  "type": "object",
  "properties": {
    "client_connect_id": {
      "description": "Bounded provider connection idempotency key.",
      "type": "string",
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
    },
    "code": {
      "$ref": "#/$defs/ProviderConnectErrorCode"
    },
    "missing_credential_fields": {
      "type": "array",
      "items": {
        "description": "Strict provider credential field name.",
        "type": "string",
        "maxLength": 1024,
        "minLength": 1,
        "pattern": "^[A-Z0-9_]+$"
      },
      "maxItems": 32
    },
    "provider_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9._-]+$"
    }
  },
  "additionalProperties": false,
  "required": [
    "code",
    "provider_id",
    "client_connect_id",
    "missing_credential_fields"
  ],
  "$defs": {
    "ProviderConnectErrorCode": {
      "type": "string",
      "enum": [
        "unknown_provider",
        "unsupported_provider",
        "catalog_revision_conflict",
        "missing_credential",
        "invalid_credential",
        "credential_storage_failed",
        "idempotency_conflict"
      ]
    }
  }
}