{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelListResult",
  "type": "object",
  "properties": {
    "catalog_revision": {
      "type": "string",
      "const": "sha256:d65af0b058204954f6b08af537fa13e91f251c618d69d8c20a2d5915731d482a"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AvailableModelDescriptor"
      },
      "maxItems": 4096
    },
    "revision": {
      "description": "SHA-256 snapshot revision.",
      "type": "string",
      "maxLength": 71,
      "minLength": 1,
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "required": [
    "revision",
    "generated_at",
    "catalog_revision",
    "models"
  ],
  "$defs": {
    "AvailableModelDescriptor": {
      "type": "object",
      "properties": {
        "behavior_fingerprint": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "capabilities": {
          "$ref": "#/$defs/ModelCapabilities"
        },
        "default_variant": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?!base$)[a-z0-9._-]+$"
        },
        "display_name": {
          "type": "string",
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^(?=.*\\S)[^\\p{Cc}\\p{Cf}]+$"
        },
        "key": {
          "type": "string",
          "maxLength": 512,
          "minLength": 3,
          "pattern": "^[a-z0-9._-]{1,128}/[^/\\u0000-\\u0020\\u007f](?:[^/\\u0000-\\u001f\\u007f]{0,382}[^/\\u0000-\\u0020\\u007f])?$"
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AvailableVariantDescriptor"
          },
          "maxItems": 256
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "display_name",
        "capabilities",
        "variants",
        "default_variant",
        "behavior_fingerprint"
      ]
    },
    "AvailableVariantDescriptor": {
      "type": "object",
      "properties": {
        "behavior_fingerprint": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "display_name": {
          "type": "string",
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^(?=.*\\S)[^\\p{Cc}\\p{Cf}]+$"
        },
        "id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?!base$)[a-z0-9._-]+$"
        },
        "origin": {
          "$ref": "#/$defs/VariantOrigin"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "origin",
        "behavior_fingerprint"
      ]
    },
    "CancellationCapability": {
      "type": "string",
      "enum": [
        "local_only",
        "provider"
      ]
    },
    "CompactionCapability": {
      "type": "string",
      "enum": [
        "unsupported",
        "optional",
        "required"
      ]
    },
    "MediaCapability": {
      "type": "object",
      "properties": {
        "max_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        },
        "max_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        },
        "mime_types": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 255,
            "minLength": 3,
            "pattern": "^[^/\\s]+/[^/\\s]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "mime_types",
        "max_bytes",
        "max_count"
      ]
    },
    "Modality": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "audio",
        "pdf"
      ]
    },
    "ModelCapabilities": {
      "type": "object",
      "properties": {
        "cancellation": {
          "$ref": "#/$defs/CancellationCapability"
        },
        "context_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        },
        "input": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Modality"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "media": {
          "type": "object",
          "properties": {
            "audio": {
              "$ref": "#/$defs/MediaCapability"
            },
            "image": {
              "$ref": "#/$defs/MediaCapability"
            },
            "pdf": {
              "$ref": "#/$defs/MediaCapability"
            }
          },
          "additionalProperties": false
        },
        "native_compaction": {
          "$ref": "#/$defs/CompactionCapability"
        },
        "native_replay": {
          "$ref": "#/$defs/ReplayCapability"
        },
        "output": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Modality"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        },
        "parallel_tool_calls": {
          "type": "boolean"
        },
        "reasoning": {
          "type": "boolean"
        },
        "seed": {
          "type": "boolean"
        },
        "structured_output": {
          "type": "boolean"
        },
        "temperature": {
          "type": "boolean"
        },
        "tool_calling": {
          "type": "boolean"
        },
        "top_p": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "input",
        "output",
        "context_tokens",
        "output_tokens",
        "tool_calling",
        "parallel_tool_calls",
        "structured_output",
        "reasoning",
        "temperature",
        "top_p",
        "seed",
        "native_replay",
        "native_compaction",
        "cancellation",
        "media"
      ]
    },
    "ReplayCapability": {
      "type": "string",
      "enum": [
        "unsupported",
        "optional",
        "required"
      ]
    },
    "VariantOrigin": {
      "type": "string",
      "enum": [
        "models_dev_effort",
        "models_dev_toggle",
        "models_dev_budget_tokens",
        "explicit"
      ]
    }
  }
}