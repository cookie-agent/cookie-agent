{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StoredDelegationJournalRecord",
  "type": "object",
  "properties": {
    "delegation_journal_schema_version": {
      "type": "integer",
      "const": 9
    },
    "record": {
      "$ref": "#/$defs/DelegationJournalRecord"
    }
  },
  "additionalProperties": false,
  "required": [
    "delegation_journal_schema_version",
    "record"
  ],
  "$defs": {
    "AgentDocumentSource": {
      "type": "string",
      "enum": [
        "built_in",
        "user",
        "workspace"
      ]
    },
    "AgentMode": {
      "type": "string",
      "enum": [
        "primary",
        "subagent",
        "all"
      ]
    },
    "AgentSnapshot": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9]))*$"
        },
        "composed_prompt": {
          "type": "string",
          "maxLength": 131072,
          "minLength": 1,
          "pattern": "(?s)^(?=.*\\S).+$"
        },
        "delegation": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrozenDelegationPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^(?=.*\\S)[^\\p{Cc}\\p{Cf}]+$"
        },
        "document_fingerprint": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "document_source": {
          "$ref": "#/$defs/AgentDocumentSource"
        },
        "fallback_chain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FrozenModelBinding"
          },
          "maxItems": 256,
          "minItems": 1
        },
        "mode": {
          "$ref": "#/$defs/AgentMode"
        },
        "permissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PermissionRule"
          },
          "maxItems": 256
        },
        "prompt_fingerprint": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema": {
          "type": "integer",
          "const": 2
        },
        "selected_suffix_start": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolName"
          },
          "maxItems": 256
        }
      },
      "additionalProperties": false,
      "required": [
        "agent",
        "schema",
        "mode",
        "description",
        "document_source",
        "document_fingerprint",
        "composed_prompt",
        "prompt_fingerprint",
        "tools",
        "permissions",
        "delegation",
        "fallback_chain",
        "selected_suffix_start"
      ]
    },
    "CompiledReasoningBehavior": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "effort"
            },
            "value": {
              "$ref": "#/$defs/ReasoningEffort"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "toggle"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "enabled"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "budget_tokens"
            },
            "value": {
              "type": "integer",
              "format": "int64",
              "minimum": -1
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        }
      ]
    },
    "DelegateRequestPayload": {
      "type": "object",
      "properties": {
        "context": {
          "type": "array",
          "items": true,
          "maxItems": 256
        },
        "expected_output": true,
        "success_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 256
        },
        "task": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "task",
        "context",
        "success_criteria",
        "expected_output"
      ]
    },
    "DelegationJournalRecord": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "agent_revision": {
              "type": "string",
              "maxLength": 71,
              "minLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "catalog_revision": {
              "type": "string",
              "maxLength": 71,
              "minLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "child_agent": {
              "$ref": "#/$defs/AgentSnapshot"
            },
            "manifest_revision": {
              "type": "string",
              "maxLength": 71,
              "minLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "model_revision": {
              "type": "string",
              "maxLength": 71,
              "minLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "provider_state_revision": {
              "type": "string",
              "maxLength": 71,
              "minLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "recipe_registry_revision": {
              "type": "string",
              "maxLength": 71,
              "minLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "request": {
              "$ref": "#/$defs/DelegateRequestPayload"
            },
            "request_fingerprint": {
              "type": "string",
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "reservation": {
              "$ref": "#/$defs/DelegationReservation"
            },
            "runtime_revision": {
              "type": "string",
              "maxLength": 71,
              "minLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "selected_suffix": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/FrozenModelBinding"
              },
              "maxItems": 256,
              "minItems": 1
            },
            "task": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "delegation_started"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "reservation",
            "child_agent",
            "manifest_revision",
            "runtime_revision",
            "catalog_revision",
            "provider_state_revision",
            "model_revision",
            "agent_revision",
            "recipe_registry_revision",
            "selected_suffix",
            "request_fingerprint",
            "task",
            "request"
          ]
        },
        {
          "type": "object",
          "properties": {
            "invocation_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "delegation_linked"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "invocation_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "child_run_id": {
              "type": "string",
              "format": "uuid"
            },
            "invocation_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "delegation_run_started"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "invocation_id",
            "child_run_id"
          ]
        }
      ]
    },
    "DelegationReservation": {
      "type": "object",
      "properties": {
        "child_session_id": {
          "type": "string",
          "format": "uuid"
        },
        "invocation_id": {
          "type": "string",
          "format": "uuid"
        },
        "parent_run_id": {
          "type": "string",
          "format": "uuid"
        },
        "parent_session_id": {
          "type": "string",
          "format": "uuid"
        },
        "parent_tool_call_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "invocation_id",
        "parent_session_id",
        "parent_run_id",
        "parent_tool_call_id",
        "child_session_id"
      ]
    },
    "FrozenCredentialBinding": {
      "type": "object",
      "properties": {
        "auth_method": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]{0,127}$"
          },
          "maxItems": 32
        },
        "owned_headers": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,127}$": {
              "type": "string",
              "maxLength": 512,
              "minLength": 1
            }
          }
        },
        "source": {
          "$ref": "#/$defs/FrozenCredentialSource"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "auth_method",
        "fields",
        "parameters",
        "owned_headers"
      ]
    },
    "FrozenCredentialSource": {
      "type": "string",
      "enum": [
        "authored_api_key",
        "authored_override",
        "provider_store",
        "no_auth"
      ]
    },
    "FrozenDelegationPolicy": {
      "type": "object",
      "properties": {
        "effective_depth_ceiling": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9]))*$"
          },
          "maxItems": 256,
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "targets",
        "effective_depth_ceiling"
      ]
    },
    "FrozenModelBinding": {
      "type": "object",
      "properties": {
        "behavior_fingerprint": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "blueprint_fingerprint": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "compiler_version": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "config_override_fingerprint": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "credential_binding": {
          "$ref": "#/$defs/FrozenCredentialBinding"
        },
        "defaults": {
          "$ref": "#/$defs/FrozenResolvedRequestDefaults"
        },
        "descriptor": {
          "type": "object",
          "properties": {
            "adapter_id": {
              "type": "string",
              "minLength": 1
            },
            "capabilities": {
              "type": "object",
              "properties": {
                "cancellation": {
                  "type": "string",
                  "enum": [
                    "local_only",
                    "remote_best_effort",
                    "unsupported"
                  ]
                },
                "compaction": {
                  "type": "string",
                  "enum": [
                    "native",
                    "unsupported"
                  ]
                },
                "features": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "tool_calling",
                      "parallel_tools",
                      "tool_input_deltas",
                      "reasoning",
                      "structured_output",
                      "temperature",
                      "top_p",
                      "max_output_tokens",
                      "prompt_caching",
                      "usage",
                      "provider_tools",
                      "sources"
                    ]
                  },
                  "uniqueItems": true
                },
                "limits": {
                  "type": "object",
                  "properties": {
                    "context": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "input": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "output": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "context",
                    "input",
                    "output"
                  ]
                },
                "media": {
                  "type": "object",
                  "properties": {
                    "input": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "media_types": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 3
                            },
                            "minItems": 1
                          },
                          "sources": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "inline_bytes",
                                "inline_text",
                                "url",
                                "provider_reference"
                              ]
                            },
                            "minItems": 1,
                            "uniqueItems": true
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "media_types",
                          "sources"
                        ]
                      }
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "input"
                  ]
                },
                "modalities": {
                  "type": "object",
                  "properties": {
                    "input": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "output": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "input",
                    "output"
                  ]
                },
                "replay": {
                  "type": "object",
                  "properties": {
                    "capability": {
                      "type": "string",
                      "enum": [
                        "required",
                        "optional",
                        "unsupported"
                      ]
                    },
                    "policy": {
                      "type": "string",
                      "enum": [
                        "never",
                        "if_valid",
                        "always"
                      ]
                    },
                    "reasoning": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "policy",
                    "capability",
                    "reasoning"
                  ]
                }
              },
              "additionalProperties": false,
              "required": [
                "features",
                "limits",
                "modalities",
                "media",
                "cancellation",
                "compaction",
                "replay"
              ]
            },
            "identity": {
              "type": "object",
              "properties": {
                "model_id": {
                  "type": "string",
                  "minLength": 1
                },
                "provider_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "provider_id",
                "model_id"
              ]
            },
            "provider_metadata": {
              "type": "object"
            }
          },
          "additionalProperties": false,
          "required": [
            "identity",
            "adapter_id",
            "capabilities",
            "provider_metadata"
          ]
        },
        "endpoint_identity": {
          "type": "string",
          "maxLength": 2048,
          "minLength": 1
        },
        "manifest_revision": {
          "type": "string",
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "options": {
          "$ref": "#/$defs/ProviderOptions"
        },
        "protocol_recipe": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "provider_recipe": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "selection": {
          "$ref": "#/$defs/ModelSelection"
        },
        "selection_fingerprint": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "setup_binding": {
          "$ref": "#/$defs/FrozenSetupBinding"
        },
        "setup_recipe": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "source": {
          "$ref": "#/$defs/FrozenProviderSource"
        },
        "static_headers": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$": {
              "type": "string",
              "maxLength": 8192
            }
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "manifest_revision",
        "blueprint_fingerprint",
        "selection",
        "source",
        "config_override_fingerprint",
        "credential_binding",
        "setup_binding",
        "endpoint_identity",
        "provider_recipe",
        "protocol_recipe",
        "setup_recipe",
        "compiler_version",
        "descriptor",
        "defaults",
        "options",
        "static_headers",
        "behavior_fingerprint",
        "selection_fingerprint"
      ]
    },
    "FrozenProviderSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "package_claim": {
              "type": "string"
            },
            "provider_recipe": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
            },
            "recipe_fingerprint": {
              "type": "string",
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "source_record_digest": {
              "type": "string",
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "type": {
              "type": "string",
              "const": "managed"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "provider_recipe",
            "source_record_digest",
            "recipe_fingerprint",
            "package_claim"
          ]
        },
        {
          "type": "object",
          "properties": {
            "safe_definition_fingerprint": {
              "type": "string",
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "type": {
              "type": "string",
              "const": "custom"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "safe_definition_fingerprint"
          ]
        }
      ]
    },
    "FrozenRequestDefaults": {
      "type": "object",
      "properties": {
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "stop": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "temperature": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32,
          "minLength": 1
        },
        "tool_choice": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolChoice"
            },
            {
              "type": "null"
            }
          ]
        },
        "top_p": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "stop"
      ]
    },
    "FrozenResolvedRequestDefaults": {
      "type": "object",
      "properties": {
        "reasoning": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompiledReasoningBehavior"
            },
            {
              "type": "null"
            }
          ]
        },
        "request": {
          "$ref": "#/$defs/FrozenRequestDefaults"
        }
      },
      "additionalProperties": false,
      "required": [
        "request"
      ]
    },
    "FrozenSetupBinding": {
      "type": "object",
      "properties": {
        "setup_fingerprint": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "setup_recipe": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "values": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,127}$": {
              "$ref": "#/$defs/SafeSetupValue"
            }
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "setup_recipe",
        "values",
        "setup_fingerprint"
      ]
    },
    "ModelSelection": {
      "description": "One exact base or named-variant model selection.",
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "maxLength": 512,
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+(?:/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+)*$"
        },
        "variant": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?!base$)[a-z0-9][a-z0-9._-]{0,63}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "model"
      ]
    },
    "PermissionAction": {
      "type": "string",
