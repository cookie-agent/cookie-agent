{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExtensionInitializeResult",
  "type": "object",
  "properties": {
    "capabilities": {
      "$ref": "#/$defs/ExtensionPluginCapabilities"
    },
    "name": {
      "type": "string"
    },
    "protocol_version": {
      "type": "string",
      "const": "0.0.3"
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExtensionToolDeclaration"
      }
    },
    "version": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "name",
    "version",
    "capabilities",
    "tools"
  ],
  "$defs": {
    "ExtensionInterceptionHook": {
      "type": "string",
      "enum": [
        "tool_before_call",
        "tool_after_result",
        "agent_before_start",
        "session_before_compact"
      ]
    },
    "ExtensionPluginCapabilities": {
      "type": "object",
      "properties": {
        "intercept": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExtensionInterceptionHook"
          }
        },
        "publish_bus": {
          "type": "boolean"
        },
        "publish_session_events": {
          "type": "boolean"
        },
        "resources": {
          "type": "boolean"
        },
        "subscribe_bus": {
          "type": "boolean"
        },
        "subscribe_events": {
          "type": "boolean"
        },
        "tools": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "tools",
        "resources",
        "subscribe_events",
        "subscribe_bus",
        "publish_bus",
        "publish_session_events",
        "intercept"
      ]
    },
    "ExtensionToolDeclaration": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parameters": true,
        "permission_name": {
          "type": "string"
        },
        "primary_resource_param": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "parameters",
        "permission_name",
        "primary_resource_param"
      ]
    }
  }
}