{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CatalogModelListResult",
  "type": "object",
  "properties": {
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CatalogModel"
      },
      "maxItems": 100000
    },
    "snapshot": {
      "$ref": "#/$defs/CatalogSnapshot"
    }
  },
  "additionalProperties": false,
  "required": [
    "snapshot",
    "models"
  ],
  "$defs": {
    "CatalogModality": {
      "type": "string",
      "enum": [
        "text",
        "audio",
        "image",
        "video",
        "pdf"
      ]
    },
    "CatalogModel": {
      "type": "object",
      "properties": {
        "canonical_model_id": {
          "description": "Trimmed bounded catalog display text.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 16384,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "capabilities": {
          "$ref": "#/$defs/CatalogModelCapabilities"
        },
        "family": {
          "description": "Trimmed bounded catalog display text.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 16384,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "last_updated": {
          "type": "string",
          "maxLength": 10,
          "minLength": 7,
          "pattern": "^[0-9]{4}-[0-9]{2}(?:-[0-9]{2})?$"
        },
        "limits": {
          "$ref": "#/$defs/CatalogModelLimits"
        },
        "modalities": {
          "$ref": "#/$defs/CatalogModelModalities"
        },
        "model_id": {
          "description": "Bounded catalog identity.",
          "type": "string",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
        },
        "name": {
          "description": "Trimmed bounded catalog display text.",
          "type": "string",
          "maxLength": 16384,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "provider_id": {
          "description": "Bounded catalog identity.",
          "type": "string",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
        },
        "reasoning_options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CatalogReasoningOption"
          },
          "maxItems": 3
        },
        "release_date": {
          "type": "string",
          "maxLength": 10,
          "minLength": 7,
          "pattern": "^[0-9]{4}-[0-9]{2}(?:-[0-9]{2})?$"
        },
        "status": {
          "$ref": "#/$defs/CatalogModelStatus"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider_id",
        "model_id",
        "canonical_model_id",
        "name",
        "family",
        "capabilities",
        "reasoning_options",
        "limits",
        "modalities",
        "status",
        "release_date",
        "last_updated"
      ]
    },
    "CatalogModelCapabilities": {
      "type": "object",
      "properties": {
        "attachment": {
          "type": "boolean"
        },
        "reasoning": {
          "type": "boolean"
        },
        "structured_output": {
          "type": "boolean"
        },
        "temperature": {
          "type": "boolean"
        },
        "tool_call": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "attachment",
        "reasoning",
        "tool_call",
        "structured_output",
        "temperature"
      ]
    },
    "CatalogModelLimits": {
      "type": "object",
      "properties": {
        "context": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        },
        "input": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "output": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "context",
        "input",
        "output"
      ]
    },
    "CatalogModelModalities": {
      "type": "object",
      "properties": {
        "input": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CatalogModality"
          },
          "maxItems": 8,
          "minItems": 1
        },
        "output": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CatalogModality"
          },
          "maxItems": 8,
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "input",
        "output"
      ]
    },
    "CatalogModelStatus": {
      "type": "string",
      "enum": [
        "stable",
        "alpha",
        "beta",
        "deprecated"
      ]
    },
    "CatalogReasoningOption": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "effort"
            },
            "values": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ReasoningEffort"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "maxItems": 9,
              "minItems": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "values"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "toggle"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "max": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            },
            "min": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            },
            "type": {
              "type": "string",
              "const": "budget_tokens"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "min",
            "max"
          ]
        }
      ]
    },
    "CatalogSnapshot": {
      "type": "object",
      "properties": {
        "fetched_at": {
          "type": "string",
          "format": "date-time",
          "const": "2026-08-01T17:34:27Z"
        },
        "revision": {
          "type": "string",
          "const": "sha256:d65af0b058204954f6b08af537fa13e91f251c618d69d8c20a2d5915731d482a"
        },
        "source": {
          "type": "string",
          "const": "https://github.com/anomalyco/models.dev@c3057690bbb8bd41cafdefadcd2a7b958e2a4642"
        }
      },
      "additionalProperties": false,
      "required": [
        "revision",
        "source",
        "fetched_at"
      ]
    },
    "ReasoningEffort": {
      "type": "string",
      "enum": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max",
        "default"
      ]
    }
  }
}