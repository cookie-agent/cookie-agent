{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExtensionInitializeParams",
  "type": "object",
  "properties": {
    "capabilities": {
      "$ref": "#/$defs/ExtensionEngineCapabilities"
    },
    "engine_version": {
      "type": "string"
    },
    "protocol_version": {
      "type": "string",
      "const": "0.0.4"
    }
  },
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "engine_version",
    "capabilities"
  ],
  "$defs": {
    "ExtensionEngineCapabilities": {
      "type": "object",
      "properties": {
        "event_publishing": {
          "type": "boolean"
        },
        "event_streaming": {
          "type": "boolean"
        },
        "interception": {
          "type": "boolean"
        },
        "ping": {
          "type": "boolean"
        },
        "shutdown": {
          "type": "boolean"
        },
        "tools": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "ping",
        "shutdown",
        "tools",
        "event_streaming",
        "event_publishing",
        "interception"
      ]
    }
  }
}