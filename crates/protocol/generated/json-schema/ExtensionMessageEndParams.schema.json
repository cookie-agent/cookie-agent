{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExtensionMessageEndParams",
  "type": "object",
  "properties": {
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "content": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PersistedAssistantPart"
      }
    },
    "context_id": {
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/ExtensionMessageRole"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "additionalProperties": false,
  "required": [
    "session_id",
    "context_id",
    "attempt_id",
    "role",
    "content"
  ],
  "$defs": {
    "ArtifactReference": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "uri"
      ]
    },
    "ExtensionMessageRole": {
      "type": "string",
      "enum": [
        "system",
        "user",
        "assistant",
        "tool"
      ]
    },
    "PersistedAssistantPart": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "metadata": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true
            },
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "text",
            "metadata"
          ]
        },
        {
          "type": "object",
          "properties": {
            "metadata": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true
            },
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "reasoning"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "text",
            "metadata"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "description": "Bounded semantic model tool-call identity.",
              "type": "string",
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
            },
            "input": true,
            "metadata": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true
            },
            "name": {
              "description": "Stable lowercase machine-readable code.",
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "provider_item_id": {
              "description": "Bounded provider item identity.",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
            },
            "raw_input": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "tool_call"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "provider_item_id",
            "name",
            "input",
            "raw_input",
            "metadata"
          ]
        },
        {
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/PersistedToolContent"
            },
            "is_error": {
              "type": "boolean"
            },
            "metadata": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true
            },
            "tool_call_id": {
              "description": "Bounded semantic model tool-call identity.",
              "type": "string",
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
            },
            "type": {
              "type": "string",
              "const": "tool_result"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "tool_call_id",
            "content",
            "is_error",
            "metadata"
          ]
        },
        {
          "type": "object",
          "properties": {
            "file": {
              "$ref": "#/$defs/PersistedFilePart"
            },
            "type": {
              "type": "string",
              "const": "file"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "file"
          ]
        },
        {
          "type": "object",
          "properties": {
            "excerpt": {
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "media_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "metadata": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "source"
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "url",
            "title",
            "media_type",
            "excerpt",
            "metadata"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": [
                "string",
                "null"
              ]
            },
            "metadata": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true
            },
            "tool_call_id": {
              "description": "Bounded semantic model tool-call identity.",
              "type": "string",
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
            },
            "type": {
              "type": "string",
              "const": "tool_approval"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "tool_call_id",
            "message",
            "metadata"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": true,
            "kind": {
              "description": "Stable lowercase machine-readable code.",
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "metadata": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true
            },
            "type": {
              "type": "string",
              "const": "custom"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "kind",
            "data",
            "metadata"
          ]
        }
      ]
    },
    "PersistedContentValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "file": {
              "$ref": "#/$defs/PersistedFilePart"
            },
            "type": {
              "type": "string",
              "const": "file"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "file"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "json"
            },
            "value": true
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        }
      ]
    },
    "PersistedFilePart": {
      "type": "object",
      "properties": {
        "filename": {
          "type": [
            "string",
            "null"
          ]
        },
        "media_type": {
          "type": "string",
          "maxLength": 255,
          "minLength": 3,
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "metadata": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "source": {
          "$ref": "#/$defs/PersistedFileSource"
        }
      },
      "additionalProperties": false,
      "required": [
        "media_type",
        "filename",
        "source",
        "metadata"
      ]
    },
    "PersistedFileSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "byte_length": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "reference": {
              "$ref": "#/$defs/ArtifactReference"
            },
            "sha256": {
              "type": "string",
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "type": {
              "type": "string",
              "const": "artifact"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "byte_length",
            "sha256",
            "reference"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "url"
            },
            "url": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "description": "Control-free bounded presentation text.",
              "type": "string",
              "maxLength": 1024,
              "minLength": 1,
              "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
            },
            "provider_id": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
            },
            "type": {
              "type": "string",
              "const": "provider_reference"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "provider_id",
            "id"
          ]
        }
      ]
    },
    "PersistedToolContent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "json"
            },
            "value": true
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "mixed"
            },
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PersistedContentValue"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "values"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "denied"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "reason"
          ]
        }
      ]
    }
  }
}