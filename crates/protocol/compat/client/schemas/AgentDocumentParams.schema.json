{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An agent (or a template's `_<name>`) in a preset, or the shared ones.",
  "properties": {
    "id": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "preset": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id"
  ],
  "title": "AgentDocumentParams",
  "type": "object"
}
