{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cwd_identity": {
      "description": "Opaque canonical workspace identity.",
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^[^\\p{Cc}\\p{Cf}]+$",
      "type": [
        "string",
        "null"
      ]
    },
    "project": {
      "description": "Only the sessions of one project, or with `\"none\"` those in no\nproject (client protocol 1.8.0).",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "title": "SessionListParams",
  "type": "object"
}
