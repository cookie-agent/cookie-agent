{
  "$defs": {
    "RunSelection": {
      "properties": {
        "agent": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9]))*$",
          "type": "string"
        },
        "model": {
          "description": "One exact base or named-variant model selection.",
          "properties": {
            "model": {
              "maxLength": 512,
              "minLength": 3,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+(?:/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+)*$",
              "type": "string"
            },
            "variant": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^(?!base$)[a-z0-9][a-z0-9._-]{0,63}$",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "model",
            "variant"
          ],
          "type": "object"
        },
        "preset": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "agent",
        "model"
      ],
      "type": "object"
    },
    "RuntimeAttachment": {
      "description": "One runtime a session is attached to.",
      "properties": {
        "capability": {
          "description": "The capability of the runtime the session uses.",
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "type": "string"
        },
        "kind": {
          "description": "The capability's self-declared kind.",
          "pattern": "^[a-z][a-z0-9-]{0,15}$",
          "type": "string"
        },
        "name": {
          "description": "Session-unique attachment name; the tool prefix on collisions.",
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{0,39}$",
          "type": "string"
        },
        "runtime_id": {
          "description": "The runtime the capability instance belongs to.",
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "type": "string"
        },
        "workspace": {
          "description": "Canonical workspace path the runtime reported; absent without one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "runtime_id",
        "capability",
        "kind"
      ],
      "type": "object"
    },
    "SessionMeta": {
      "properties": {
        "agent_revision": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "attachments": {
          "description": "The session's runtime attachments now, in attach order: the fold of\nits `runtime_attached` and `runtime_detached` events (client protocol\n1.7.0). Empty from an older daemon, and for a session whose\nmetadata an older build wrote and that has recorded nothing since.",
          "items": {
            "$ref": "#/$defs/RuntimeAttachment"
          },
          "type": "array"
        },
        "catalog_revision": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "creation_selection": {
          "$ref": "#/$defs/RunSelection"
        },
        "cwd_identity": {
          "description": "Opaque canonical workspace identity.",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\p{Cc}\\p{Cf}]+$",
          "type": "string"
        },
        "last_activity": {
          "format": "date-time",
          "type": "string"
        },
        "last_agent_activity": {
          "description": "Latest user-initiated activity in the session: a user input submitted\nor admitted, or a `delegate_subagent` call started. Unlike\n`last_activity`, output and tool results never move it, so it orders\nsibling sessions without letting a busy one reorder itself.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "last_event_seq": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "manifest_revision": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "model_revision": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/SessionOrigin"
        },
        "provider_state_revision": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "recipe_registry_revision": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "runtime_revision": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "type": "string"
        },
        "short_id": {
          "description": "Short, tree-unique model-facing handle. Every session has one; it is\nnull only in a projection built without its creation event.",
          "type": [
            "string",
            "null"
          ]
        },
        "skipped_events": {
          "items": {
            "$ref": "#/$defs/SkippedEvent"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/SessionStatus"
        },
        "title": {
          "description": "Nonblank control-free UTF-8 session title.",
          "maxLength": 512,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "title_updated_seq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "session_id",
        "origin",
        "short_id",
        "cwd_identity",
        "creation_selection",
        "runtime_revision",
        "catalog_revision",
        "provider_state_revision",
        "model_revision",
        "agent_revision",
        "recipe_registry_revision",
        "manifest_revision",
        "title",
        "title_updated_seq",
        "last_event_seq",
        "last_activity",
        "status",
        "skipped_events"
      ],
      "type": "object"
    },
    "SessionOrigin": {
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "root",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "depth": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "invocation_id": {
              "format": "uuid",
              "type": "string"
            },
            "parent_run_id": {
              "format": "uuid",
              "type": "string"
            },
            "parent_session_id": {
              "format": "uuid",
              "type": "string"
            },
            "parent_tool_call_id": {
              "format": "uuid",
              "type": "string"
            },
            "root_session_id": {
              "format": "uuid",
              "type": "string"
            },
            "type": {
              "const": "delegated",
              "type": "string"
            }
          },
          "required": [
            "type",
            "root_session_id",
            "parent_session_id",
            "parent_run_id",
            "parent_tool_call_id",
            "invocation_id",
            "depth"
          ],
          "type": "object"
        }
      ]
    },
    "SessionStatus": {
      "oneOf": [
        {
          "enum": [
            "idle",
            "running",
            "completed",
            "failed",
            "cancelled",
            "interrupted"
          ],
          "type": "string"
        }
      ],
      "x-open": true
    },
    "SkippedEvent": {
      "properties": {
        "reason": {
          "type": "string"
        },
        "seq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "seq",
        "reason"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "runtimes": {
      "description": "The session's runtime attachments, in attach order.",
      "items": {
        "$ref": "#/$defs/RuntimeAttachment"
      },
      "type": "array"
    },
    "session": {
      "$ref": "#/$defs/SessionMeta"
    }
  },
  "required": [
    "session",
    "runtimes"
  ],
  "title": "SessionResumeResult",
  "type": "object"
}
