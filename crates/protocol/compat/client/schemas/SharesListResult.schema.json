{
  "$defs": {
    "AssetStore": {
      "description": "Where an asset is kept (section 4.1). A store's assets are listed,\nread, and changed together; an asset never moves between stores.",
      "oneOf": [
        {
          "description": "A session tree's own assets (scope `session`), named by the tree's\nroot. They are deleted with the tree.",
          "properties": {
            "session": {
              "format": "uuid",
              "type": "string"
            },
            "type": {
              "const": "session",
              "type": "string"
            }
          },
          "required": [
            "type",
            "session"
          ],
          "type": "object"
        },
        {
          "description": "A project's assets (scope `project`).",
          "properties": {
            "project": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
              "type": "string"
            },
            "type": {
              "const": "project",
              "type": "string"
            }
          },
          "required": [
            "type",
            "project"
          ],
          "type": "object"
        },
        {
          "description": "The assets of every session in no project (scope `project`).",
          "properties": {
            "type": {
              "const": "shared",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "SessionShare": {
      "description": "One conversation share: a link that lets whoever opens it use one root\nsession as a guest (client protocol 1.88.0).",
      "properties": {
        "can_send": {
          "description": "Whether its guests may act in the session. Off, they only watch.",
          "type": "boolean"
        },
        "connected": {
          "description": "How many guests are connected now.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "created": {
          "$ref": "#/$defs/ShareCreated"
        },
        "expires_at": {
          "description": "When the link stops working; never when absent.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "A share link's ID: 22 base64url characters.",
          "maxLength": 22,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]{22}$",
          "type": "string"
        },
        "label": {
          "description": "Who the link is for; the messages sent through it show it.",
          "type": "string"
        },
        "last_viewed": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "The guest page's path relative to the share base, `s/<id>`.",
          "type": "string"
        },
        "session_id": {
          "description": "The root session it opens.",
          "format": "uuid",
          "type": "string"
        },
        "title": {
          "description": "The session's title now, when it has one.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "The guest page's full URL, as [`Share::url`].",
          "type": [
            "string",
            "null"
          ]
        },
        "views": {
          "description": "How many guest connections it has had.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "path",
        "session_id",
        "label",
        "can_send",
        "created",
        "views",
        "connected"
      ],
      "type": "object"
    },
    "Share": {
      "description": "One share link (section 3).",
      "properties": {
        "asset": {
          "format": "uuid",
          "type": "string"
        },
        "byte_length": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "created": {
          "$ref": "#/$defs/ShareCreated"
        },
        "expires_at": {
          "description": "When the link stops working; never when absent.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "A share link's ID: 22 base64url characters.",
          "maxLength": 22,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]{22}$",
          "type": "string"
        },
        "last_viewed": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "media_type": {
          "description": "The asset's current type and size.",
          "type": "string"
        },
        "path": {
          "description": "The landing page's path relative to the share base, `s/<id>`.",
          "type": "string"
        },
        "store": {
          "$ref": "#/$defs/AssetStore",
          "description": "The asset it shows, always as the asset is now."
        },
        "title": {
          "description": "What the landing page is headed with; the asset's title when the\nlink was made, unless changed since.",
          "type": "string"
        },
        "url": {
          "description": "The landing page's full URL, when the daemon knows its share base\n(`[public] url` or `[server] page_url`). Absent, a client puts the\naddress it reached the daemon's page at before `path`.",
          "type": [
            "string",
            "null"
          ]
        },
        "views": {
          "description": "How many times the landing page was opened. Approximate: chat apps\nthat preview links open it too.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "path",
        "store",
        "asset",
        "title",
        "media_type",
        "byte_length",
        "created",
        "views"
      ],
      "type": "object"
    },
    "ShareCreated": {
      "description": "When a link was made, and by whom: the user when `session` is absent,\nelse an agent's call in that session.",
      "properties": {
        "agent": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9]))*$",
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "format": "date-time",
          "type": "string"
        },
        "session": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "at"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "enabled": {
      "description": "Whether the daemon serves links (`[share] enabled`).",
      "type": "boolean"
    },
    "sessions": {
      "description": "The conversation shares (client protocol 1.88.0).",
      "items": {
        "$ref": "#/$defs/SessionShare"
      },
      "type": "array"
    },
    "shares": {
      "items": {
        "$ref": "#/$defs/Share"
      },
      "type": "array"
    }
  },
  "required": [
    "shares",
    "enabled"
  ],
  "title": "SharesListResult",
  "type": "object"
}
