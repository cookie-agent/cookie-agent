{
  "$defs": {
    "BackgroundActor": {
      "description": "Who moved a call to the background.\n\nA value this build does not know reads as `model`.",
      "enum": [
        "user",
        "model"
      ],
      "type": "string",
      "x-open": true
    },
    "BackgroundCall": {
      "description": "One call running in the background.",
      "properties": {
        "agent_task": {
          "description": "An ACP agent's own command, still running after its call ended\n(client protocol 1.40.0): `job` is its terminal, and the agent runs\nit, so cookie cannot stop it.",
          "type": "boolean"
        },
        "by": {
          "$ref": "#/$defs/BackgroundActor"
        },
        "detached_at": {
          "format": "date-time",
          "type": "string"
        },
        "display": {
          "description": "The call's display argument.",
          "type": [
            "string",
            "null"
          ]
        },
        "job": {
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "type": "string"
        },
        "tool": {
          "description": "The tool's name as the model called it.",
          "type": "string"
        },
        "tool_call_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "job",
        "tool",
        "tool_call_id",
        "started_at",
        "detached_at",
        "by"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A session's background calls changed.",
  "properties": {
    "calls": {
      "description": "The session's background calls now.",
      "items": {
        "$ref": "#/$defs/BackgroundCall"
      },
      "type": "array"
    },
    "session_id": {
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "calls"
  ],
  "title": "BackgroundChangedNotification",
  "type": "object"
}
