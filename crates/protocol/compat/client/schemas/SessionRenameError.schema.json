{
  "$defs": {
    "SessionRenameErrorCode": {
      "enum": [
        "session_not_found",
        "invalid_title",
        "idempotency_conflict"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "client_rename_id": {
      "description": "Bounded title mutation idempotency key.",
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^\\p{Cc}\\p{Cf}]+$",
      "type": "string"
    },
    "code": {
      "$ref": "#/$defs/SessionRenameErrorCode"
    },
    "session_id": {
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "code",
    "session_id",
    "client_rename_id"
  ],
  "title": "SessionRenameError",
  "type": "object"
}
