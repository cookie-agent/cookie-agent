{
  "$defs": {
    "SignInAccountDescriptor": {
      "description": "The account a sign-in connected.",
      "properties": {
        "email": {
          "description": "Control-free bounded presentation text.",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\p{Cc}\\p{Cf}]+$",
          "type": [
            "string",
            "null"
          ]
        },
        "sign_in_required": {
          "default": false,
          "description": "The sign-in can no longer refresh; the user must sign in again.",
          "type": "boolean"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`provider.auth.completed`: a sign-in whose redirect the daemon caught\nitself has finished, successfully or not.",
  "properties": {
    "account": {
      "anyOf": [
        {
          "$ref": "#/$defs/SignInAccountDescriptor"
        },
        {
          "type": "null"
        }
      ],
      "description": "The signed-in account when it succeeded."
    },
    "error": {
      "description": "Why it failed, as `code: message`, when it did.",
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^[^\\p{Cc}\\p{Cf}]+$",
      "type": [
        "string",
        "null"
      ]
    },
    "provider_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "type": "string"
    }
  },
  "required": [
    "provider_id"
  ],
  "title": "ProviderAuthCompletedNotification",
  "type": "object"
}
