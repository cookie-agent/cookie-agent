{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`session.revert` was refused: the session's log moved past the\n`expected_last_seq` the client sent.",
  "properties": {
    "current_last_seq": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "session_id": {
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "current_last_seq"
  ],
  "title": "SessionRevertConflict",
  "type": "object"
}
