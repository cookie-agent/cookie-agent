{
  "$defs": {
    "ProviderDisconnectErrorCode": {
      "enum": [
        "custom_provider_not_store_backed",
        "runtime_revision_conflict",
        "provider_state_revision_conflict",
        "stale_provider_connection_generation",
        "provider_store_write_failed",
        "lock_contention",
        "runtime_compile_failed",
        "idempotency_conflict"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "client_request_id": {
      "description": "Bounded provider mutation idempotency key.",
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^\\p{Cc}\\p{Cf}]+$",
      "type": "string"
    },
    "code": {
      "$ref": "#/$defs/ProviderDisconnectErrorCode"
    },
    "provider_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "type": "string"
    }
  },
  "required": [
    "code",
    "provider_id",
    "client_request_id"
  ],
  "title": "ProviderDisconnectError",
  "type": "object"
}
