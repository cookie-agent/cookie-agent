{
  "$defs": {
    "OnboardingKitSource": {
      "description": "Where the starter kit comes from.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The release of the daemon's version, else the newest release of that\nversion in the release list (a nightly's), else the latest release.",
          "properties": {
            "type": {
              "const": "release",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A downloaded `cookie-agent-defaults.tar.gz`, sent whole.",
          "properties": {
            "data": {
              "description": "The archive's bytes in standard base64, at most\n[`MAX_ONBOARDING_ARCHIVE_BYTES`] decoded.",
              "maxLength": 1398104,
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "const": "archive",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        }
      ]
    },
    "OnboardingModelEntry": {
      "description": "One entry of a model field's fallback list (client protocol 1.69.0):\nexactly one of `model`, a model key, and `field`, another model field\nwhose models the entry stands for. `variant` absent means the model's\ndefault variant; beside `field`, it applies to each of that field's\nmodels that has no variant of its own and has a variant of that name\n(`docs/site/specs/model-fallback-lists.md`).",
      "properties": {
        "field": {
          "anyOf": [
            {
              "$ref": "#/$defs/OnboardingModelField"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "maxLength": 512,
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+(?:/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+)*$",
          "type": [
            "string",
            "null"
          ]
        },
        "variant": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9._-]+$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "OnboardingModelField": {
      "description": "One of the model fields, as an entry of another field names it (client\nprotocol 1.69.0). A value this build does not know reads as `unknown`;\n`onboarding.run` refuses it.",
      "enum": [
        "default_model",
        "small_model",
        "utility_model",
        "unknown"
      ],
      "type": "string",
      "x-open": true
    },
    "OnboardingModelInput": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+(?:/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+)*$",
          "type": "string"
        },
        {
          "$ref": "#/$defs/OnboardingModelTable"
        }
      ],
      "description": "A model value as `config.toml` takes it: a model key, or\n`{ model, variant }`."
    },
    "OnboardingModelTable": {
      "additionalProperties": false,
      "description": "The table form of [`OnboardingModelInput`].",
      "properties": {
        "model": {
          "maxLength": 512,
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+(?:/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+)*$",
          "type": "string"
        },
        "variant": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9._-]+$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "model"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`onboarding.run`: sets the model fields given and installs the kit when\nasked, as one change. Refused with `onboarding_incomplete`, writing\nnothing, when the daemon would not be set up afterwards.",
  "properties": {
    "default_model": {
      "anyOf": [
        {
          "$ref": "#/$defs/OnboardingModelInput"
        },
        {
          "type": "null"
        }
      ]
    },
    "default_model_list": {
      "description": "`default_model` as a fallback list, in order (client protocol\n1.69.0); refused beside `default_model`. A list of one is written as\nthe entry alone.",
      "items": {
        "$ref": "#/$defs/OnboardingModelEntry"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": [
        "array",
        "null"
      ]
    },
    "install_kit": {
      "type": "boolean"
    },
    "small_model": {
      "anyOf": [
        {
          "$ref": "#/$defs/OnboardingModelInput"
        },
        {
          "type": "null"
        }
      ]
    },
    "small_model_list": {
      "description": "`small_model` as a fallback list, like `default_model_list`.",
      "items": {
        "$ref": "#/$defs/OnboardingModelEntry"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": [
        "array",
        "null"
      ]
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/OnboardingKitSource"
        },
        {
          "type": "null"
        }
      ],
      "description": "`release` when absent; ignored without `install_kit`."
    },
    "utility_model": {
      "anyOf": [
        {
          "$ref": "#/$defs/OnboardingModelInput"
        },
        {
          "type": "null"
        }
      ],
      "description": "`utility_model` (client protocol 1.56.0)."
    },
    "utility_model_list": {
      "description": "`utility_model` as a fallback list, like `default_model_list`.",
      "items": {
        "$ref": "#/$defs/OnboardingModelEntry"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": [
        "array",
        "null"
      ]
    }
  },
  "required": [
    "install_kit"
  ],
  "title": "OnboardingRunParams",
  "type": "object"
}
