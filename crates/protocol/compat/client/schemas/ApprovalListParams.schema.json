{
  "$defs": {
    "ApprovalStatus": {
      "description": "A value this build does not know reads as `cancelled`: a cancelled approval,\nwhich takes no answer.",
      "enum": [
        "pending",
        "escalated",
        "approved",
        "rejected",
        "expired",
        "cancelled"
      ],
      "type": "string",
      "x-open": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "root_session_id": {
      "format": "uuid",
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalStatus"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "root_session_id"
  ],
  "title": "ApprovalListParams",
  "type": "object"
}
