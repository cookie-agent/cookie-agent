{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Answers an attachment waiting for the user: `allow` attaches it, else it\nfails as denied.",
  "properties": {
    "allow": {
      "type": "boolean"
    },
    "content_index": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "model_turn_seq": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "ordinal": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "session_id": {
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "model_turn_seq",
    "content_index",
    "ordinal",
    "allow"
  ],
  "title": "AttachmentDecideParams",
  "type": "object"
}
