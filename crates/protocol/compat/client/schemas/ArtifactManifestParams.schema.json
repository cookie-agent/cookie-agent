{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`artifact.manifest`: the files of a folder artifact in the store of\n`session_id`'s tree.",
  "properties": {
    "session_id": {
      "format": "uuid",
      "type": "string"
    },
    "sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "sha256"
  ],
  "title": "ArtifactManifestParams",
  "type": "object"
}
