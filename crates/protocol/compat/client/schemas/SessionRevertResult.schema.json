{
  "$defs": {
    "HeldReason": {
      "description": "Why a session's automatic runs stopped (`docs/site/specs/held-sessions.md`).",
      "oneOf": [
        {
          "description": "The user stopped the session's run.",
          "properties": {
            "type": {
              "const": "stopped",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Its runs failed `failures` times in a row, past `[model_retry]\nstandard_retries`; `error` is the last run's.",
          "properties": {
            "error": {
              "description": "Control-free bounded safe error text.",
              "maxLength": 4096,
              "minLength": 1,
              "pattern": "^[^\\p{Cc}\\p{Cf}]+$",
              "type": [
                "string",
                "null"
              ]
            },
            "failures": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "failing",
              "type": "string"
            }
          },
          "required": [
            "type",
            "failures"
          ],
          "type": "object"
        }
      ],
      "x-open": true
    },
    "RunSelection": {
      "properties": {
        "agent": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9]))*$",
          "type": "string"
        },
        "model": {
          "description": "One exact base or named-variant model selection.",
          "properties": {
            "model": {
              "maxLength": 512,
              "minLength": 3,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+(?:/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+)*$",
              "type": "string"
            },
            "variant": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^(?!base$)[a-z0-9][a-z0-9._-]{0,63}$",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "model",
            "variant"
          ],
          "type": "object"
        },
        "preset": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "agent",
        "model"
      ],
      "type": "object"
    },
    "RuntimeAttachment": {
      "description": "One runtime a session is attached to.",
      "properties": {
        "capability": {
          "description": "The capability of the runtime the session uses.",
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "type": "string"
        },
        "kind": {
          "description": "The capability's self-declared kind.",
          "pattern": "^[a-z][a-z0-9-]{0,15}$",
          "type": "string"
        },
        "name": {
          "description": "Session-unique attachment name; the tool prefix on collisions.",
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{0,39}$",
          "type": "string"
        },
        "runtime_id": {
          "description": "The runtime the capability instance belongs to.",
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "type": "string"
        },
        "workspace": {
          "description": "Canonical workspace path the runtime reported; absent without one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "runtime_id",
        "capability",
        "kind"
      ],
      "type": "object"
    },
    "SessionCron": {
      "description": "The job a new-session job's run session was started by\n(`SessionMeta::cron`).",
      "properties": {
        "fired_at": {
          "format": "date-time",
          "type": "string"
        },
        "job_id": {
          "description": "A cron job's ID: eight lowercase ASCII letters and digits.",
          "maxLength": 8,
          "minLength": 1,
          "pattern": "^[a-z0-9]{8}$",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "fired_at"
      ],
      "type": "object"
    },
    "SessionMeta": {
      "properties": {
        "agent_revision": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "attachments": {
          "description": "The session's runtime attachments now, in attach order: the fold of\nits `runtime_attached` and `runtime_detached` events (client protocol\n1.7.0). Empty from an older daemon, and for a session whose\nmetadata an older build wrote and that has recorded nothing since.",
          "items": {
            "$ref": "#/$defs/RuntimeAttachment"
          },
          "type": "array"
        },
        "catalog_revision": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "creation_selection": {
          "$ref": "#/$defs/RunSelection"
        },
        "cron": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionCron"
            },
            {
              "type": "null"
            }
          ],
          "description": "The cron job whose fire created the session, and when it fired\n(client protocol 1.15.0). Absent for every other session and from\nan older daemon."
        },
        "cwd_identity": {
          "description": "Opaque canonical workspace identity.",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\p{Cc}\\p{Cf}]+$",
          "type": "string"
        },
        "delegated_attachments": {
          "description": "For a root session, the attachments its subagents brought that its\nown did not record yet, in the order they brought them: the fold of\nits `delegated_attachments_added` events (client protocol 1.10.0).\nIt only grows. Clients build a root's badges from `attachments`\nfollowed by these. Empty for a delegated session, from an older\ndaemon, and for a session whose metadata an older build wrote and\nthat has recorded nothing since.",
          "items": {
            "$ref": "#/$defs/RuntimeAttachment"
          },
          "type": "array"
        },
        "held": {
          "anyOf": [
            {
              "$ref": "#/$defs/HeldReason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why the session's automatic runs are held, while they are\n(`docs/site/specs/held-sessions.md`, client protocol 1.34.0): the\nlatest `automatic_runs_held` with no `automatic_runs_resumed` or\nsubmitted user input after it. Absent when not held and from an\nolder daemon."
        },
        "last_activity": {
          "format": "date-time",
          "type": "string"
        },
        "last_agent_activity": {
          "description": "Latest user-initiated activity in the session: a user input submitted\nor admitted, or a `delegate_subagent` call started. Unlike\n`last_activity`, output and tool results never move it, so it orders\nsibling sessions without letting a busy one reorder itself.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "last_event_seq": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "manifest_revision": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "model_revision": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/SessionOrigin"
        },
        "project": {
          "description": "The project the session belongs to: for a root session the fold of\nits `session_project_set` events, for a delegated one its root's\n(client protocol 1.8.0). Absent outside a project, from an older\ndaemon, and when the project no longer exists.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "type": [
            "string",
            "null"
          ]
        },
        "provider_state_revision": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "recipe_registry_revision": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "runtime_revision": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "type": "string"
        },
        "short_id": {
          "description": "Short, tree-unique model-facing handle. Every session has one; it is\nnull only in a projection built without its creation event.",
          "type": [
            "string",
            "null"
          ]
        },
        "skipped_events": {
          "items": {
            "$ref": "#/$defs/SkippedEvent"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/SessionStatus"
        },
        "title": {
          "description": "Nonblank control-free UTF-8 session title.",
          "maxLength": 512,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "title_updated_seq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "unread": {
          "description": "Whether the root session has a finished turn, an approval, or a\nquestion the user has not seen\n(`docs/site/specs/unread-sessions.md`, client protocol 1.51.0): it\nbecame unread while nobody was present on its tree, and nobody has\nbeen since. Never set on a delegated session; false from an older\ndaemon.",
          "type": "boolean"
        },
        "waiting_on": {
          "description": "What will start the session's next run without the user, in this\norder and each once (client protocol 1.9.0): an active goal, folded\nfrom the log, and the daemon's live background calls, subagent\nturns, and external producer registrations. Reported whatever\n`status` says; a client shows a running session as running. Empty\nwhen nothing will wake the session, from an older daemon, and for a\nsession whose metadata an older build wrote and that has recorded\nnothing since.",
          "items": {
            "$ref": "#/$defs/WaitingOn"
          },
          "type": "array"
        }
      },
      "required": [
        "session_id",
        "origin",
        "short_id",
        "cwd_identity",
        "creation_selection",
        "runtime_revision",
        "catalog_revision",
        "provider_state_revision",
        "model_revision",
        "agent_revision",
        "recipe_registry_revision",
        "manifest_revision",
        "title",
        "title_updated_seq",
        "last_event_seq",
        "last_activity",
        "status",
        "skipped_events"
      ],
      "type": "object"
    },
    "SessionOrigin": {
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "root",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "depth": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "invocation_id": {
              "format": "uuid",
              "type": "string"
            },
            "parent_run_id": {
              "format": "uuid",
              "type": "string"
            },
            "parent_session_id": {
              "format": "uuid",
              "type": "string"
            },
            "parent_tool_call_id": {
              "format": "uuid",
              "type": "string"
            },
            "root_session_id": {
              "format": "uuid",
              "type": "string"
            },
            "type": {
              "const": "delegated",
              "type": "string"
            }
          },
          "required": [
            "type",
            "root_session_id",
            "parent_session_id",
            "parent_run_id",
            "parent_tool_call_id",
            "invocation_id",
            "depth"
          ],
          "type": "object"
        }
      ]
    },
    "SessionStatus": {
      "oneOf": [
        {
          "enum": [
            "idle",
            "running",
            "completed",
            "failed",
            "cancelled",
            "interrupted"
          ],
          "type": "string"
        }
      ],
      "x-open": true
    },
    "SkippedEvent": {
      "properties": {
        "reason": {
          "type": "string"
        },
        "seq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "seq",
        "reason"
      ],
      "type": "object"
    },
    "WaitingOn": {
      "description": "A producer that will start a session's next run without the user\n(client protocol 1.9.0): what `SessionMeta::waiting_on` lists. A\nvalue this build does not know reads as `Unknown`, still something\nthe session waits on.",
      "oneOf": [
        {
          "const": "goal",
          "description": "The root session's goal is active: goal mode keeps scheduling\nruns until the goal is paused, completed, or cancelled.",
          "type": "string"
        },
        {
          "const": "background_call",
          "description": "A background call of the session is running; its\n`<background_result>` starts a run.",
          "type": "string"
        },
        {
          "const": "subagent",
          "description": "A direct child is running a turn on its own, or a background\ndelegation is queued or running; its `<subagent_report>` starts a\nrun.",
          "type": "string"
        },
        {
          "const": "external_producer",
          "description": "A plugin or runtime holds a live producer registration for the\nsession and may send to it.",
          "type": "string"
        },
        {
          "const": "scheduled_job",
          "description": "An enabled cron job with a next fire time targets the session\n(client protocol 1.15.0); its fire starts a run.",
          "type": "string"
        }
      ],
      "x-open": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "instructions_override": {
      "type": [
        "string",
        "null"
      ]
    },
    "session": {
      "$ref": "#/$defs/SessionMeta"
    }
  },
  "required": [
    "session"
  ],
  "title": "SessionRevertResult",
  "type": "object"
}
