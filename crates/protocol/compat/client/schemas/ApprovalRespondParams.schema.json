{
  "$defs": {
    "ApprovalFeedback": {
      "properties": {
        "message": {
          "description": "Control-free bounded safe error text.",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\p{Cc}\\p{Cf}]+$",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "type": "object"
    },
    "ApprovalUserDecision": {
      "description": "A value this build does not know reads as `cancel`.",
      "enum": [
        "approve_once",
        "approve_tree",
        "reject",
        "cancel"
      ],
      "type": "string",
      "x-open": true
    },
    "OperationFingerprint": {
      "properties": {
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "digest"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_option": {
      "description": "The option of the request's `agent_options` the user chose (client\nprotocol 1.68.0): its kind must agree with `decision`, approving\nwith `approve_once` and rejecting with `reject`. Without it, an ACP\nagent gets its allow-once or reject-once option.",
      "maxLength": 1024,
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "approval_id": {
      "format": "uuid",
      "type": "string"
    },
    "client_response_id": {
      "description": "Bounded approval response idempotency key.",
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^\\p{Cc}\\p{Cf}]+$",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/ApprovalUserDecision"
    },
    "feedback": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalFeedback"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation_fingerprint": {
      "$ref": "#/$defs/OperationFingerprint"
    },
    "request_revision": {
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "session_id": {
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "approval_id",
    "request_revision",
    "operation_fingerprint",
    "client_response_id",
    "decision"
  ],
  "title": "ApprovalRespondParams",
  "type": "object"
}
