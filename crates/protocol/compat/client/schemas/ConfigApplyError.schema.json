{
  "$defs": {
    "ConfigApplyErrorCode": {
      "oneOf": [
        {
          "const": "conflict",
          "description": "The configuration changed since it was read: refetch and merge.",
          "type": "string"
        },
        {
          "const": "invalid_configuration",
          "description": "The result is not a valid configuration.",
          "type": "string"
        },
        {
          "const": "invalid_change",
          "description": "A change cannot be made as asked, such as a path that is not a\ndocument.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Why a `config.apply` changed nothing.",
  "properties": {
    "code": {
      "$ref": "#/$defs/ConfigApplyErrorCode"
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "message"
  ],
  "title": "ConfigApplyError",
  "type": "object"
}
