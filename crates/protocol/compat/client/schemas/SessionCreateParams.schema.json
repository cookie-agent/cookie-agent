{
  "$defs": {
    "PermissionEffect": {
      "enum": [
        "allow",
        "ask",
        "deny"
      ],
      "type": "string"
    },
    "PermissionMode": {
      "enum": [
        "auto_approve",
        "auto_approve_n",
        "auto_approve_y",
        "ask",
        "yolo"
      ],
      "type": "string"
    },
    "PermissionRule": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "description": "Permission action a tool declares, such as `read`, `bash`, or a runtime's own action.",
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "type": "string"
        },
        "effect": {
          "$ref": "#/$defs/PermissionEffect"
        },
        "resource": {
          "description": "Current wildcard grammar: '*' matches any characters, '?' matches one character, and the exact '${workspace_dir}' expression is allowed; controls, globstar, escapes, classes, and every other brace form are forbidden. Runtime deserialization additionally enforces a maximum of 4096 UTF-8 bytes; x-cookie-agent-maxUtf8Bytes records that byte limit because JSON Schema maxLength counts Unicode code points.",
          "minLength": 1,
          "pattern": "^(?:\\$\\{workspace_dir\\}|[^\\u0000-\\u001f\\u007f-\\u009f\\\\\\[\\]\\{\\}])+$",
          "type": "string",
          "x-cookie-agent-maxUtf8Bytes": 4096
        },
        "runtime": {
          "description": "Runtime selector (`bash@labpc`): the rule applies only to tools of\nruntimes with this runtime ID. Absent, it applies everywhere,\nincluding the base layer.",
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "action",
        "resource",
        "effect"
      ],
      "type": "object"
    },
    "RunSelection": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9]))*$",
          "type": "string"
        },
        "model": {
          "additionalProperties": false,
          "description": "One exact base or named-variant model selection.",
          "properties": {
            "model": {
              "maxLength": 512,
              "minLength": 3,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+(?:/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+)*$",
              "type": "string"
            },
            "variant": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^(?!base$)[a-z0-9][a-z0-9._-]{0,63}$",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "model",
            "variant"
          ],
          "type": "object"
        },
        "preset": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "agent",
        "model"
      ],
      "type": "object"
    },
    "RuntimeAttachRequest": {
      "additionalProperties": false,
      "description": "One runtime a session attaches.",
      "properties": {
        "capability": {
          "description": "The capability to attach; the runtime's only capability when\nomitted.",
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_id": {
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "type": "string"
        },
        "workspace": {
          "description": "Required exactly when the capability takes a workspace.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "runtime_id"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cwd": {
      "description": "The client's directory, as the client names it: the session's\n`cwd_identity`, and the workspace of `local`'s `coding` capability\nwhen `runtimes` is omitted. The daemon's own directory when omitted.",
      "type": [
        "string",
        "null"
      ]
    },
    "global": {
      "description": "Whether the session attaches the global runtime; `true` when omitted.",
      "type": "boolean"
    },
    "permission_mode": {
      "anyOf": [
        {
          "$ref": "#/$defs/PermissionMode"
        },
        {
          "type": "null"
        }
      ],
      "description": "The new tree's permission mode; the default mode when omitted."
    },
    "permission_rules": {
      "description": "The session's initial permission overlay, committed with its\ncreation; empty when omitted.",
      "items": {
        "$ref": "#/$defs/PermissionRule"
      },
      "maxItems": 256,
      "type": "array"
    },
    "runtimes": {
      "description": "The runtimes the session attaches besides `global`, in order. When\nomitted, the session attaches `local`'s `coding` capability at `cwd`,\nor at the daemon's working directory. Instances that are not running are started first; a\nfailure creates no session.",
      "items": {
        "$ref": "#/$defs/RuntimeAttachRequest"
      },
      "maxItems": 256,
      "type": [
        "array",
        "null"
      ]
    },
    "selection": {
      "$ref": "#/$defs/RunSelection"
    }
  },
  "required": [
    "selection"
  ],
  "title": "SessionCreateParams",
  "type": "object"
}
