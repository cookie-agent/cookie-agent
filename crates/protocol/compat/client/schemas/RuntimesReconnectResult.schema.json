{
  "$defs": {
    "RuntimeInstanceInfo": {
      "properties": {
        "attachment_name": {
          "description": "The name the instance reports; absent until it has started.",
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{0,39}$",
          "type": [
            "string",
            "null"
          ]
        },
        "capability": {
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "type": "string"
        },
        "kind": {
          "description": "The kind the instance reports; absent until it has started.",
          "pattern": "^[a-z][a-z0-9-]{0,15}$",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "Why the instance failed, when it did.",
          "type": [
            "string",
            "null"
          ]
        },
        "platform": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_id": {
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RuntimeInstanceStatus"
        },
        "workspace": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "runtime_id",
        "capability",
        "status"
      ],
      "type": "object"
    },
    "RuntimeInstanceStatus": {
      "oneOf": [
        {
          "enum": [
            "starting",
            "ready",
            "reconnecting",
            "failed",
            "stopped"
          ],
          "type": "string"
        }
      ],
      "x-open": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "instance": {
      "$ref": "#/$defs/RuntimeInstanceInfo",
      "description": "The instance afterwards."
    }
  },
  "required": [
    "instance"
  ],
  "title": "RuntimesReconnectResult",
  "type": "object"
}
