{
  "$defs": {
    "RunStartConflictCode": {
      "oneOf": [
        {
          "enum": [
            "idempotency_conflict"
          ],
          "type": "string"
        },
        {
          "const": "session_running",
          "description": "Another run is active; `session.submit_input` steers or queues\ninstead.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "client_run_id": {
      "description": "Bounded run idempotency key.",
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^\\p{Cc}\\p{Cf}]+$",
      "type": "string"
    },
    "code": {
      "$ref": "#/$defs/RunStartConflictCode"
    },
    "session_id": {
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "code",
    "session_id",
    "client_run_id"
  ],
  "title": "RunStartConflict",
  "type": "object"
}
