{
  "$defs": {
    "McpConfigSource": {
      "description": "A value this build does not know reads as `runtime`: a server the user file\ndoes not define, which `mcp.server.*` cannot edit. `machine` (client\nprotocol 1.12.0) is a server the hosting runtime's own machine defines (a\ndial-in runtime's `[runtimes.local.mcp]`), which the daemon does not read:\nits `definition` is empty.",
      "enum": [
        "user_file",
        "machine",
        "runtime"
      ],
      "type": "string",
      "x-open": true
    },
    "McpOAuthDefinition": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/McpOAuthSettingsDefinition"
        }
      ]
    },
    "McpOAuthSettingsDefinition": {
      "properties": {
        "client_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "client_metadata_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "client_secret": {
          "type": [
            "string",
            "null"
          ]
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "McpServerDefinition": {
      "properties": {
        "args": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "oauth": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpOAuthDefinition"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "command",
        "args",
        "env",
        "cwd",
        "url",
        "headers",
        "enabled",
        "timeout_ms"
      ],
      "type": "object"
    },
    "McpServerInfo": {
      "properties": {
        "auth_in_progress": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "definition": {
          "$ref": "#/$defs/McpServerDefinition"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "runtime_id": {
          "description": "The runtime hosting the server; `global` for top-level `[mcp]`\nservers, the only ones `mcp.server.*` mutations edit.",
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpServerScope"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where a runtime other than `global` hosts the server (client protocol\n1.13.0): `runtime`, one process the runtime shares across its\nworkspaces, listed without a workspace; or `workspace`, one per\ninstance, listed with the instance's workspace, and once without one\n(`disconnected`, \"starts when a workspace opens\") while no instance of\na connected runtime hosts it. Absent for `global`'s servers and from\nruntimes that do not say."
        },
        "source": {
          "$ref": "#/$defs/McpConfigSource"
        },
        "state": {
          "$ref": "#/$defs/McpServerState"
        },
        "tool_count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "workspace": {
          "description": "The hosting instance's canonical workspace, when its runtime has one;\nit tells instances of one runtime apart.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "runtime_id",
        "name",
        "source",
        "definition",
        "state",
        "tool_count",
        "message"
      ],
      "type": "object"
    },
    "McpServerScope": {
      "description": "Where a runtime hosts an MCP server (runtime protocol 1.5.0; client\nprotocol 1.13.0). Open: a value this build does not know reads as\n`workspace`.",
      "oneOf": [
        {
          "const": "runtime",
          "description": "One process per runtime, started when the runtime initializes and\nshared by every workspace instance; its tools are the runtime's own,\noutside any instance.",
          "type": "string"
        },
        {
          "const": "workspace",
          "description": "One process per workspace instance, started when the instance\nopens.",
          "type": "string"
        }
      ],
      "x-open": true
    },
    "McpServerState": {
      "oneOf": [
        {
          "enum": [
            "connected",
            "connecting",
            "failed",
            "needs_auth",
            "disabled",
            "disconnected"
          ],
          "type": "string"
        },
        {
          "const": "reconnecting",
          "description": "The connection dropped and is being re-established. The server's\ntools stay published; calls fail with `runtime_unavailable`.",
          "type": "string"
        }
      ],
      "x-open": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "server": {
      "anyOf": [
        {
          "$ref": "#/$defs/McpServerInfo"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "server"
  ],
  "title": "McpServerMutationResult",
  "type": "object"
}
