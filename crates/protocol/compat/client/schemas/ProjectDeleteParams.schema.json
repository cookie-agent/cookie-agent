{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Delete a project: every session tree in it, its whole memory folder, its\n`AGENTS.md`, and its defaults. Refused while a session of the project\nruns.",
  "properties": {
    "project": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "type": "string"
    },
    "revision": {
      "description": "[`ProjectInfo::revision`] as last read.",
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "project",
    "revision"
  ],
  "title": "ProjectDeleteParams",
  "type": "object"
}
