{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The address the browser landed on, carried back to the daemon. Only the\nsingle-use authorization code crosses the connection.",
  "properties": {
    "callback_url": {
      "type": "string"
    },
    "provider_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "type": "string"
    }
  },
  "required": [
    "provider_id",
    "callback_url"
  ],
  "title": "ProviderAuthCompleteParams",
  "type": "object"
}
