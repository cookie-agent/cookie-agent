{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "focus": {
      "description": "Control-free bounded presentation text.",
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^[^\\p{Cc}\\p{Cf}]+$",
      "type": [
        "string",
        "null"
      ]
    },
    "session_id": {
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "focus"
  ],
  "title": "SessionCompactParams",
  "type": "object"
}
