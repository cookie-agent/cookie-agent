{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "client_request_id": {
      "description": "Bounded provider mutation idempotency key.",
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^\\p{Cc}\\p{Cf}]+$",
      "type": "string"
    },
    "expected_connection_generation": {
      "description": "Monotonic provider connection generation.",
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "expected_revision": {
      "description": "The revision of the catalog view the provider was read from.",
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "provider_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "type": "string"
    }
  },
  "required": [
    "provider_id",
    "expected_revision",
    "expected_connection_generation",
    "client_request_id"
  ],
  "title": "ProviderDisconnectParams",
  "type": "object"
}
