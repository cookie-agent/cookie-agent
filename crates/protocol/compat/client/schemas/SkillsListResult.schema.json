{
  "$defs": {
    "PermissionEffect": {
      "description": "A value this build does not know reads as `ask`: asking, the effect that\nnever runs a call unapproved.",
      "enum": [
        "allow",
        "deny",
        "ask"
      ],
      "type": "string",
      "x-open": true
    },
    "SkillDescriptor": {
      "properties": {
        "argument_hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "permission_effect": {
          "$ref": "#/$defs/PermissionEffect"
        },
        "precedence_winner": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/SkillSource"
        },
        "user_invocable": {
          "type": "boolean"
        },
        "version": {
          "description": "An official skill's version (client protocol 1.22.0).",
          "type": [
            "string",
            "null"
          ]
        },
        "visible": {
          "type": "boolean"
        },
        "when_to_use": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "description",
        "when_to_use",
        "location",
        "source",
        "precedence_winner",
        "permission_effect",
        "visible",
        "user_invocable",
        "argument_hint"
      ],
      "type": "object"
    },
    "SkillSource": {
      "description": "Where a skill comes from: `project`, `official` (an official skill the\ndaemon keeps up to date, since client protocol 1.22.0), or `user`. A\nvalue this build does not know reads as `user`.",
      "enum": [
        "project",
        "official",
        "user"
      ],
      "type": "string",
      "x-open": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "skills": {
      "items": {
        "$ref": "#/$defs/SkillDescriptor"
      },
      "type": "array"
    }
  },
  "required": [
    "skills"
  ],
  "title": "SkillsListResult",
  "type": "object"
}
