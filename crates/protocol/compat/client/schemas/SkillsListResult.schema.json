{
  "$defs": {
    "PermissionEffect": {
      "enum": [
        "allow",
        "ask",
        "deny"
      ],
      "type": "string"
    },
    "SkillDescriptor": {
      "additionalProperties": false,
      "properties": {
        "argument_hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "permission_effect": {
          "$ref": "#/$defs/PermissionEffect"
        },
        "precedence_winner": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/SkillSource"
        },
        "user_invocable": {
          "type": "boolean"
        },
        "visible": {
          "type": "boolean"
        },
        "when_to_use": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "description",
        "when_to_use",
        "location",
        "source",
        "precedence_winner",
        "permission_effect",
        "visible",
        "user_invocable",
        "argument_hint"
      ],
      "type": "object"
    },
    "SkillSource": {
      "enum": [
        "user",
        "project"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "skills": {
      "items": {
        "$ref": "#/$defs/SkillDescriptor"
      },
      "type": "array"
    }
  },
  "required": [
    "skills"
  ],
  "title": "SkillsListResult",
  "type": "object"
}
