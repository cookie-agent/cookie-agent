      "description": "`{}` when omitted.",
      "maxLength": 1048576,
      "type": [
        "string",
        "null"
      ]
    },
    "content_type": {
      "description": "`application/json` when omitted.",
      "maxLength": 256,
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "headers": {
