      "type": "array"
    },
    "id": {
      "description": "A webhook's ID: eight lowercase ASCII letters and digits.",
      "maxLength": 8,
      "minLength": 1,
      "pattern": "^[a-z0-9]{8}$",
      "type": "string"
    }
  },
  "required": [
    "id"
  ],
  "title": "WebhookTestParams",
  "type": "object"
}
