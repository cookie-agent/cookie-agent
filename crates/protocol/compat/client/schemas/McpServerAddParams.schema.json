{
  "$defs": {
    "McpOAuthDefinition": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/McpOAuthSettingsDefinition"
        }
      ]
    },
    "McpOAuthSettingsDefinition": {
      "properties": {
        "client_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "client_metadata_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "client_secret": {
          "type": [
            "string",
            "null"
          ]
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "McpServerDefinition": {
      "properties": {
        "always_load": {
          "description": "On a model that loads deferred tools, every tool of the server is\nsent up front (client protocol 1.47.0).",
          "type": "boolean"
        },
        "always_load_tools": {
          "description": "Patterns over the server's own tool names (`*`, `?`): matching tools\nare sent up front (client protocol 1.47.0). No pattern may be empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "args": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "exclude_tools": {
          "description": "Patterns over the server's own tool names, applied after\n`include_tools`: matching tools are not published (client protocol\n1.16.0).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "include_tools": {
          "description": "Patterns over the server's own tool names (`*`, `?`): only matching\ntools are published (client protocol 1.16.0). Absent publishes every\ntool; present, it may not be empty.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "instructions": {
          "description": "Whether the server's `initialize` instructions are its summary in\ndeferred tool announcements (client protocol 1.47.0); absent reads\nas `true`.",
          "type": "boolean"
        },
        "oauth": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpOAuthDefinition"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpServerScope"
            },
            {
              "type": "null"
            }
          ],
          "description": "How many copies a runtime other than `global` runs (client protocol\n1.37.0): one per workspace when absent. `global`'s servers take\nnone."
        },
        "timeout_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "command",
        "args",
        "env",
        "cwd",
        "url",
        "headers",
        "enabled",
        "timeout_ms"
      ],
      "type": "object"
    },
    "McpServerScope": {
      "description": "Where a runtime hosts an MCP server (runtime protocol 1.5.0; client\nprotocol 1.13.0). Open: a value this build does not know reads as\n`workspace`.",
      "oneOf": [
        {
          "const": "runtime",
          "description": "One process per runtime, started when the runtime initializes and\nshared by every workspace instance; its tools are the runtime's own,\noutside any instance.",
          "type": "string"
        },
        {
          "const": "workspace",
          "description": "One process per workspace instance, started when the instance\nopens.",
          "type": "string"
        }
      ],
      "x-open": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "definition": {
      "$ref": "#/$defs/McpServerDefinition"
    },
    "name": {
      "type": "string"
    },
    "runtime_id": {
      "description": "The runtime whose `[runtimes.<id>]` table holds the server (client\nprotocol 1.37.0); `global`'s top-level `[mcp]` servers when absent.",
      "maxLength": 32,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]{0,31}$",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "name",
    "definition"
  ],
  "title": "McpServerAddParams",
  "type": "object"
}
