{
  "$defs": {
    "ApprovalRespondErrorCode": {
      "enum": [
        "approval_not_found",
        "approval_not_pending",
        "approval_revision_conflict",
        "decision_not_allowed",
        "operation_fingerprint_mismatch",
        "operation_changed",
        "idempotency_conflict"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "format": "uuid",
      "type": "string"
    },
    "client_response_id": {
      "description": "Bounded approval response idempotency key.",
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^\\p{Cc}\\p{Cf}]+$",
      "type": "string"
    },
    "code": {
      "$ref": "#/$defs/ApprovalRespondErrorCode"
    },
    "expected_revision": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "found_revision": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "session_id": {
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "code",
    "session_id",
    "approval_id",
    "client_response_id"
  ],
  "title": "ApprovalRespondError",
  "type": "object"
}
