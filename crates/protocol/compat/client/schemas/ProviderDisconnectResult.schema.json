{
  "$defs": {
    "AcpConfigOption": {
      "description": "One config option an ACP agent offers in a session, such as its model,\nmode, or reasoning effort. An agent that offers modes but no mode option\nis shown as an option `mode` of category `mode`.",
      "properties": {
        "category": {
          "description": "The agent's label for what the option is, such as `model`, `mode`,\nor `thought_level`.",
          "type": [
            "string",
            "null"
          ]
        },
        "current_value": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AcpConfigOptionKind",
          "description": "The option's control: a select (the default, left out) or a boolean\n(client protocol 1.23.0)."
        },
        "name": {
          "type": "string"
        },
        "values": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AcpConfigValue"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "current_value"
      ],
      "type": "object"
    },
    "AcpConfigOptionKind": {
      "description": "The control an [`AcpConfigOption`] is (client protocol 1.23.0). An\nunknown kind reads as a select, whose `values` a client lists.",
      "oneOf": [
        {
          "const": "select",
          "description": "One of `values`.",
          "type": "string"
        },
        {
          "const": "boolean",
          "description": "On or off: `current_value` is `true` or `false`, and `values`\nlists both (`true`, named On, and `false`, named Off), so a\nclient that reads every option as a select can still set it.",
          "type": "string"
        }
      ],
      "x-open": true
    },
    "AcpConfigValue": {
      "description": "One value an [`AcpConfigOption`] can take.",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "name"
      ],
      "type": "object"
    },
    "AgentDescriptor": {
      "properties": {
        "delegation_targets": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9]))*$",
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "description": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^(?=.*\\S)[^\\p{Cc}\\p{Cf}]+$",
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9]))*$",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/AgentMode"
        },
        "official": {
          "description": "An official agent the daemon keeps up to date, not one the user\nwrote (client protocol 1.56.0).",
          "type": "boolean"
        },
        "official_version": {
          "description": "An official agent's version (client protocol 1.56.0).",
          "maxLength": 64,
          "type": [
            "string",
            "null"
          ]
        },
        "preset": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": [
            "string",
            "null"
          ]
        },
        "resolved_fallback": {
          "items": {
            "description": "One exact base or named-variant model selection.",
            "properties": {
              "model": {
                "maxLength": 512,
                "minLength": 3,
                "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+(?:/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+)*$",
                "type": "string"
              },
              "variant": {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^(?!base$)[a-z0-9][a-z0-9._-]{0,63}$",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "model",
              "variant"
            ],
            "type": "object"
          },
          "maxItems": 256,
          "type": "array"
        },
        "runnable_as_root": {
          "type": "boolean"
        },
        "runtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentRuntime"
            },
            {
              "type": "null"
            }
          ],
          "description": "For an ACP agent exactly one runtime offers (client protocol\n1.17.0): that runtime. Absent for the daemon's own agents and for an\nACP agent several runtimes offer; [`Self::runtimes`] lists them all."
        },
        "runtimes": {
          "description": "For an ACP agent (client protocol 1.21.0): every runtime that offers\nit, by runtime ID. A session runs it on the one of its attached\nruntimes that offers it, and cannot run it with none or with two.\nEmpty for the daemon's own agents.",
          "items": {
            "$ref": "#/$defs/AgentRuntime"
          },
          "maxItems": 256,
          "type": "array"
        },
        "unset_models": {
          "description": "The configuration fields (`default_model`, `small_model`,\n`utility_model`) the agent's `models` entries name but that are not\nset, sorted (client protocol 1.22.0). Those entries are skipped; an\nagent with no other entry is unavailable until a field is set.",
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "type": "array"
        }
      },
      "required": [
        "id",
        "description",
        "mode",
        "enabled",
        "runnable_as_root",
        "resolved_fallback",
        "delegation_targets"
      ],
      "type": "object"
    },
    "AgentMode": {
      "description": "A value this build does not know reads as `internal`: an internal agent,\nwhich is neither runnable as a root nor a delegation target.",
      "enum": [
        "primary",
        "subagent",
        "all",
        "internal"
      ],
      "type": "string",
      "x-open": true
    },
    "AgentRuntime": {
      "description": "A runtime that offers an ACP agent (`docs/site/specs/acp-agents.md`\nsection 3).",
      "properties": {
        "agent": {
          "description": "The agent's ID on the runtime, the key of its declaration: the\nagent's own ID, or since client protocol 1.32.0 the declaration its\ndocument names (`acp.agent`), which several agents may share.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9]))*$",
          "type": "string"
        },
        "available": {
          "description": "Whether a session that attaches the runtime can use it now: the\nruntime is connected, or the daemon starts it on demand, and the\ndeclaration is enabled.",
          "type": "boolean"
        },
        "input_media": {
          "description": "The files the agent takes in a prompt (client protocol 1.26.0):\nimages, audio, and text, as its last start on this runtime\nadvertised them. Empty until the agent has started there.",
          "items": {
            "$ref": "#/$defs/InputMedia"
          },
          "maxItems": 8,
          "type": "array"
        },
        "options": {
          "description": "The config options a new ACP session of the agent on this runtime\nstarts with, as the daemon last saw them, with the agent document's\n`acp.mode` and `acp.config` applied (client protocol 1.26.0). Empty\nuntil the agent has started a session there. A draft offers these\nbefore its session exists and sends its choices as\n`session.create`'s `agent_options`.",
          "items": {
            "$ref": "#/$defs/AcpConfigOption"
          },
          "maxItems": 256,
          "type": "array"
        },
        "runtime_id": {
          "description": "The runtime that offers the agent.",
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "type": "string"
        }
      },
      "required": [
        "runtime_id",
        "agent",
        "available"
      ],
      "type": "object"
    },
    "AuthCredentialDescriptor": {
      "properties": {
        "credential_type": {
          "$ref": "#/$defs/CredentialFieldType"
        },
        "display_name": {
          "description": "Control-free bounded presentation text.",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\p{Cc}\\p{Cf}]+$",
          "type": "string"
        },
        "help": {
          "description": "Control-free bounded presentation text.",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\p{Cc}\\p{Cf}]+$",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{0,127}$",
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "display_name",
        "help",
        "required",
        "credential_type"
      ],
      "type": "object"
    },
    "AuthMethodDescriptor": {
      "properties": {
        "credentials": {
          "items": {
            "$ref": "#/$defs/AuthCredentialDescriptor"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        },
        "display_name": {
          "description": "Control-free bounded presentation text.",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\p{Cc}\\p{Cf}]+$",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "display_name",
        "credentials"
      ],
      "type": "object"
    },
    "AvailableModelDescriptor": {
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/ModelCapabilities"
        },
        "default_variant": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?!base$)[a-z0-9][a-z0-9._-]{0,63}$",
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^(?=.*\\S)[^\\p{Cc}\\p{Cf}]+$",
          "type": "string"
        },
        "input_media": {
          "description": "What the model accepts in user input, by kind, with the effective\nlimits (`docs/site/specs/compatibility-v1.md` section 11.2). A kind\nabsent here is not accepted; a reader keeps kinds it does not know\nand never offers them.",
          "items": {
            "$ref": "#/$defs/InputMedia"
          },
          "maxItems": 16,
          "type": "array"
        },
        "key": {
          "maxLength": 512,
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+(?:/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+)*$",
          "type": "string"
        },
        "variant_order": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^(?!base$)[a-z0-9][a-z0-9._-]{0,63}$",
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "variants": {
          "items": {
            "$ref": "#/$defs/AvailableVariantDescriptor"
          },
          "maxItems": 256,
          "type": "array"
        }
      },
      "required": [
        "key",
        "display_name",
        "capabilities",
        "input_media",
        "variants",
        "variant_order",
        "default_variant"
      ],
      "type": "object"
    },
    "AvailableVariantDescriptor": {
      "properties": {
        "display_name": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^(?=.*\\S)[^\\p{Cc}\\p{Cf}]+$",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?!base$)[a-z0-9][a-z0-9._-]{0,63}$",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/VariantOrigin"
        }
      },
      "required": [
        "id",
        "display_name",
        "origin"
      ],
      "type": "object"
    },
    "CancellationCapability": {
      "description": "A value this build does not know reads as `local_only`.",
      "enum": [
        "provider",
        "local_only"
      ],
      "type": "string",
      "x-open": true
    },
    "CatalogAge": {
      "description": "Age of the selected validated catalog body; age never makes it unusable.\n\nA value this build does not know reads as `older_than_thirty_days`.",
      "enum": [
        "current",
        "older_than_seven_days",
        "older_than_thirty_days"
      ],
      "type": "string",
      "x-open": true
    },
    "CatalogSafeErrorMeta": {
      "properties": {
        "code": {
          "description": "Stable lowercase machine-readable code.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "type": "string"
        },
        "message": {
          "description": "Control-free bounded safe error text.",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\p{Cc}\\p{Cf}]+$",
          "type": "string"
        },
        "time": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "time"
      ],
      "type": "object"
    },
    "CatalogSource": {
      "description": "A value this build does not know reads as `cache`.",
      "enum": [
        "network",
        "bootstrap",
        "cache"
      ],
      "type": "string",
      "x-open": true
    },
    "CatalogStatus": {
      "description": "Where the daemon's model catalog stands: its source, its age, the records\nit quarantined, and its last refresh error.",
      "properties": {
        "age": {
          "$ref": "#/$defs/CatalogAge"
        },
        "last_error": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalogSafeErrorMeta"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_quarantine_count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "provider_quarantine_count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/CatalogSource"
        },
        "stale": {
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "stale",
        "age",
        "provider_quarantine_count",
        "model_quarantine_count",
        "last_error"
      ],
      "type": "object"
    },
    "CredentialFieldType": {
      "description": "A value this build does not know reads as `api_key`: a secret like an API\nkey.",
      "enum": [
        "access_token",
        "access_key_id",
        "secret_access_key",
        "session_token",
        "api_key"
      ],
      "type": "string",
      "x-open": true
    },
    "DurableConnectionDescriptor": {
      "properties": {
        "auth_method": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "type": "string"
        },
        "connected_at": {
          "format": "date-time",
          "type": "string"
        },
        "connection_generation": {
          "description": "Monotonic provider connection generation.",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "credential_fields": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]{0,127}$",
            "type": "string"
          },
          "maxItems": 32,
          "type": "array"
        },
        "provider_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "type": "string"
        },
        "setup_values": {
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,127}$": {
              "$ref": "#/$defs/SafeSetupValue"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "provider_id",
        "setup_values",
        "auth_method",
        "credential_fields",
        "connection_generation",
        "connected_at"
      ],
      "type": "object"
    },
    "DurableProviderReceipt": {
      "properties": {
        "committed_at": {
          "format": "date-time",
          "type": "string"
        },
        "receipt_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "committed_at"
      ],
      "type": "object"
    },
    "EffectiveAuthState": {
      "description": "A value this build does not know reads as `unavailable`.",
      "enum": [
        "authored_api_key",
        "authored_override",
        "provider_store",
        "no_auth",
        "unavailable"
      ],
      "type": "string",
      "x-open": true
    },
    "InputMedia": {
      "description": "What one model accepts of one media kind in user input. The limits are\neffective: the lowest of the model's capability, its provider's delivery\nlimits, and the attachment caps.",
      "properties": {
        "kind": {
          "description": "A media kind, such as `image`.",
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "type": "string"
        },
        "max_bytes": {
          "description": "The largest accepted file.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_count": {
          "description": "The most parts of this kind one input carries.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "max_dimension": {
          "description": "The longest accepted side of an image or video, in pixels.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_pixels": {
          "description": "The most pixels an accepted image or video frame has.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "mime_types": {
          "description": "The media types accepted, such as `image/png`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "mime_types",
        "max_bytes",
        "max_count"
      ],
      "type": "object"
    },
    "MediaCapability": {
      "properties": {
        "max_bytes": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "max_count": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "mime_types": {
          "items": {
            "maxLength": 255,
            "minLength": 3,
            "pattern": "^[^/\\s]+/[^/\\s]+$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "mime_types",
        "max_bytes",
        "max_count"
      ],
      "type": "object"
    },
    "Modality": {
      "description": "A model's input or output modality. A reader of a model's capabilities\ndrops a modality it does not know.",
      "enum": [
        "text",
        "image",
        "audio",
        "pdf",
        "video"
      ],
      "type": "string",
      "x-open": true
    },
    "ModelCapabilities": {
      "properties": {
        "cancellation": {
          "$ref": "#/$defs/CancellationCapability"
        },
        "context_tokens": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "input": {
          "items": {
            "$ref": "#/$defs/Modality"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "media": {
          "additionalProperties": {
            "$ref": "#/$defs/MediaCapability"
          },
          "description": "Per media kind. A reader drops a kind it does not know.",
          "properties": {
            "audio": {
              "$ref": "#/$defs/MediaCapability"
            },
            "image": {
              "$ref": "#/$defs/MediaCapability"
            },
            "pdf": {
              "$ref": "#/$defs/MediaCapability"
            },
            "video": {
              "$ref": "#/$defs/MediaCapability"
            }
          },
          "type": "object"
        },
        "native_replay": {
          "$ref": "#/$defs/ReplayCapability"
        },
        "output": {
          "items": {
            "$ref": "#/$defs/Modality"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "output_tokens": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "parallel_tool_calls": {
          "type": "boolean"
        },
        "reasoning": {
          "type": "boolean"
        },
        "seed": {
          "type": "boolean"
        },
        "structured_output": {
          "type": "boolean"
        },
        "temperature": {
          "type": "boolean"
        },
        "tool_calling": {
          "type": "boolean"
        },
        "top_p": {
          "type": "boolean"
        }
      },
      "required": [
        "input",
        "output",
        "context_tokens",
        "output_tokens",
        "tool_calling",
        "parallel_tool_calls",
        "structured_output",
        "reasoning",
        "temperature",
        "top_p",
        "seed",
        "native_replay",
        "cancellation",
        "media"
      ],
      "type": "object"
    },
    "ModelCatalogView": {
      "description": "What a client sees of the daemon's providers, models, and agents. It\ncarries only client-facing descriptors: no frozen model bindings, recipe\nidentities, compiler versions, or internal revisions, which change\nwithout anything a client shows changing.",
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/$defs/AgentDescriptor"
          },
          "maxItems": 4096,
          "type": "array"
        },
        "catalog": {
          "$ref": "#/$defs/CatalogStatus"
        },
        "default_agent": {
          "description": "`[agents] default`: the agent a new root session starts with when\nneither the client nor its project chooses one (client protocol\n1.56.0). A client preselects it; an older daemon sends none, and its\ndefault is `primary`.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9]))*$",
          "type": [
            "string",
            "null"
          ]
        },
        "models": {
          "items": {
            "$ref": "#/$defs/AvailableModelDescriptor"
          },
          "maxItems": 4096,
          "type": "array"
        },
        "providers": {
          "items": {
            "$ref": "#/$defs/ProviderDescriptor"
          },
          "maxItems": 4096,
          "type": "array"
        },
        "revision": {
