{
  "$defs": {
    "SkillRule": {
      "description": "One rule over skills.",
      "properties": {
        "from_project": {
          "description": "Copied from the session's project's defaults when the session was\ncreated, and not changed since.",
          "type": "boolean"
        },
        "skill": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9_*?-]+$",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/SkillState"
        }
      },
      "required": [
        "skill",
        "state"
      ],
      "type": "object"
    },
    "SkillState": {
      "description": "A skill's state.",
      "enum": [
        "on",
        "off"
      ],
      "type": "string"
    },
    "ToolExposure": {
      "description": "One layer's rules: an agent document's, a project's defaults, or a\nsession's.",
      "properties": {
        "skills": {
          "items": {
            "$ref": "#/$defs/SkillRule"
          },
          "maxItems": 256,
          "type": "array"
        },
        "tool_groups": {
          "items": {
            "$ref": "#/$defs/ToolGroupRule"
          },
          "maxItems": 256,
          "type": "array"
        }
      },
      "type": "object"
    },
    "ToolGroupRule": {
      "description": "One rule over tool groups.",
      "properties": {
        "from_project": {
          "description": "Copied from the session's project's defaults when the session was\ncreated, and not changed since.",
          "type": "boolean"
        },
        "selector": {
          "maxLength": 168,
          "minLength": 1,
          "pattern": "^(?:mcp:|plugin:)?[^@\\s\\u0000-\\u001f\\u007f-\\u009f]+(?:@[a-z][a-z0-9_]{0,31})?$",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ToolGroupState"
        }
      },
      "required": [
        "selector",
        "state"
      ],
      "type": "object"
    },
    "ToolGroupState": {
      "description": "A tool group's state.",
      "oneOf": [
        {
          "const": "on",
          "description": "Offered, sent up front.",
          "type": "string"
        },
        {
          "const": "deferred",
          "description": "Offered deferred, loaded with `tool_search`; `on` on a model that\ndoes not defer and for an ACP agent.",
          "type": "string"
        },
        {
          "const": "off",
          "description": "Not offered.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "exposure": {
      "$ref": "#/$defs/ToolExposure",
      "description": "The session's choices afterwards, whole: exact selectors only."
    },
    "session_id": {
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "exposure"
  ],
  "title": "SessionToolsSetParams",
  "type": "object"
}
