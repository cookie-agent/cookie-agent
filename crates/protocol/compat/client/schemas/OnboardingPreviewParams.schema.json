{
  "$defs": {
    "OnboardingKitSource": {
      "description": "Where the starter kit comes from.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The release of the daemon's version, else the latest release.",
          "properties": {
            "type": {
              "const": "release",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A downloaded `cookie-agent-defaults.tar.gz`, sent whole.",
          "properties": {
            "data": {
              "description": "The archive's bytes in standard base64, at most\n[`MAX_ONBOARDING_ARCHIVE_BYTES`] decoded.",
              "maxLength": 1398104,
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "const": "archive",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`onboarding.preview`: downloads and checks the kit, writes nothing.",
  "properties": {
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/OnboardingKitSource"
        },
        {
          "type": "null"
        }
      ],
      "description": "`release` when absent."
    }
  },
  "title": "OnboardingPreviewParams",
  "type": "object"
}
