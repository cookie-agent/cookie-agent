{
  "$defs": {
    "ForwardShare": {
      "description": "A public link to a web forward (client protocol 1.110.0): whoever opens\nit reaches the forward's app at the link's root, until the link or the\nforward ends.",
      "properties": {
        "created": {
          "$ref": "#/$defs/ShareCreated"
        },
        "expires_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "forward": {
          "description": "The forward's handle.",
          "type": "string"
        },
        "id": {
          "description": "A share link's ID: 22 base64url characters.",
          "maxLength": 22,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]{22}$",
          "type": "string"
        },
        "last_viewed": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "The app's path relative to the share base, `s/<id>/`.",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "views": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "path",
        "forward",
        "title",
        "created",
        "views"
      ],
      "type": "object"
    },
    "ShareCreated": {
      "description": "When a link was made, and by whom: the user when `session` is absent,\nelse an agent's call in that session.",
      "properties": {
        "agent": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9]))*$",
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "format": "date-time",
          "type": "string"
        },
        "session": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "at"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "created": {
      "description": "Whether the link is new; false when `reuse` returned one.",
      "type": "boolean"
    },
    "share": {
      "$ref": "#/$defs/ForwardShare"
    }
  },
  "required": [
    "share",
    "created"
  ],
  "title": "ForwardShareResult",
  "type": "object"
}
