{
  "$defs": {
    "ArtifactRef": {
      "description": "A content-addressed artifact in a session tree's store: a user upload, a\ntool attachment, or the full content of a truncated display block.",
      "properties": {
        "byte_length": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "filename": {
          "description": "The name the file was attached under, without a directory.",
          "maxLength": 255,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "media_type": {
          "description": "The media type sniffed from the content, such as `image/png`.",
          "maxLength": 255,
          "minLength": 3,
          "type": "string"
        },
        "sha256": {
          "description": "Lowercase hex SHA-256 of the bytes.",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "byte_length",
        "media_type"
      ],
      "type": "object"
    },
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "uri"
      ],
      "type": "object"
    },
    "DiffAsOf": {
      "description": "Whether a diff shows what a call will do (`prepare`) or what it did\n(`execute`); the two differ when the file changed in between.",
      "enum": [
        "prepare",
        "execute"
      ],
      "type": "string"
    },
    "DiffBlock": {
      "description": "A change to one file, with real file line numbers.",
      "properties": {
        "added": {
          "description": "Lines added by the whole change, omitted hunks included.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "as_of": {
          "$ref": "#/$defs/DiffAsOf"
        },
        "change": {
          "$ref": "#/$defs/DiffChange"
        },
        "full": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "hunks": {
          "description": "Empty when the change has no line diff, such as a binary or very\nlarge file; `added` and `removed` still count its lines.",
          "items": {
            "$ref": "#/$defs/DiffHunk"
          },
          "type": "array"
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "old_path": {
          "description": "The path before a rename.",
          "type": [
            "string",
            "null"
          ]
        },
        "omitted": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiffOmitted"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        },
        "removed": {
          "description": "Lines removed by the whole change, omitted hunks included.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "change",
        "hunks",
        "added",
        "removed",
        "as_of"
      ],
      "type": "object"
    },
    "DiffChange": {
      "description": "How a file changed. An unknown change reads as `modified`.",
      "oneOf": [
        {
          "enum": [
            "created",
            "modified",
            "deleted",
            "renamed"
          ],
          "type": "string"
        }
      ],
      "x-open": true
    },
    "DiffHunk": {
      "description": "A run of changed lines and their context. `old_lines` counts its\n`context` and `remove` lines, `new_lines` its `context` and `add` lines.",
      "properties": {
        "lines": {
          "items": {
            "$ref": "#/$defs/DiffLine"
          },
          "type": "array"
        },
        "new_lines": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "new_start": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "old_lines": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "old_start": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "old_start",
        "old_lines",
        "new_start",
        "new_lines",
        "lines"
      ],
      "type": "object"
    },
    "DiffLine": {
      "properties": {
        "op": {
          "$ref": "#/$defs/DiffLineOp"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "text"
      ],
      "type": "object"
    },
    "DiffLineOp": {
      "enum": [
        "context",
        "add",
        "remove"
      ],
      "type": "string"
    },
    "DiffOmitted": {
      "properties": {
        "hunks": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "lines": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "hunks",
        "lines"
      ],
      "type": "object"
    },
    "DisplayBlock": {
      "description": "One typed unit of tool presentation.\n\nText fields allow `\\n` and `\\t` as their only control characters;\n`terminal` segment text also allows SGR colour sequences. Every line\nnumber is a 1-based file line number. `full` is present only on a\ntruncated block and names its complete content; the `omitted_*` members\ncount the whole units a cut left out.",
      "oneOf": [
        {
          "properties": {
            "omitted_lines": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "text": {
              "type": "string"
            },
            "type": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "description": "CommonMark.",
          "properties": {
            "omitted_lines": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "text": {
              "type": "string"
            },
            "type": {
              "const": "markdown",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "properties": {
            "language": {
              "type": [
                "string",
                "null"
              ]
            },
            "omitted_lines": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "start_line": {
              "format": "uint64",
              "minimum": 1,
              "type": [
                "integer",
                "null"
              ]
            },
            "text": {
              "type": "string"
            },
            "type": {
              "const": "code",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "description": "Consecutive lines of a file.",
          "properties": {
            "full": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ArtifactRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "language": {
              "type": [
                "string",
                "null"
              ]
            },
            "lines": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "omitted_lines": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "path": {
              "type": "string"
            },
            "start_line": {
              "format": "uint64",
              "minimum": 1,
              "type": "integer"
            },
            "total_lines": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "type": {
              "const": "file_excerpt",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path",
            "start_line",
            "lines"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/DiffBlock",
          "properties": {
            "type": {
              "const": "diff",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Output of a process.",
          "properties": {
            "exit_code": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "full": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ArtifactRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "omitted_lines": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "segments": {
              "items": {
                "$ref": "#/$defs/TerminalSegment"
              },
              "type": "array"
            },
            "type": {
              "const": "terminal",
              "type": "string"
            }
          },
          "required": [
            "type",
            "segments"
          ],
          "type": "object"
        },
        {
          "properties": {
            "entries": {
              "items": {
                "$ref": "#/$defs/KeyValueEntry"
              },
              "type": "array"
            },
            "omitted_entries": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "type": {
              "const": "key_value",
              "type": "string"
            }
          },
          "required": [
            "type",
            "entries"
          ],
          "type": "object"
        },
        {
          "description": "Every row has one cell per column.",
          "properties": {
            "columns": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "omitted_rows": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "rows": {
              "items": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "type": "array"
            },
            "type": {
              "const": "table",
              "type": "string"
            }
          },
          "required": [
            "type",
            "columns",
            "rows"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "json",
              "type": "string"
            },
            "value": true
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "alt": {
              "type": [
                "string",
                "null"
              ]
            },
            "artifact": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "type": {
              "const": "media",
              "type": "string"
            }
          },
          "required": [
            "type",
            "artifact"
          ],
          "type": "object"
        },
        {
          "properties": {
            "label": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "link",
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ],
          "type": "object"
        },
        {
          "properties": {
            "label": {
              "type": [
                "string",
                "null"
              ]
            },
            "session_id": {
              "format": "uuid",
              "type": "string"
            },
            "short_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "session_ref",
              "type": "string"
            }
          },
          "required": [
            "type",
            "session_id"
          ],
          "type": "object"
        }
      ],
      "x-open": true
    },
    "ExecuteOutcome": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "failed": {
              "type": "boolean"
            },
            "output": {
              "$ref": "#/$defs/ToolCompletionOutput"
            },
            "result": {
              "$ref": "#/$defs/PersistedToolResult"
            },
            "status": {
              "const": "completed",
              "type": "string"
            }
          },
          "required": [
            "status",
            "output",
            "result",
            "failed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "error": {
              "$ref": "#/$defs/WireToolError"
            },
            "status": {
              "const": "failed",
              "type": "string"
            }
          },
          "required": [
            "status",
            "error"
          ],
          "type": "object"
        }
      ]
    },
    "InlineMedia": {
      "additionalProperties": false,
      "description": "Attachment bytes, content-addressed.",
      "properties": {
        "data": {
          "description": "Standard base64 of the bytes.",
          "type": "string"
        },
        "sha256": {
          "description": "Lowercase hex SHA-256 of the bytes.",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "data"
      ],
      "type": "object"
    },
    "KeyValueEntry": {
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object"
    },
    "PersistedToolResult": {
      "additionalProperties": false,
      "description": "A tool result as sessions store it and clients receive it. `display` is\nwhat clients show, a list of display blocks sharing one 64 KiB budget;\nempty means nothing to show. When it is a single `text` block whose text\noccurs verbatim in `output`, which is the common case (a single-output\ntool shows its output, a shell its only stream), it is written as the byte\nrange `display_span` into `output` instead of a second copy.",
      "properties": {
        "additional_messages": {
          "description": "Emitted model-history messages. Their files share the 256-file limit with attachments.",
          "items": {
            "$ref": "#/$defs/ToolEmittedMessage"
          },
          "maxItems": 4,
          "type": "array"
        },
        "attachments": {
          "description": "Direct result files. Together with files in additional_messages, at most 256 are allowed.",
          "items": {
            "$ref": "#/$defs/ToolAttachment"
          },
          "maxItems": 256,
          "type": "array"
        },
        "display": {
          "items": {
            "$ref": "#/$defs/DisplayBlock"
          },
          "type": "array"
        },
        "display_span": {
          "description": "Byte range [start, end) of `output` that is the text of the display's only block, a `text` block. Present instead of `display` when that text occurs verbatim in `output`.",
          "items": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "metadata": true,
        "output": {
          "type": "string"
        },
        "retained_output": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetainedToolOutput"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "description": "Control-free bounded presentation text.",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\p{Cc}\\p{Cf}]+$",
          "type": "string"
        }
      },
      "required": [
        "title",
        "output",
        "metadata",
        "attachments"
      ],
      "type": "object"
    },
    "RetainedToolOutput": {
      "additionalProperties": false,
      "properties": {
        "incomplete": {
          "type": "boolean"
        },
        "reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactReference"
            },
            {
              "type": "null"
            }
          ],
          "description": "The one stream's artifact, or the named-stream manifest. Absent when\nevery stream fit inline."
        },
        "streams": {
          "items": {
            "$ref": "#/$defs/RetainedToolStream"
          },
          "type": "array"
        }
      },
      "required": [
        "streams",
        "incomplete"
      ],
      "type": "object"
    },
    "RetainedToolStream": {
      "additionalProperties": false,
      "properties": {
        "byte_length": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "dropped_bytes": {
          "description": "Bytes past the capture limit that the artifact does not hold: it keeps\nthe stream's head up to the limit and its last stretch, with a marker\nline between them.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "line_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_offset": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactReference"
            },
            {
              "type": "null"
            }
          ],
          "description": "The stream's full content. Absent, with `sha256`, when the stream fit\nits preview and the result output already holds all of it."
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "byte_length",
        "line_count",
        "truncated"
      ],
      "type": "object"
    },
    "TerminalSegment": {
      "properties": {
        "stream": {
          "$ref": "#/$defs/TerminalStream"
        },
        "text": {
          "description": "May contain SGR colour sequences.",
          "type": "string"
        }
      },
      "required": [
        "stream",
        "text"
      ],
      "type": "object"
    },
    "TerminalStream": {
      "description": "The stream a terminal segment came from. An unknown stream reads as\n`stdout`.",
      "oneOf": [
        {
          "enum": [
            "stdout",
            "stderr"
          ],
          "type": "string"
        }
      ],
      "x-open": true
    },
    "ToolAttachment": {
      "additionalProperties": false,
      "properties": {
        "byte_length": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "filename": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime_type": {
          "maxLength": 255,
          "minLength": 3,
          "pattern": "^[^/\\s]+/[^/\\s]+$",
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "mime_type",
        "filename",
        "byte_length",
        "sha256",
        "reference"
      ],
      "type": "object"
    },
    "ToolCompletionOutput": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "single",
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "named",
              "type": "string"
            },
            "streams": {
              "items": {
                "$ref": "#/$defs/ToolOutputChunk"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "streams"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "streamed",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "ToolEmittedContent": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "file": {
              "$ref": "#/$defs/ToolAttachment"
            }
          },
          "required": [
            "file"
          ],
          "type": "object"
        }
      ]
    },
    "ToolEmittedMessage": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "items": {
            "$ref": "#/$defs/ToolEmittedContent"
          },
          "minItems": 1,
          "type": "array"
        },
        "role": {
          "$ref": "#/$defs/ToolEmittedMessageRole"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "type": "object"
    },
    "ToolEmittedMessageRole": {
      "enum": [
        "system",
        "user"
      ],
      "type": "string"
    },
    "ToolErrorKind": {
      "enum": [
        "progress_sink_closed",
        "failed",
        "operation_changed",
        "unsupported_security",
        "unsupported_platform",
        "resource_limit",
        "invalid_url",
        "permission_denied",
        "redirect_error",
        "timeout",
        "transport_error",
        "unsupported_content_type",
        "runtime_unavailable"
      ],
      "type": "string"
    },
    "ToolOutputChunk": {
      "additionalProperties": false,
      "properties": {
        "stream": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "WireToolError": {
      "additionalProperties": false,
      "description": "A runtime API `ToolError` on the wire.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ToolErrorKind"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "media": {
      "default": [],
      "description": "Bytes of the attachments the result references, for the daemon to\nretain. At most [`MAX_INLINE_MEDIA_BYTES`] in all.",
      "items": {
        "$ref": "#/$defs/InlineMedia"
      },
      "type": "array"
    },
    "outcome": {
