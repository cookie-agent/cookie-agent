{
  "$defs": {
    "ArtifactRef": {
      "description": "A content-addressed artifact in a session tree's store: a user upload, a\ntool attachment, or the full content of a truncated display block.",
      "properties": {
        "byte_length": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "filename": {
          "description": "The name the file was attached under, without a directory.",
          "maxLength": 255,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "media_type": {
          "description": "The media type sniffed from the content, such as `image/png`.",
          "maxLength": 255,
          "minLength": 3,
          "type": "string"
        },
        "sha256": {
          "description": "Lowercase hex SHA-256 of the bytes.",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "byte_length",
        "media_type"
      ],
      "type": "object"
    },
    "DiffAsOf": {
      "description": "Whether a diff shows what a call will do (`prepare`) or what it did\n(`execute`); the two differ when the file changed in between.",
      "enum": [
        "prepare",
        "execute"
      ],
      "type": "string"
    },
    "DiffBlock": {
      "description": "A change to one file, with real file line numbers.",
      "properties": {
        "added": {
          "description": "Lines added by the whole change, omitted hunks included.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "as_of": {
          "$ref": "#/$defs/DiffAsOf"
        },
        "change": {
          "$ref": "#/$defs/DiffChange"
        },
        "full": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "hunks": {
          "description": "Empty when the change has no line diff, such as a binary or very\nlarge file; `added` and `removed` still count its lines.",
          "items": {
            "$ref": "#/$defs/DiffHunk"
          },
          "type": "array"
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "old_path": {
          "description": "The path before a rename.",
          "type": [
            "string",
            "null"
          ]
        },
        "omitted": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiffOmitted"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        },
        "removed": {
          "description": "Lines removed by the whole change, omitted hunks included.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "change",
        "hunks",
        "added",
        "removed",
        "as_of"
      ],
      "type": "object"
    },
    "DiffChange": {
      "description": "How a file changed. An unknown change reads as `modified`.",
      "oneOf": [
        {
          "enum": [
            "created",
            "modified",
            "deleted",
            "renamed"
          ],
          "type": "string"
        }
      ],
      "x-open": true
    },
    "DiffHunk": {
      "description": "A run of changed lines and their context. `old_lines` counts its\n`context` and `remove` lines, `new_lines` its `context` and `add` lines.",
      "properties": {
        "lines": {
          "items": {
            "$ref": "#/$defs/DiffLine"
          },
          "type": "array"
        },
        "new_lines": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "new_start": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "old_lines": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "old_start": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "old_start",
        "old_lines",
        "new_start",
        "new_lines",
        "lines"
      ],
      "type": "object"
    },
    "DiffLine": {
      "properties": {
        "op": {
          "$ref": "#/$defs/DiffLineOp"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "text"
      ],
      "type": "object"
    },
    "DiffLineOp": {
      "enum": [
        "context",
        "add",
        "remove"
      ],
      "type": "string"
    },
    "DiffOmitted": {
      "properties": {
        "hunks": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "lines": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "hunks",
        "lines"
      ],
      "type": "object"
    },
    "DisplayBlock": {
      "description": "One typed unit of tool presentation.\n\nText fields allow `\\n` and `\\t` as their only control characters;\n`terminal` segment text also allows SGR colour sequences. Every line\nnumber is a 1-based file line number. `full` is present only on a\ntruncated block and names its complete content; the `omitted_*` members\ncount the whole units a cut left out.",
      "oneOf": [
        {
          "properties": {
            "omitted_lines": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "text": {
              "type": "string"
            },
            "type": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "description": "CommonMark.",
          "properties": {
            "omitted_lines": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "text": {
              "type": "string"
            },
            "type": {
              "const": "markdown",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "properties": {
            "language": {
              "type": [
                "string",
                "null"
              ]
            },
            "omitted_lines": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "start_line": {
              "format": "uint64",
              "minimum": 1,
              "type": [
                "integer",
                "null"
              ]
            },
            "text": {
              "type": "string"
            },
            "type": {
              "const": "code",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "description": "Consecutive lines of a file.",
          "properties": {
            "full": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ArtifactRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "language": {
              "type": [
                "string",
                "null"
              ]
            },
            "lines": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "omitted_lines": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "path": {
              "type": "string"
            },
            "start_line": {
              "format": "uint64",
              "minimum": 1,
              "type": "integer"
            },
            "total_lines": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "type": {
              "const": "file_excerpt",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path",
            "start_line",
            "lines"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/DiffBlock",
          "properties": {
            "type": {
              "const": "diff",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Output of a process.",
          "properties": {
            "exit_code": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "full": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ArtifactRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "omitted_lines": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "segments": {
              "items": {
                "$ref": "#/$defs/TerminalSegment"
              },
              "type": "array"
            },
            "type": {
              "const": "terminal",
              "type": "string"
            }
          },
          "required": [
            "type",
            "segments"
          ],
          "type": "object"
        },
        {
          "properties": {
            "entries": {
              "items": {
                "$ref": "#/$defs/KeyValueEntry"
              },
              "type": "array"
            },
            "omitted_entries": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "type": {
              "const": "key_value",
              "type": "string"
            }
          },
          "required": [
            "type",
            "entries"
          ],
          "type": "object"
        },
        {
          "description": "Every row has one cell per column.",
          "properties": {
            "columns": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "omitted_rows": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "rows": {
              "items": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "type": "array"
            },
            "type": {
              "const": "table",
              "type": "string"
            }
          },
          "required": [
            "type",
            "columns",
            "rows"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "json",
              "type": "string"
            },
            "value": true
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "alt": {
              "type": [
                "string",
                "null"
              ]
            },
            "artifact": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "type": {
              "const": "media",
              "type": "string"
            }
          },
          "required": [
            "type",
            "artifact"
          ],
          "type": "object"
        },
        {
          "properties": {
            "label": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "link",
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ],
          "type": "object"
        },
        {
          "properties": {
            "label": {
              "type": [
                "string",
                "null"
              ]
            },
            "session_id": {
              "format": "uuid",
              "type": "string"
            },
            "short_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "session_ref",
              "type": "string"
            }
          },
          "required": [
            "type",
            "session_id"
          ],
          "type": "object"
        }
      ],
      "x-open": true
    },
    "KeyValueEntry": {
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object"
    },
    "PrepareOutcome": {
      "oneOf": [
        {
          "$ref": "#/$defs/PreparedCall",
          "properties": {
            "status": {
              "const": "prepared",
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
        {
          "properties": {
            "error": {
              "$ref": "#/$defs/WireToolError"
            },
            "presentation": {
              "$ref": "#/$defs/PreparedPresentation",
              "description": "How clients show the call that failed to prepare."
            },
            "status": {
              "const": "failed",
              "type": "string"
            }
          },
          "required": [
            "status",
            "error",
            "presentation"
          ],
          "type": "object"
        }
      ]
    },
    "PreparedCall": {
      "description": "A prepared call. The runtime keeps its executor under `prepared_id`\nuntil it is executed or released.\n\nThe daemon builds the call's approval identity from `permission`,\n`permission_resource`, and `normalized_arguments` together with the tool\nit knows the call goes to; a runtime never states it.",
      "properties": {
        "normalized_arguments": {
          "description": "The arguments as the call will run them, such as a path made\nrelative to the workspace or defaults filled in. Not `null`."
        },
        "permission": {
          "description": "The permission action the call is checked under; absent for a tool\nthat needs no permission. It must be the one the tool declares.",
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "type": [
            "string",
            "null"
          ]
        },
        "permission_resource": {
          "description": "The permission resource of the normalized arguments, such as a path,\na command, or a URL; absent for a call checked under the action alone.",
          "type": [
            "string",
            "null"
          ]
        },
        "prepared_id": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "presentation": {
          "$ref": "#/$defs/PreparedPresentation",
          "description": "How clients show the call."
        },
        "serialization_key": {
          "description": "Calls with one key run one at a time; lowercase hex.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "prepared_id",
        "normalized_arguments",
        "presentation"
      ],
      "type": "object"
    },
    "PreparedPresentation": {
      "description": "The presentation a runtime or plugin supplies from prepare.",
      "properties": {
        "arguments": {
          "description": "The call's arguments; clients fall back to the raw model arguments\nwhen it is empty.",
          "items": {
            "$ref": "#/$defs/DisplayBlock"
          },
          "type": "array"
        },
        "hint": {
          "description": "What a tool is for, such as `file_edit`.",
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "type": [
            "string",
            "null"
          ]
        },
        "preview": {
          "description": "What the call will do, such as a diff as of prepare.",
          "items": {
            "$ref": "#/$defs/DisplayBlock"
          },
          "type": "array"
        },
        "primary_argument": {
          "description": "Bounded presentation text; byte-capped only, clients sanitize control characters.",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[\\s\\S]+$",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "Control-free bounded presentation text.",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\p{Cc}\\p{Cf}]+$",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "type": "object"
    },
    "TerminalSegment": {
      "properties": {
        "stream": {
          "$ref": "#/$defs/TerminalStream"
        },
        "text": {
          "description": "May contain SGR colour sequences.",
          "type": "string"
        }
      },
      "required": [
        "stream",
        "text"
      ],
      "type": "object"
    },
    "TerminalStream": {
      "description": "The stream a terminal segment came from. An unknown stream reads as\n`stdout`.",
      "oneOf": [
        {
          "enum": [
            "stdout",
            "stderr"
          ],
          "type": "string"
        }
      ],
      "x-open": true
    },
    "ToolErrorKind": {
      "description": "Open: a kind this build does not know reads as `failed`, a generic tool\nfailure.",
      "enum": [
        "progress_sink_closed",
        "operation_changed",
        "unsupported_security",
        "unsupported_platform",
        "resource_limit",
        "invalid_url",
        "permission_denied",
        "redirect_error",
        "timeout",
        "transport_error",
        "unsupported_content_type",
        "runtime_unavailable",
        "failed"
      ],
      "type": "string",
      "x-open": true
    },
    "WireToolError": {
      "description": "A runtime API `ToolError` on the wire.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ToolErrorKind"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "results": {
      "description": "One outcome per call, in order.",
      "items": {
        "$ref": "#/$defs/PrepareOutcome"
      },
      "type": "array"
    }
  },
  "required": [
    "results"
  ],
  "title": "PrepareResult",
  "type": "object"
}
