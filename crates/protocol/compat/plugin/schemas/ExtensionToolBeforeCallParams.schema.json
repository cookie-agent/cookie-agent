    },
    "permission_name": {
      "description": "`null` for a tool that needs no permission.",
      "type": [
        "string",
        "null"
      ]
    },
    "resource": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_id": {
      "format": "uuid",
      "type": "string"
    },
    "tool": {
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "context_id",
    "tool",
    "origin",
    "arguments",
    "permission_name",
    "resource"
  ],
  "title": "ExtensionToolBeforeCallParams",
  "type": "object"
}
