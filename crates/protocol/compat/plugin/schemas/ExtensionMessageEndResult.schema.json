              "description": "Control-free bounded presentation text.",
              "maxLength": 1024,
              "minLength": 1,
              "pattern": "^[^\\p{Cc}\\p{Cf}]+$",
              "type": "string"
            },
            "provider_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
