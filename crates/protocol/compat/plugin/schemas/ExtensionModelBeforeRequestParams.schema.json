{
  "$defs": {
    "ExtensionMessageRole": {
      "enum": [
        "system",
        "user",
        "assistant",
        "tool"
      ],
      "type": "string"
    },
    "ExtensionModelMessage": {
      "additionalProperties": false,
      "properties": {
        "content": true,
        "role": {
          "$ref": "#/$defs/ExtensionMessageRole"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "type": "object"
    },
    "ExtensionModelParamsAdjustments": {
      "additionalProperties": false,
      "properties": {
        "max_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "temperature": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "top_p": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ResolvedModelRef": {
      "properties": {
        "adapter_id": {
          "description": "Wire adapter a model is reached through, such as `anthropic` or `openai-responses`.",
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "type": "string"
        },
        "model_id": {
          "maxLength": 384,
          "minLength": 1,
          "pattern": "^[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+(?:/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+)*$",
          "type": "string"
        },
        "provider_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "type": "string"
        },
        "selection": {
          "description": "One exact base or named-variant model selection.",
          "properties": {
            "model": {
              "maxLength": 512,
              "minLength": 3,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+(?:/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+)*$",
              "type": "string"
            },
            "variant": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^(?!base$)[a-z0-9][a-z0-9._-]{0,63}$",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "model",
            "variant"
          ],
          "type": "object"
        },
        "selection_fingerprint": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "selection",
        "provider_id",
        "model_id",
        "adapter_id",
        "selection_fingerprint"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "format": "uuid",
      "type": "string"
    },
    "context_id": {
      "type": "string"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/ExtensionModelMessage"
      },
      "type": "array"
    },
    "model": {
      "$ref": "#/$defs/ResolvedModelRef"
    },
    "params": {
      "$ref": "#/$defs/ExtensionModelParamsAdjustments"
    },
    "session_id": {
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "context_id",
    "attempt_id",
    "messages",
    "model",
    "params"
  ],
  "title": "ExtensionModelBeforeRequestParams",
  "type": "object"
}
