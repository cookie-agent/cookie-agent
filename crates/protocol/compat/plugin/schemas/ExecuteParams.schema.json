{
  "$defs": {
    "CancellationCapability": {
      "enum": [
        "local_only",
        "provider"
      ],
      "type": "string"
    },
    "MediaCapability": {
      "properties": {
        "max_bytes": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "max_count": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "mime_types": {
          "items": {
            "maxLength": 255,
            "minLength": 3,
            "pattern": "^[^/\\s]+/[^/\\s]+$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "mime_types",
        "max_bytes",
        "max_count"
      ],
      "type": "object"
    },
    "Modality": {
      "enum": [
        "text",
        "image",
        "audio",
        "pdf",
        "video"
      ],
      "type": "string"
    },
    "ModelCapabilities": {
      "properties": {
        "cancellation": {
          "$ref": "#/$defs/CancellationCapability"
        },
        "context_tokens": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "input": {
          "items": {
            "$ref": "#/$defs/Modality"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "media": {
          "additionalProperties": {
            "$ref": "#/$defs/MediaCapability"
          },
          "description": "Per media kind. A reader drops a kind it does not know.",
          "properties": {
            "audio": {
              "$ref": "#/$defs/MediaCapability"
            },
            "image": {
              "$ref": "#/$defs/MediaCapability"
            },
            "pdf": {
              "$ref": "#/$defs/MediaCapability"
            },
            "video": {
              "$ref": "#/$defs/MediaCapability"
            }
          },
          "type": "object"
        },
        "native_replay": {
          "$ref": "#/$defs/ReplayCapability"
        },
        "output": {
          "items": {
            "$ref": "#/$defs/Modality"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "output_tokens": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "parallel_tool_calls": {
          "type": "boolean"
        },
        "reasoning": {
          "type": "boolean"
        },
        "seed": {
          "type": "boolean"
        },
        "structured_output": {
          "type": "boolean"
        },
        "temperature": {
          "type": "boolean"
        },
        "tool_calling": {
          "type": "boolean"
        },
        "top_p": {
          "type": "boolean"
        }
      },
      "required": [
        "input",
        "output",
        "context_tokens",
        "output_tokens",
        "tool_calling",
        "parallel_tool_calls",
        "structured_output",
        "reasoning",
        "temperature",
        "top_p",
        "seed",
        "native_replay",
        "cancellation",
        "media"
      ],
      "type": "object"
    },
    "ReplayCapability": {
      "enum": [
        "unsupported",
        "optional",
        "required"
      ],
      "type": "string"
    },
    "WireTurnContext": {
      "description": "The agent and model context of one tool batch.",
      "properties": {
        "adapter": {
          "description": "Wire adapter a model is reached through, such as `anthropic` or `openai-responses`.",
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "type": "string"
        },
        "adapter_family": {
          "description": "Exact adapter family of the turn's model, such as `anthropic-compatible` or `openai-responses`.",
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "type": "string"
        },
        "agent": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9]))*$",
          "type": "string"
        },
        "capabilities": {
          "$ref": "#/$defs/ModelCapabilities"
        },
        "model": {
          "maxLength": 512,
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+(?:/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+)*$",
          "type": "string"
        }
      },
      "required": [
        "agent",
        "model",
        "adapter",
        "adapter_family",
        "capabilities"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "background": {
      "description": "The model asked to run the call in the background.",
      "type": "boolean"
    },
    "prepared_id": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "run": {
      "format": "uuid",
      "type": "string"
    },
    "session": {
      "format": "uuid",
      "type": "string"
    },
    "turn": {
      "$ref": "#/$defs/WireTurnContext"
    }
  },
  "required": [
    "prepared_id",
    "session",
    "run",
    "turn"
  ],
  "title": "ExecuteParams",
  "type": "object"
}
