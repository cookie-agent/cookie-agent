{
  "$defs": {
    "ExtensionEmitStatus": {
      "description": "Open: a status this build does not know reads as `dropped`: the event\nwas not published as far as the plugin can tell.",
      "enum": [
        "published",
        "rejected",
        "dropped"
      ],
      "type": "string",
      "x-open": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "bus": {
      "$ref": "#/$defs/ExtensionEmitStatus"
    },
    "name": {
      "type": "string"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "name",
    "bus"
  ],
  "title": "ExtensionEmitResultParams",
  "type": "object"
}
