{
  "$defs": {
    "ToolErrorKind": {
      "description": "Open: a kind this build does not know reads as `failed`, a generic tool\nfailure.",
      "enum": [
        "progress_sink_closed",
        "operation_changed",
        "unsupported_security",
        "unsupported_platform",
        "resource_limit",
        "invalid_url",
        "permission_denied",
        "redirect_error",
        "timeout",
        "transport_error",
        "unsupported_content_type",
        "runtime_unavailable",
        "failed"
      ],
      "type": "string",
      "x-open": true
    },
    "WireToolError": {
      "description": "A runtime API `ToolError` on the wire.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ToolErrorKind"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The outcome of a host service or a check: absent error means success.",
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/WireToolError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "Outcome",
  "type": "object"
}
