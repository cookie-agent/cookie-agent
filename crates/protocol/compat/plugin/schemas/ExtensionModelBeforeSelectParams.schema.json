{
  "$defs": {
    "ExtensionModelSelectSource": {
      "description": "Open: a source from a newer daemon reads as `Unknown`.",
      "oneOf": [
        {
          "enum": [
            "user",
            "config"
          ],
          "type": "string"
        },
        {
          "const": "fallback",
          "description": "The engine moves to the next model of the fallback chain.",
          "type": "string"
        }
      ],
      "x-open": true
    },
    "ModelSelection": {
      "description": "One exact base or named-variant model selection.",
      "properties": {
        "model": {
          "maxLength": 512,
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+(?:/[^/\\s\\u0000-\\u001f\\u007f-\\u009f\\[\\]]+)*$",
          "type": "string"
        },
        "variant": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?!base$)[a-z0-9][a-z0-9._-]{0,63}$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "model"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "context_id": {
      "type": "string"
    },
    "from": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelSelection"
        },
        {
          "type": "null"
        }
      ]
    },
    "session_id": {
      "format": "uuid",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/ExtensionModelSelectSource"
    },
    "to": {
      "$ref": "#/$defs/ModelSelection"
    }
  },
  "required": [
    "session_id",
    "context_id",
    "to",
    "source"
  ],
  "title": "ExtensionModelBeforeSelectParams",
  "type": "object"
}
