  "schemas": {
    "ExtensionInitializeParams.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "ExtensionInitializeParams", "type": "object", "additionalProperties": false,
      "properties": {"capabilities":{"$ref":"#/$defs/ExtensionEngineCapabilities"},"engine_version":{"type":"string"},"protocol_version":{"type":"string","const":"0.0.3"}},
      "required": ["protocol_version","engine_version","capabilities"],
      "$defs": {"ExtensionEngineCapabilities":{"type":"object","properties":{"ping":{"type":"boolean"},"shutdown":{"type":"boolean"},"tools":{"type":"boolean"},"event_streaming":{"type":"boolean"},"event_publishing":{"type":"boolean"},"interception":{"type":"boolean"}},"additionalProperties":false,"required":["ping","shutdown","tools","event_streaming","event_publishing","interception"]}}
    },
    "ExtensionInitializeResult.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "ExtensionInitializeResult", "type": "object", "additionalProperties": false,
      "properties": {"capabilities":{"$ref":"#/$defs/ExtensionPluginCapabilities"},"name":{"type":"string"},"protocol_version":{"type":"string","const":"0.0.3"},"tools":{"type":"array","items":{"$ref":"#/$defs/ExtensionToolDeclaration"}},"version":{"type":"string"}},
      "required": ["protocol_version","name","version","capabilities","tools"],
