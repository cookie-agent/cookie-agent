        "ExtensionToolDeclaration":{"type":"object","properties":{"description":{"type":"string"},"name":{"type":"string"},"parameters":true,"permission_name":{"type":"string"},"primary_resource_param":{"type":["string","null"]}},"additionalProperties":false,"required":["name","description","parameters","permission_name","primary_resource_param"]}
      }
    },
    "ExtensionPingParams.schema.json": {"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ExtensionPingParams","type":"object","additionalProperties":false},
    "ExtensionPingResult.schema.json": {"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ExtensionPingResult","type":"object","additionalProperties":false},
    "ExtensionShutdownParams.schema.json": {"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ExtensionShutdownParams","type":"object","additionalProperties":false},
    "ExtensionToolCallParams.schema.json": {"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ExtensionToolCallParams","type":"object","properties":{"arguments":true,"cancellation_token":{"type":["string","null"]},"context_id":{"type":"string"},"invocation_id":{"type":"string","format":"uuid"},"resource":{"type":["string","null"]},"session_id":{"type":"string","format":"uuid"},"tool":{"type":"string"}},"additionalProperties":false,"required":["tool","session_id","context_id","invocation_id","arguments","resource"]},
    "ExtensionToolCallResult.schema.json": {"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ExtensionToolCallResult","type":"object","properties":{"content":{"type":"string"},"is_error":{"type":"boolean"}},"additionalProperties":false,"required":["content","is_error"]},
    "ExtensionEventParams.schema.json": {"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ExtensionEventParams","type":"object","properties":{"context_id":{"type":"string"},"event":{"$ref":"#/$defs/EventPayload"},"seq":{"type":"integer","format":"uint64","minimum":1},"session_id":{"type":"string","format":"uuid"},"timestamp":{"type":"string","format":"date-time"}},"additionalProperties":false,"required":["session_id","context_id","seq","event","timestamp"]},
    "ExtensionBusEventParams.schema.json": {"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ExtensionBusEventParams","type":"object","properties":{"context_id":{"type":["string","null"]},"name":{"type":"string"},"payload":true,"plugin":{"type":"string"},"session_id":{"type":"string","format":"uuid"}},"additionalProperties":false,"required":["session_id","plugin","name","payload"]},
    "ExtensionEmitParams.schema.json": {"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ExtensionEmitParams","type":"object","properties":{"context_id":{"type":"string"},"name":{"type":"string","maxLength":128,"minLength":1},"payload":true,"session_id":{"type":"string","format":"uuid"}},"additionalProperties":false,"required":["session_id","context_id","name","payload"]},
    "ExtensionEmitResultParams.schema.json": {"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ExtensionEmitResultParams","type":"object","properties":{"bus":{"$ref":"#/$defs/ExtensionEmitStatus"},"durable":{"$ref":"#/$defs/ExtensionEmitStatus"},"name":{"type":"string"},"reason":{"type":["string","null"]}},"additionalProperties":false,"required":["name","bus","durable"],"$defs":{"ExtensionEmitStatus":{"type":"string","enum":["published","dropped","rejected"]}}},
    "ExtensionToolBeforeCallParams.schema.json": {"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ExtensionToolBeforeCallParams","type":"object","properties":{"arguments":true,"context_id":{"type":"string"},"permission_name":{"type":"string"},"resource":{"type":["string","null"]},"session_id":{"type":"string","format":"uuid"},"tool":{"type":"string"}},"additionalProperties":false,"required":["session_id","context_id","tool","arguments","permission_name","resource"]},
    "ExtensionToolBeforeCallResult.schema.json": {"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ExtensionToolBeforeCallResult","type":"object","properties":{"action":{"$ref":"#/$defs/ExtensionToolBeforeCallAction"},"message_to_model":{"type":["string","null"]},"modified_arguments":true,"reason":{"type":["string","null"]}},"additionalProperties":false,"required":["action"],"$defs":{"ExtensionToolBeforeCallAction":{"type":"string","enum":["allow","block"]}}},
    "ExtensionToolAfterResultParams.schema.json": {"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ExtensionToolAfterResultParams","type":"object","properties":{"arguments":true,"context_id":{"type":"string"},"is_error":{"type":"boolean"},"result_content":{"type":"string"},"session_id":{"type":"string","format":"uuid"},"tool":{"type":"string"}},"additionalProperties":false,"required":["session_id","context_id","tool","arguments","result_content","is_error"]},
    "ExtensionToolAfterResultResult.schema.json": {"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ExtensionToolAfterResultResult","type":"object","properties":{"action":{"$ref":"#/$defs/ExtensionToolAfterResultAction"},"note":{"type":["string","null"]},"replacement_content":{"type":["string","null"]}},"additionalProperties":false,"required":["action"],"$defs":{"ExtensionToolAfterResultAction":{"type":"string","enum":["keep","replace"]}}},
    "ExtensionAgentBeforeStartParams.schema.json": {"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ExtensionAgentBeforeStartParams","type":"object","properties":{"agent_path":{"type":"string"},"context_id":{"type":"string"},"prompt_context":true,"session_id":{"type":"string","format":"uuid"}},"additionalProperties":false,"required":["session_id","context_id","agent_path","prompt_context"]},
    "ExtensionAgentBeforeStartResult.schema.json": {"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ExtensionAgentBeforeStartResult","type":"object","properties":{"addendum":{"type":["string","null"]}},"additionalProperties":false},
    "ExtensionSessionBeforeCompactParams.schema.json": {"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ExtensionSessionBeforeCompactParams","type":"object","properties":{"additions":{"type":"array","items":{"type":"string"}},"checkpoint_id":{"type":"string"},"context_id":{"type":"string"},"session_id":{"type":"string","format":"uuid"}},"additionalProperties":false,"required":["session_id","context_id","checkpoint_id","additions"]},
    "ExtensionSessionBeforeCompactResult.schema.json": {"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ExtensionSessionBeforeCompactResult","type":"object","properties":{"addendum":{"type":["string","null"]}},"additionalProperties":false}
  }
}
