{
  "methods": {
    "PLUGIN_INITIALIZE_METHOD": "plugin/initialize",
    "PLUGIN_PING_METHOD": "plugin/ping",
    "PLUGIN_SHUTDOWN_METHOD": "plugin/shutdown",
    "PLUGIN_TOOLS_CALL_METHOD": "plugin/tools/call"
  },
  "schemas": {
    "ExtensionInitializeParams.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ExtensionInitializeParams",
      "type": "object",
      "properties": {
        "capabilities": {"$ref":"#/$defs/ExtensionEngineCapabilities"},
        "engine_version": {"type":"string"},
        "protocol_version": {"type":"string","const":"0.0.2"}
      },
      "additionalProperties": false,
      "required": ["protocol_version","engine_version","capabilities"],
      "$defs": {
        "ExtensionEngineCapabilities": {"type":"object","properties":{"ping":{"type":"boolean"},"shutdown":{"type":"boolean"},"tools":{"type":"boolean"}},"additionalProperties":false,"required":["ping","shutdown","tools"]}
      }
    },
    "ExtensionInitializeResult.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ExtensionInitializeResult",
      "type": "object",
      "properties": {
        "capabilities": {"$ref":"#/$defs/ExtensionPluginCapabilities"},
        "name": {"type":"string"},
        "protocol_version": {"type":"string","const":"0.0.2"},
        "tools": {"type":"array","items":{"$ref":"#/$defs/ExtensionToolDeclaration"}},
        "version": {"type":"string"}
      },
      "additionalProperties": false,
      "required": ["protocol_version","name","version","capabilities","tools"],
      "$defs": {
        "ExtensionPluginCapabilities": {"type":"object","properties":{"resources":{"type":"boolean"},"tools":{"type":"boolean"}},"additionalProperties":false,"required":["tools","resources"]},
        "ExtensionToolDeclaration": {"type":"object","properties":{"description":{"type":"string"},"name":{"type":"string"},"parameters":true,"permission_name":{"type":"string"},"primary_resource_param":{"type":["string","null"]}},"additionalProperties":false,"required":["name","description","parameters","permission_name","primary_resource_param"]}
      }
    },
    "ExtensionPingParams.schema.json": {"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ExtensionPingParams","type":"object","additionalProperties":false},
    "ExtensionPingResult.schema.json": {"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ExtensionPingResult","type":"object","additionalProperties":false},
    "ExtensionShutdownParams.schema.json": {"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ExtensionShutdownParams","type":"object","additionalProperties":false},
    "ExtensionToolCallParams.schema.json": {"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ExtensionToolCallParams","type":"object","properties":{"arguments":true,"cancellation_token":{"type":["string","null"]},"invocation_id":{"type":"string","format":"uuid"},"resource":{"type":["string","null"]},"session_id":{"type":"string","format":"uuid"},"tool":{"type":"string"}},"additionalProperties":false,"required":["tool","session_id","invocation_id","arguments","resource"]},
    "ExtensionToolCallResult.schema.json": {"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ExtensionToolCallResult","type":"object","properties":{"content":{"type":"string"},"is_error":{"type":"boolean"}},"additionalProperties":false,"required":["content","is_error"]}
  }
}
