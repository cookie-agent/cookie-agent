{"engine_version":"0.4.0","origin":"engine:deferred-tools","session_id":"01a19596-77e5-7300-9208-530a7a93b843","run_id":"01a19596-77e8-7731-bef7-ecb7558ad632","seq":6,"timestamp":"2026-11-01T05:30:28.717166762Z","skippable":true,"payload":{"type":"tool_round_started","tools":[{"name":"attach_machine","description":"Attach a machine to this session: one runtime capability from list_runtimes, written `<runtime id>/<capability name>` (e.g. `labpc/coding`), at `workspace` when the capability takes one. Its tools join this session at once, and the result says where they run: the machine, its home, the workspace, and the workspace's AGENTS.md. A machine offers each tool once: a second directory on a machine already attached is reached by absolute path, or by detaching the first.","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"`attach_machine`'s arguments.","properties":{"capability":{"description":"`<runtime_id>/<capability_id>`, from list_runtimes, e.g. `labpc/coding`","type":"string"},"workspace":{"description":"Directory on that runtime's machine; required when the capability\ntakes a workspace","type":["string","null"]}},"required":["capability"],"title":"AttachArgs","type":"object"},"source":{"label":"global","tool":"attach_machine"}},{"name":"detach_machine","description":"Detach a machine's runtime capability from this session, written `<runtime id>/<capability name>` as attach_machine took it. Its tools leave the session; refused while one of its background calls still runs.","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"`detach_machine`'s arguments.","properties":{"capability":{"description":"`<runtime_id>/<capability_id>`, as attach_machine took it","type":"string"}},"required":["capability"],"title":"DetachArgs","type":"object"},"source":{"label":"global","tool":"detach_machine"}},{"name":"list_runtimes","description":"List the daemon's machines and runtimes, as they are now: each runtime's capabilities, whether it is connected or starts when used, its home directory, the ACP agents it offers (external agents such as Claude Code), and this session's own attachments on it. Name a runtime capability from here, as `<runtime id>/<capability name>`, in attach_machine to work on it in this session, or in delegate_subagent's `capabilities` to start a subagent there. A runtime that connects later shows up on the next call.","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"`list_runtimes` takes no arguments.","title":"ListRuntimesArgs","type":"object"},"source":{"label":"global","tool":"list_runtimes"}}],"prompt_groups":["builtin.machines@global","builtin.runtimes@global"]}}
