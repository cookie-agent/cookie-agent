---
source: crates/config/src/lib.rs
expression: "config.materialize_policy(\"primary\").expect(\"policy snapshot\")"
---
{
  "profile": {
    "name": "primary",
    "type": "primary"
  },
  "models": [
    {
      "provider": "test",
      "model": "one"
    }
  ],
  "tools": [
    "bash",
    "read"
  ],
  "permissions": {
    "read": "ask",
    "write": "ask",
    "exec": "ask",
    "delegate": "ask",
    "rules": [
      {
        "id": "global",
        "action": "read",
        "resource": "*",
        "effect": "allow",
        "hard": false,
        "__source": "workspace"
      },
      {
        "id": "primary",
        "action": "bash",
        "resource": "git status *",
        "effect": "allow",
        "hard": false,
        "__source": "profile"
      }
    ]
  },
  "delegation": {
    "enabled": true,
    "allowed_profiles": [
      "worker"
    ],
    "depth_limit": "Unlimited"
  },
  "result_limits": {
    "delegate_result_bytes": 32768
  }
}
